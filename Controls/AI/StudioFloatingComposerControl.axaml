<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="using:PdfEditorApp.Plugins.CSharpEditor.Controls.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.AI"
             xmlns:ai="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Models.AI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="700"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.AI.StudioFloatingComposerControl"
             x:DataType="vm:AiComposerViewModel"
             IsVisible="{Binding IsVisible}">



    <!-- Overlay Host Container -->
    <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <!-- ======================================================== -->
        <!-- 1. MINIMIZED FLOATING CAPSULE BUTTON (Bottom Right)      -->
        <!-- ======================================================== -->
        <Border IsVisible="{Binding CanShowMinimizedCapsule}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24"
                Background="{DynamicResource DsSurfaceBrush}"
                BorderBrush="{DynamicResource DsPrimaryBorderSubtleBrush}"
                lt:Tokens.BorderThickness="DsBorderThin"
                lt:Tokens.CornerRadius="DsRadius3XL" Padding="12,7"
                lt:Tokens.BoxShadow="DsFloatingShadow">
            <Button Command="{Binding ToggleMinimizeCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="22" Height="22" lt:Tokens.CornerRadius="DsRadiusMD" Background="{DynamicResource DsPrimarySubtleBrush}">
                        <materialIcons:MaterialIcon Kind="AutoFix" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Fry AI Agent" lt:Tokens.FontWeight="DsWeightEmphasis" lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                    <Border IsVisible="{Binding IsGenerating}"
                            Width="8" Height="8" lt:Tokens.CornerRadius="DsRadiusSM" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. EXPANDED FLOATING COMPOSER WINDOW                     -->
        <!-- ======================================================== -->
        <Border Name="ComposerContainer"
                IsVisible="{Binding !IsMinimized}"
                Classes="composer-window"
                Background="{DynamicResource DsSurfaceBrush}"
                Opacity="{Binding WindowOpacity}">
            <Panel>
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

                <!-- Header Bar (Draggable Title Rail) -->
                <Border Name="HeaderBar" Grid.Row="0" Height="40"
                        Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderBottom"
                        lt:Tokens.CornerRadius="DsRadiusLGTop"
                        Padding="12,0,8,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Icon, Title & Agent Mode Switcher Pill -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="24" Height="24" lt:Tokens.CornerRadius="DsRadiusMD" Background="{DynamicResource DsPrimarySubtleBrush}">
                                <materialIcons:MaterialIcon Kind="AutoFix" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Composer" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.FontSize="DsFontSize350" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />

                            <ToggleButton Classes="composer-mode-toggle"
                                          IsChecked="{Binding IsAgentMode, Mode=TwoWay}"
                                          Margin="6,0,0,0"
                                          ToolTip.Tip="Toggle Agent mode (autonomous tools) vs Chat mode">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="RobotOutline" Width="12" Height="12" VerticalAlignment="Center" />
                                    <TextBlock Text="Agent" lt:Tokens.FontSize="DsFontSize150" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>

                            <!-- Server Address & Auto-Discovery Pill Button -->
                            <Button Command="{Binding ToggleConnectionDrawerCommand}"
                                    Classes="composer-pill-btn"
                                    Margin="6,0,0,0" Height="22" Padding="6,1"
                                    ToolTip.Tip="Configure Server Address &amp; Auto-Detect Local LLM"
                                    Background="{DynamicResource DsSurfaceBrush}"
                                    BorderBrush="{DynamicResource DsBorderBrush}">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="LanConnect" Width="11" Height="11" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Server" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                    <Border Width="6" Height="6" lt:Tokens.CornerRadius="DsRadiusXS" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Draggable rail empty space -->
                        <Border Grid.Column="1" Background="Transparent" />

                        <!-- Action Toolbar & Window Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <!-- Dynamic Actions Injected by Extensions -->
                            <StackPanel Name="DynamicActionsHost" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />

                            <!-- Clear Chat -->
                            <Button Command="{Binding ClearChatCommand}" Classes="composer-btn" ToolTip.Tip="Clear Conversation"
                                    Width="26" lt:Tokens.Height="DsControlHeight100" Padding="0">
                                <materialIcons:MaterialIcon Kind="Broom" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <!-- Screen Capture Protection Toggle -->
                            <Button Command="{Binding ToggleCaptureProtectionCommand}" Classes="composer-btn"
                                    ToolTip.Tip="Toggle Screen Capture Protection (Hide window from recording/screenshots)"
                                    Width="26" lt:Tokens.Height="DsControlHeight100" Padding="0">
                                <Panel>
                                    <materialIcons:MaterialIcon Kind="ShieldCheck" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}"
                                                                IsVisible="{Binding IsProtectedFromCapture}" />
                                    <materialIcons:MaterialIcon Kind="ShieldOutline" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}"
                                                                IsVisible="{Binding !IsProtectedFromCapture}" />
                                </Panel>
                            </Button>

                            <!-- Vertical Divider -->
                            <Border Width="1" Height="14" Background="{DynamicResource DsBorderBrush}" Margin="3,0" />

                            <!-- Docking Controls -->
                            <!-- When Extracted: Re-dock to main window -->
                            <Button Command="{Binding ReDockCommand}" Classes="composer-btn" ToolTip.Tip="Re-dock into Studio"
                                    Width="26" lt:Tokens.Height="DsControlHeight100" Padding="0" IsVisible="{Binding IsExtracted}">
                                <materialIcons:MaterialIcon Kind="DockWindow" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                            </Button>

                            <!-- When Docked in SideBar/Bottom: Float as Overlay -->
                            <Button Command="{Binding DockToFloatingCommand}" Classes="composer-btn" ToolTip.Tip="Float as Overlay"
                                    Width="26" lt:Tokens.Height="DsControlHeight100" Padding="0" IsVisible="{Binding CanDockToFloating}">
                                <materialIcons:MaterialIcon Kind="LayersOutline" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                            </Button>

                            <!-- When Not Extracted: Extract to OS Window (Screen Tearing) -->
                            <Button Command="{Binding ExtractToWindowCommand}" Classes="composer-btn" ToolTip.Tip="Tear Out into Floating Window"
                                    Width="26" lt:Tokens.Height="DsControlHeight100" Padding="0" IsVisible="{Binding CanExtractToWindow}">
                                <materialIcons:MaterialIcon Kind="OpenInNew" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <!-- Dock to SideBar -->
                            <Button Command="{Binding DockToSideBarCommand}" Classes="composer-btn" ToolTip.Tip="Dock into Right Panel (Secondary Side Bar)"
                                    Width="26" lt:Tokens.Height="DsControlHeight100" Padding="0" IsVisible="{Binding CanDockToSideBar}">
                                <materialIcons:MaterialIcon Kind="DockRight" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <!-- Dock to Bottom Deck -->
                            <Button Command="{Binding DockToBottomDeckCommand}" Classes="composer-btn" ToolTip.Tip="Dock into Bottom Panel / Deck"
                                    Width="26" lt:Tokens.Height="DsControlHeight100" Padding="0" IsVisible="{Binding CanDockToBottomDeck}">
                                <materialIcons:MaterialIcon Kind="DockBottom" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <!-- Vertical Divider -->
                            <Border Width="1" Height="14" Background="{DynamicResource DsBorderBrush}" Margin="3,0"
                                    IsVisible="{Binding CanMaximizeAndMinimize}" />

                            <!-- Window Management (Maximize, Minimize, Close) -->
                            <Button Name="MaximizeRestoreButton" Classes="composer-btn" ToolTip.Tip="Maximize / Restore"
                                    Width="26" lt:Tokens.Height="DsControlHeight100" Padding="0" IsVisible="{Binding CanMaximizeAndMinimize}">
                                <materialIcons:MaterialIcon Name="MaximizeIcon" Kind="WindowMaximize" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <Button Command="{Binding ToggleMinimizeCommand}" Classes="composer-btn" ToolTip.Tip="Minimize to Pill"
                                    Width="26" lt:Tokens.Height="DsControlHeight100" Padding="0" IsVisible="{Binding CanMaximizeAndMinimize}">
                                <materialIcons:MaterialIcon Kind="Minus" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>

                            <Button Command="{Binding CloseCommand}" Classes="composer-btn close-btn" ToolTip.Tip="Close (Cmd+I)"
                                    Width="26" lt:Tokens.Height="DsControlHeight100" Padding="0">
                                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Drawers (Row 1): Server Address & Auto-Discovery Drawer + System Prompt & Persona Drawer -->
                <StackPanel Grid.Row="1">
                    <!-- 1. Endpoint Address & LLM Auto-Discovery Drawer -->
                    <Border Background="{DynamicResource DsSurfaceHighBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderBottom"
                            Padding="12,10" IsVisible="{Binding IsConnectionDrawerOpen}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="LanConnect" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" />
                                    <TextBlock Text="SERVER ADDRESS &amp; LOCAL LLM DISCOVERY" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Command="{Binding ToggleConnectionDrawerCommand}" Classes="composer-btn" Padding="2" ToolTip.Tip="Close connection drawer">
                                    <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                            </Grid>

                            <!-- Address Input + Ping + Auto-Detect -->
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0" Text="{Binding EndpointUrl, Mode=TwoWay}"
                                         lt:Tokens.FontFamily="JetBrainsMonoFontFamily"
                                         lt:Tokens.FontSize="DsFontSize200" lt:Tokens.Height="DsControlHeight150" Padding="8,4"
                                         Background="{DynamicResource DsBgBrush}"
                                         Foreground="{DynamicResource DsTextWhiteBrush}"
                                         BorderBrush="{DynamicResource DsBorderBrush}"
                                         lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD"
                                         PlaceholderText="Endpoint Address (e.g. http://localhost:11434)" />

                                <Button Grid.Column="1" Command="{Binding PingEndpointCommand}" Classes="composer-pill-btn"
                                        Margin="6,0,0,0" lt:Tokens.Height="DsControlHeight150" Padding="8,2"
                                        ToolTip.Tip="Ping this address and test latency"
                                        Background="{DynamicResource NavHomeBgBrush}" BorderBrush="{DynamicResource NavHomeFgBrush}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="Pulse" Width="12" Height="12" Foreground="{DynamicResource NavHomeFgBrush}" />
                                        <TextBlock Text="Ping" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavHomeFgBrush}" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2" Command="{Binding AutoDetectLocalServiceCommand}" Classes="action-accept"
                                        Margin="6,0,0,0" lt:Tokens.Height="DsControlHeight150" Padding="10,2"
                                        ToolTip.Tip="Auto-detect running Ollama or LM Studio servers on local ports (1234, 11434, 11443)">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <materialIcons:MaterialIcon Kind="AutoFix" Width="12" Height="12" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                        <TextBlock Text="Auto-Detect" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Status & Latency Strip -->
                            <Border Background="{DynamicResource DsBgBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="8,5">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Border Width="6" Height="6" lt:Tokens.CornerRadius="DsRadiusXS" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding EndpointStatusText}" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="Model:" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SelectedModel}" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Studio UI Freedom & Extensibility Quick Presets -->
                            <StackPanel Spacing="4" Margin="0,2,0,0">
                                <TextBlock Text="STUDIO UI FREEDOM &amp; EXTENSIBILITY:" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking060" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Command="{Binding PresetCustomizeThemeCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="7,2"
                                            Background="{DynamicResource NavBlind75BgBrush}" BorderBrush="{DynamicResource NavBlind75FgBrush}"
                                            ToolTip.Tip="Ask agent to modify studio theme colors and styles">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="PaletteOutline" Width="11" Height="11" Foreground="{DynamicResource NavBlind75FgBrush}" />
                                            <TextBlock Text="Customize Theme" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavBlind75FgBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding PresetInjectWidgetCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="7,2"
                                            Background="{DynamicResource NavToolchainsBgBrush}" BorderBrush="{DynamicResource NavToolchainsFgBrush}"
                                            ToolTip.Tip="Ask agent to inject a custom XAML widget into EditorToolbar">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="PuzzleOutline" Width="11" Height="11" Foreground="{DynamicResource NavToolchainsFgBrush}" />
                                            <TextBlock Text="Inject Widget" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavToolchainsFgBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding PresetInspectUiCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="7,2"
                                            Background="{DynamicResource NavKernelsBgBrush}" BorderBrush="{DynamicResource NavKernelsFgBrush}"
                                            ToolTip.Tip="Ask agent to inspect running studio visual tree">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="11" Height="11" Foreground="{DynamicResource NavKernelsFgBrush}" />
                                            <TextBlock Text="Inspect UI Tree" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavKernelsFgBrush}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 2. Prompt & Persona Customization Drawer -->
                    <Border Background="{DynamicResource DsSurfaceHighBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderBottom"
                            Padding="12,10" IsVisible="{Binding IsPromptEditorOpen}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Tune" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" />
                                <TextBlock Text="SYSTEM PROMPT &amp; PERSONA" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" lt:Tokens.LetterSpacing="DsTracking080" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding TogglePromptEditorCommand}" Classes="composer-btn" Padding="2" ToolTip.Tip="Close prompt editor">
                                <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>
                        </Grid>

                        <!-- Presets Row -->
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Text="Presets:" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button Command="{Binding SetComposerDefaultPromptCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="8,2" ToolTip.Tip="Autonomous agent with Roslyn, bash &amp; tools"
                                    Background="{DynamicResource NavHomeBgBrush}" BorderBrush="{DynamicResource NavHomeFgBrush}">
                                <TextBlock Text="Agent" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavHomeFgBrush}" />
                            </Button>
                            <Button Command="{Binding SetComposerConcisePromptCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="8,2" ToolTip.Tip="Concise code diffs with minimal prose"
                                    Background="{DynamicResource NavKernelsBgBrush}" BorderBrush="{DynamicResource NavKernelsFgBrush}">
                                <TextBlock Text="Concise" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavKernelsFgBrush}" />
                            </Button>
                            <Button Command="{Binding SetComposerReviewerPromptCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="8,2" ToolTip.Tip="Code review, memory leaks, performance &amp; security"
                                    Background="{DynamicResource NavTemplatesBgBrush}" BorderBrush="{DynamicResource NavTemplatesFgBrush}">
                                <TextBlock Text="Reviewer" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavTemplatesFgBrush}" />
                            </Button>
                            <Button Command="{Binding SetComposerTddPromptCommand}" Classes="composer-pill-btn" Margin="0,1,6,1" Padding="8,2" ToolTip.Tip="Test-driven development, xUnit &amp; edge cases"
                                    Background="{DynamicResource NavToolchainsBgBrush}" BorderBrush="{DynamicResource NavToolchainsFgBrush}">
                                <TextBlock Text="TDD" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavToolchainsFgBrush}" />
                            </Button>
                        </WrapPanel>

                        <!-- Multi-line Prompt Editor -->
                        <TextBox Text="{Binding CustomSystemPrompt, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Height="78"
                                 lt:Tokens.FontFamily="JetBrainsMonoFontFamily"
                                 lt:Tokens.FontSize="DsFontSize200"
                                 Background="{DynamicResource DsBgBrush}"
                                 Foreground="{DynamicResource DsTextWhiteBrush}"
                                 BorderBrush="{DynamicResource DsBorderBrush}"
                                 lt:Tokens.BorderThickness="DsBorderThin"
                                 lt:Tokens.CornerRadius="DsRadiusMD"
                                 Padding="8,6" />

                        <!-- Drawer Footer -->
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding CustomPromptLength, StringFormat='{}{0:N0} characters'}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                <Button Command="{Binding ResetComposerPromptCommand}" Classes="composer-btn" Padding="6,2" ToolTip.Tip="Reset to Default System Prompt">
                                    <TextBlock Text="Reset" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding ApplyCustomPromptCommand}" Classes="action-accept" Padding="10,2" ToolTip.Tip="Apply Prompt to Agent">
                                    <TextBlock Text="Apply" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                </StackPanel>

                <!-- Touched Files Strip (Row 2, Visible when files modified) -->
                <Border Grid.Row="2" Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderBottom"
                        Padding="10,6" IsVisible="{Binding HasModifiedFiles}">
                    <Grid ColumnDefinitions="*,Auto">
                        <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding SessionModifiedFiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="ai:ModifiedFileItem">
                                        <Border Background="{DynamicResource DsPrimarySubtleBrush}"
                                                BorderBrush="{DynamicResource DsPrimaryBorderSubtleBrush}"
                                                lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="7,3">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <materialIcons:MaterialIcon Kind="FileCodeOutline" Width="12" Height="12" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FileName}" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SummaryText}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Accept All / Reject All Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                            <Button Command="{Binding AcceptAllChangesCommand}" Classes="action-accept" ToolTip.Tip="Accept All Changes (Cmd+Enter)">
                                <TextBlock Text="Accept All" lt:Tokens.FontWeight="DsWeightEmphasis" />
                            </Button>
                            <Button Command="{Binding RejectAllChangesCommand}" Classes="action-reject" ToolTip.Tip="Reject All Changes">
                                <TextBlock Text="Reject" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Conversation Messages Scroll Area (Row 3) -->
                <Border Grid.Row="3" Background="{DynamicResource DsBgBrush}">
                    <ScrollViewer Name="MessagesScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  Padding="12,8">
                    <StackPanel lt:Tokens.Spacing="DsSpace12">
                        <!-- Welcome / Empty Prompt Placeholder -->
                        <Border Background="{DynamicResource DsSurfaceBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                lt:Tokens.BorderThickness="DsCardBorder"
                                lt:Tokens.CornerRadius="DsRadiusLG" Padding="14" Margin="0,8"
                                IsVisible="{Binding !Messages.Count}" lt:Tokens.BoxShadow="DsCardShadow">
                            <StackPanel Spacing="6">
                                <TextBlock Text="✨ What would you like to build or automate?" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.FontSize="DsFontSize400" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="Fry AI can explore your workspace, create or edit scripts, fix compiler errors, and customize the studio UI."
                                           lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Command="{Binding InsertMentionCommand}" CommandParameter="@Files"
                                            Classes="composer-pill-btn" Margin="0,2,6,2" Padding="8,3"
                                            Background="{DynamicResource NavHomeBgBrush}" BorderBrush="{DynamicResource NavHomeFgBrush}"
                                            ToolTip.Tip="Attach full workspace file listing">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="FolderMultipleOutline" Width="11" Height="11" Foreground="{DynamicResource NavHomeFgBrush}" />
                                            <TextBlock Text="@Files" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavHomeFgBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding InsertMentionCommand}" CommandParameter="@Problems"
                                            Classes="composer-pill-btn" Margin="0,2,6,2" Padding="8,3"
                                            Background="{DynamicResource NavKernelsBgBrush}" BorderBrush="{DynamicResource NavKernelsFgBrush}"
                                            ToolTip.Tip="Attach active compiler diagnostics &amp; errors">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="11" Height="11" Foreground="{DynamicResource NavKernelsFgBrush}" />
                                            <TextBlock Text="@Problems" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavKernelsFgBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding InsertMentionCommand}" CommandParameter="@Docs"
                                            Classes="composer-pill-btn" Margin="0,2,6,2" Padding="8,3"
                                            Background="{DynamicResource NavTemplatesBgBrush}" BorderBrush="{DynamicResource NavTemplatesFgBrush}"
                                            ToolTip.Tip="Attach studio API documentation &amp; SDK reference">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="BookOpenOutline" Width="11" Height="11" Foreground="{DynamicResource NavTemplatesFgBrush}" />
                                            <TextBlock Text="@Docs" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavTemplatesFgBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding InsertMentionCommand}" CommandParameter="@UI"
                                            Classes="composer-pill-btn" Margin="0,2,6,2" Padding="8,3"
                                            Background="{DynamicResource NavToolchainsBgBrush}" BorderBrush="{DynamicResource NavToolchainsFgBrush}"
                                            ToolTip.Tip="Inspect live studio visual tree hierarchy">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="ViewDashboardOutline" Width="11" Height="11" Foreground="{DynamicResource NavToolchainsFgBrush}" />
                                            <TextBlock Text="@UI" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavToolchainsFgBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding InsertMentionCommand}" CommandParameter="@Theme"
                                            Classes="composer-pill-btn" Margin="0,2,6,2" Padding="8,3"
                                            Background="{DynamicResource NavBlind75BgBrush}" BorderBrush="{DynamicResource NavBlind75FgBrush}"
                                            ToolTip.Tip="Customize studio styling &amp; theme tokens">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="PaletteOutline" Width="11" Height="11" Foreground="{DynamicResource NavBlind75FgBrush}" />
                                            <TextBlock Text="@Theme" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavBlind75FgBrush}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Chat Messages List -->
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ai:ChatMessageItem">
                                    <StackPanel Spacing="6" Margin="0,4">
                                        <!-- User Message Bubble -->
                                        <Border IsVisible="{Binding IsUser}"
                                                Background="{DynamicResource DsPrimarySubtleBrush}"
                                                BorderBrush="{DynamicResource DsPrimaryBorderSubtleBrush}"
                                                lt:Tokens.BorderThickness="DsBorderThin"
                                                lt:Tokens.CornerRadius="DsRadiusLG" Padding="12,8"
                                                HorizontalAlignment="Right" MaxWidth="440">
                                            <TextBlock Text="{Binding Content}" lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsTextBrush}" TextWrapping="Wrap" />
                                        </Border>

                                        <!-- Assistant Message Bubble -->
                                        <StackPanel IsVisible="{Binding IsAssistant}" Spacing="6">
                                            <!-- Steps Accordion (ReAct plan progression) -->
                                            <ItemsControl ItemsSource="{Binding Steps}" IsVisible="{Binding HasSteps}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="ai:AgentStepItem">
                                                        <Border Background="{DynamicResource DsBgBrush}" lt:Tokens.CornerRadius="DsRadiusMD" Padding="8,5" Margin="0,2"
                                                                BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin">
                                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding StatusIconKind, Converter={x:Static common:IconKindConverter.Instance}}" Foreground="{Binding StatusColorHex}" Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Title}" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Thinking / Reasoning Accordion (Brain icon & collapsible thoughts) -->
                                            <Border IsVisible="{Binding HasReasoning}"
                                                    Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin"
                                                    lt:Tokens.CornerRadius="DsRadiusLG" Padding="8,5" Margin="0,2,0,2">
                                                <StackPanel Spacing="4">
                                                    <ToggleButton IsChecked="{Binding IsReasoningExpanded, Mode=TwoWay}"
                                                                  Classes="composer-btn"
                                                                  HorizontalAlignment="Left"
                                                                  Padding="4,2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <materialIcons:MaterialIcon Kind="Brain" Width="13" Height="13" Foreground="{DynamicResource NavKernelsFgBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Text="Thinking Process" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavKernelsFgBrush}" VerticalAlignment="Center" />
                                                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </ToggleButton>
                                                    <Border IsVisible="{Binding IsReasoningExpanded}" Background="{DynamicResource DsBgBrush}"
                                                            BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin"
                                                            lt:Tokens.CornerRadius="DsRadiusMD" Padding="8" Margin="0,2,0,0">
                                                        <ScrollViewer MaxHeight="140" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                            <SelectableTextBlock Text="{Binding ReasoningContent}"
                                                                                 lt:Tokens.FontSize="DsFontSize150"
                                                                                 FontStyle="Italic"
                                                                                 Foreground="{DynamicResource DsTextBrush}"
                                                                                 TextWrapping="Wrap"
                                                                                 lt:Tokens.FontFamily="DsCodeFontFamily" />
                                                        </ScrollViewer>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Assistant Text Content -->
                                            <Border Background="{DynamicResource DsSurfaceBrush}"
                                                    BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsCardBorder"
                                                    lt:Tokens.CornerRadius="DsRadiusLG" Padding="12,10" lt:Tokens.BoxShadow="DsCardShadow">
                                                <StackPanel Spacing="6">
                                                    <SelectableTextBlock Text="{Binding Content}" lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsTextBrush}"
                                                                         TextWrapping="Wrap" />

                                                    <!-- Error Notice -->
                                                    <Border IsVisible="{Binding HasError}" Background="{DynamicResource DsErrorSubtleBrush}" BorderBrush="{DynamicResource DsErrorBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusSM" Padding="8" Margin="0,4">
                                                        <TextBlock Text="{Binding ErrorMessage}" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsErrorBrush}" TextWrapping="Wrap" />
                                                    </Border>

                                                    <!-- Inline Touched Files & Diff Cards -->
                                                    <ItemsControl ItemsSource="{Binding ModifiedFiles}" IsVisible="{Binding ModifiedFiles.Count}">
                                                        <ItemsControl.ItemTemplate>
                                                             <DataTemplate x:DataType="ai:ModifiedFileItem">
                                                                <Border Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Margin="0,4,0,2" Padding="8">
                                                                    <StackPanel Spacing="6">
                                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="FileDocumentEditOutline" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding SummaryText}" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" Margin="8,0" />

                                                                            <!-- Apply to Editor Button -->
                                                                            <Button Grid.Column="3"
                                                                                    Command="{Binding $parent[UserControl].((vm:AiComposerViewModel)DataContext).ApplyModifiedFileCommand}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Classes="composer-pill-btn" Height="22" Padding="6,1" Margin="4,0"
                                                                                    ToolTip.Tip="Apply changes to active document in editor">
                                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                    <materialIcons:MaterialIcon Kind="Check" Width="12" Height="12" Foreground="{DynamicResource DsGreenBrush}" />
                                                                                    <TextBlock Text="Apply" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsGreenBrush}" lt:Tokens.FontWeight="DsWeightEmphasis" />
                                                                                </StackPanel>
                                                                            </Button>

                                                                            <ToggleButton Grid.Column="4" IsChecked="{Binding IsDiffExpanded, Mode=TwoWay}"
                                                                                          Classes="composer-btn" Padding="4,2" Height="22" Width="22">
                                                                                <materialIcons:MaterialIcon Kind="CodeBraces" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                                                            </ToggleButton>
                                                                        </Grid>

                                                                        <!-- Expandable Unified Diff Viewer with Line-by-Line Syntax Highlighting -->
                                                                        <Border IsVisible="{Binding IsDiffExpanded}" Background="{DynamicResource DsBgBrush}" lt:Tokens.CornerRadius="DsRadiusSM" Padding="4,4" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin">
                                                                            <StackPanel Spacing="4">
                                                                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                                                                    <ItemsControl ItemsSource="{Binding DiffLines}">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate x:DataType="ai:DiffLine">
                                                                                                <Border Background="{Binding BackgroundHex}" Padding="8,1" Margin="0,0.5" lt:Tokens.CornerRadius="DsRadiusXS">
                                                                                                    <SelectableTextBlock Text="{Binding Text}"
                                                                                                                         lt:Tokens.FontFamily="DsCodeFontFamily"
                                                                                                                         lt:Tokens.FontSize="DsFontSize150"
                                                                                                                         Foreground="{Binding ForegroundHex}" />
                                                                                                </Border>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </ScrollViewer>

                                                                                <!-- Insert at Caret Option -->
                                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" Margin="0,2,2,2">
                                                                                    <Button Command="{Binding $parent[UserControl].((vm:AiComposerViewModel)DataContext).InsertCodeAtCursorCommand}"
                                                                                            CommandParameter="{Binding ModifiedContent}"
                                                                                            Classes="composer-pill-btn" Height="20" Padding="6,1"
                                                                                            ToolTip.Tip="Insert modified code at current cursor position">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                                                            <materialIcons:MaterialIcon Kind="CursorDefaultClickOutline" Width="11" Height="11" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                                            <TextBlock Text="Insert at Caret" lt:Tokens.FontSize="DsFontSize075" Foreground="{DynamicResource DsTextBrush}" />
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
                </Border>

                <!-- Status Strip (Row 4) -->
                <Border Grid.Row="4" Background="{DynamicResource DsSurfaceBrush}" Height="22" Padding="12,0" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderTop">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Width="6" Height="6" lt:Tokens.CornerRadius="DsRadiusXS"
                                    Background="{Binding IsGenerating, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Text="{Binding StatusText}" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Cmd+I: Toggle • Cmd+Enter: Accept" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Bottom Prompt Input Deck (Row 5) -->
                <Border Name="PromptDeckBorder" Grid.Row="5"
                        Background="{DynamicResource DsSurfaceBrush}"
                        lt:Tokens.CornerRadius="DsRadiusLGBottom"
                        Padding="12,10,12,12"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderTop">
                    <StackPanel Spacing="6">
                        <!-- @ Mention Autocomplete Popup Deck -->
                        <Border IsVisible="{Binding IsMentionPopupOpen}"
                                Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                lt:Tokens.BorderThickness="DsBorderThin"
                                lt:Tokens.CornerRadius="DsRadiusLG"
                                MaxHeight="160"
                                lt:Tokens.BoxShadow="DsBottomBarShadow">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredMentions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="ai:MentionSuggestionItem">
                                            <Button Command="{Binding ((vm:AiComposerViewModel)DataContext).InsertMentionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Prefix}"
                                                    Classes="composer-mention-item"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="8,5"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand">
                                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind, Converter={x:Static common:IconKindConverter.Instance}}" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Prefix}" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Description}" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <Border Grid.Column="3" Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusSM" Padding="5,1" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding Category}" lt:Tokens.FontSize="DsFontSize075" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <Border Background="{DynamicResource DsBgBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                lt:Tokens.BorderThickness="DsBorderThin"
                                lt:Tokens.CornerRadius="DsRadiusLG"
                                Padding="10,8,8,8">
                            <Grid RowDefinitions="*,Auto">
                                <!-- Multi-line Prompt Text Box -->
                                <TextBox Name="PromptTextBox" Grid.Row="0"
                                         Text="{Binding PromptText, Mode=TwoWay}"
                                         AcceptsReturn="True" MinHeight="40" MaxHeight="120"
                                         Background="Transparent" Foreground="{DynamicResource DsTextWhiteBrush}"
                                         BorderThickness="0"
                                         lt:Tokens.FontSize="DsFontSize350" Padding="2"
                                         PlaceholderForeground="{DynamicResource DsMutedBrush}"
                                         PlaceholderText="Ask Fry AI or describe code changes (@file, /fix)..."
                                         KeyDown="OnPromptTextBoxKeyDown" />

                                <!-- Composer Bottom Toolbar Inside Prompt Box -->
                                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                                    <!-- Left: Model Selector, Refresh, Connection & Persona -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <!-- Model Selector Dropdown -->
                                        <ComboBox ItemsSource="{Binding AvailableModels}"
                                                  SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                                  Height="24" lt:Tokens.FontSize="DsFontSize200" MinWidth="90" MaxWidth="150" Padding="6,1"
                                                  Background="{DynamicResource DsSurfaceBrush}"
                                                  BorderBrush="{DynamicResource DsBorderBrush}"
                                                  lt:Tokens.CornerRadius="DsRadiusMD"
                                                  ToolTip.Tip="{Binding SelectedModel, StringFormat='Active Model: {0}'}" />

                                        <!-- Refresh Models Button -->
                                        <Button Command="{Binding RefreshModelsCommand}" Classes="composer-btn"
                                                ToolTip.Tip="Refresh Available Models" Width="22" Height="22" Padding="0">
                                            <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                        </Button>

                                        <!-- Server Connection Pill Button -->
                                        <Button Command="{Binding ToggleConnectionDrawerCommand}" Classes="composer-pill-btn"
                                                ToolTip.Tip="{Binding EndpointStatusText, StringFormat='Server: {0} (Click to configure &amp; auto-detect)'}"
                                                Height="22" Padding="6,1"
                                                Background="{DynamicResource DsSurfaceBrush}"
                                                BorderBrush="{DynamicResource DsBorderBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="LanConnect" Width="11" Height="11" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                <Border Width="6" Height="6" lt:Tokens.CornerRadius="DsRadiusXS" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <!-- Persona Preset Button (Pill Badge style inspired by Side Panel) -->
                                        <Button Command="{Binding TogglePromptEditorCommand}"
                                                Classes="composer-pill-btn"
                                                ToolTip.Tip="Customize System Prompt &amp; Persona"
                                                Height="22" Padding="6,1"
                                                Background="{DynamicResource NavHomeBgBrush}"
                                                BorderBrush="{DynamicResource NavHomeFgBrush}">
                                            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Tune" Width="11" Height="11" Foreground="{DynamicResource NavHomeFgBrush}" />
                                                <TextBlock Text="{Binding ActivePromptPresetName}" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavHomeFgBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                <!-- Center Spacer -->
                                <Border Grid.Column="1" Background="Transparent" />

                                <!-- Right: Fast Provider Switchers & Send / Stop Button -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Command="{Binding SwitchToLmStudioCommand}" Classes="composer-pill-btn"
                                            ToolTip.Tip="Switch to LM Studio (1234)" Height="22" Padding="6,1"
                                            Background="{DynamicResource NavKernelsBgBrush}"
                                            BorderBrush="{DynamicResource NavKernelsFgBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Laptop" Width="11" Height="11" Foreground="{DynamicResource NavKernelsFgBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="LM" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavKernelsFgBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding SwitchToOllamaCommand}" Classes="composer-pill-btn"
                                            ToolTip.Tip="Switch to Ollama (11434)" Height="22" Padding="6,1"
                                            Background="{DynamicResource NavHomeBgBrush}"
                                            BorderBrush="{DynamicResource NavHomeFgBrush}">
                                        <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Server" Width="11" Height="11" Foreground="{DynamicResource NavHomeFgBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="Ollama" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource NavHomeFgBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Send / Stop Action Button -->
                                    <Button Command="{Binding StopGenerationCommand}" Classes="action-stop"
                                            Height="24" Width="24"
                                            IsVisible="{Binding IsGenerating}" ToolTip.Tip="Stop Generation">
                                        <materialIcons:MaterialIcon Kind="Stop" Width="12" Height="12" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                    </Button>
                                    <Button Command="{Binding SendMessageCommand}" Classes="action-send"
                                            Height="24" Width="24"
                                            IsVisible="{Binding !IsGenerating}" ToolTip.Tip="Send Prompt (Enter)">
                                        <materialIcons:MaterialIcon Kind="Send" Width="12" Height="12" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                    </StackPanel>
                </Border>

                </Grid>

                <!-- ======================================================== -->
                <!-- FLOATING RESIZE HANDLES & CORNER GRIP                    -->
                <!-- ======================================================== -->
                <!-- Left Border Resize Handle -->
                <Border Name="ResizeHandleLeft" Width="8"
                        HorizontalAlignment="Left" VerticalAlignment="Stretch"
                        Background="Transparent" Cursor="SizeWestEast" />

                <!-- Right Border Resize Handle -->
                <Border Name="ResizeHandleRight" Width="8"
                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                        Background="Transparent" Cursor="SizeWestEast" />

                <!-- Bottom Border Resize Handle -->
                <Border Name="ResizeHandleBottom" Height="8"
                        HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                        Background="Transparent" Cursor="SizeNorthSouth" />

                <!-- Top Border Resize Handle -->
                <Border Name="ResizeHandleTop" Height="5"
                        HorizontalAlignment="Stretch" VerticalAlignment="Top"
                        Background="Transparent" Cursor="SizeNorthSouth" />

                <!-- Bottom-Left Resize Grip Handle -->
                <Border Name="ResizeHandleBottomLeft" Width="20" Height="20"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Background="Transparent" Cursor="BottomLeftCorner" />

                <!-- Bottom-Right Resize Grip Handle & Visual Indicator -->
                <Border Name="ResizeHandleBottomRight" Width="22" Height="22"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="Transparent" Cursor="BottomRightCorner">
                    <materialIcons:MaterialIcon Kind="ResizeBottomRight"
                                                Width="12" Height="12"
                                                Foreground="{DynamicResource DsMutedBrush}"
                                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,3,3" />
                </Border>
            </Panel>
        </Border>

    </Panel>
</UserControl>
