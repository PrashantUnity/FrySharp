<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:views="using:PdfEditorApp.Plugins.CSharpEditor.Views"
             xmlns:services="using:PdfEditorApp.Plugins.CSharpEditor.Services"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:common="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Common"
             xmlns:display="using:PdfEditorApp.Plugins.CSharpEditor.Services.Display"
             xmlns:visuals="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Visuals"
             xmlns:vm1="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Common"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="300"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Studio.StudioBottomDeckControl"
             x:CompileBindings="False">



    <Border MinHeight="100"
            VerticalAlignment="Stretch"
            Background="{DynamicResource DsBgBrush}"
            BorderBrush="{DynamicResource DsBorderBrush}"
            lt:Tokens.BorderThickness="DsBorderTop">
        <Grid RowDefinitions="Auto,*">
            <!-- Bottom Deck Tab Bar -->
            <Border Grid.Row="0" Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderBottom">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!-- Tab 0: Results (.Dump) -->
                        <Button Command="{Binding SetBottomTabCommand}" CommandParameter="0"
                                Classes="ide-tab-btn"
                                Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static common:NumberEqualsConverter.Instance}, ConverterParameter=0}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Table" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                <TextBlock Text="Results (.Dump)" VerticalAlignment="Center" />
                                <Border Classes="ide-tab-badge"
                                        Background="{DynamicResource DsPrimaryBrush}"
                                        IsVisible="{Binding DumpResults.Count}">
                                    <TextBlock Text="{Binding DumpResults.Count}" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Tab 1: Terminal / Console -->
                        <Button Command="{Binding SetBottomTabCommand}" CommandParameter="1"
                                Classes="ide-tab-btn"
                                Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static common:NumberEqualsConverter.Instance}, ConverterParameter=1}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="Console" Width="14" Height="14" />
                                <TextBlock Text="Terminal / Console" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 2: Problems -->
                        <Button Command="{Binding SetBottomTabCommand}" CommandParameter="2"
                                Classes="ide-tab-btn"
                                Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static common:NumberEqualsConverter.Instance}, ConverterParameter=2}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14" Foreground="{DynamicResource DsWarningBrush}" />
                                <TextBlock Text="Problems" VerticalAlignment="Center" />
                                <Border Classes="ide-tab-badge"
                                        Background="{DynamicResource DsErrorBrush}"
                                        IsVisible="{Binding ErrorCount}">
                                    <TextBlock Text="{Binding ErrorCount}" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Tab 3: Test Cases -->
                        <Button Command="{Binding SetBottomTabCommand}" CommandParameter="3"
                                Classes="ide-tab-btn"
                                IsVisible="{Binding SupportsTestCases}"
                                Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static common:NumberEqualsConverter.Instance}, ConverterParameter=3}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="CheckboxMarkedCircleOutline" Width="14" Height="14" />
                                <TextBlock Text="Test Cases" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Tab 4: Interactive Debugger (REPL) -->
                        <Button Command="{Binding SetBottomTabCommand}" CommandParameter="4"
                                Classes="ide-tab-btn"
                                IsVisible="{Binding SupportsDebugging}"
                                Classes.active="{Binding SelectedBottomTabIndex, Converter={x:Static common:NumberEqualsConverter.Instance}, ConverterParameter=4}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="BugOutline" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                <TextBlock Text="Debug Console" VerticalAlignment="Center" />
                                <Border Classes="ide-tab-badge"
                                        Background="{DynamicResource DsWarningBrush}"
                                        Padding="5,0"
                                        IsVisible="{Binding IsPaused}">
                                    <TextBlock Text="PAUSED" lt:Tokens.FontSize="DsFontSize050" Foreground="{DynamicResource DsBgBrush}" lt:Tokens.FontWeight="DsWeightStrong" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right Actions: Clear, Minimize -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Button Command="{Binding ClearResultsCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Clear Results">
                            <materialIcons:MaterialIcon Kind="TableRemove" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                        </Button>
                        <Button Command="{Binding ClearConsoleCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Clear Console">
                            <materialIcons:MaterialIcon Kind="Eraser" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                        </Button>
                        <Button Command="{Binding ToggleDeckPositionCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="{Binding DeckPositionTooltip}">
                            <Panel>
                                <materialIcons:MaterialIcon Kind="DockRight" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" IsVisible="{Binding !IsDeckDockedToRight}" />
                                <materialIcons:MaterialIcon Kind="DockBottom" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" IsVisible="{Binding IsDeckDockedToRight}" />
                            </Panel>
                        </Button>
                        <Button Command="{Binding ToggleBottomDeckCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Minimize Deck (Ctrl+J)">
                            <materialIcons:MaterialIcon Kind="ChevronDown" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Deck Content -->
            <Carousel Grid.Row="1" SelectedIndex="{Binding SelectedBottomTabIndex}">
                <!-- Tab 0: Results (.Dump) -->
                <Border Background="{DynamicResource DsBgBrush}" Padding="12,10">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel lt:Tokens.Spacing="DsSpace12">
                            <Border IsVisible="{Binding HasNoResults}" Padding="24,30" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel lt:Tokens.Spacing="DsSpace10" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="TableLarge" Width="36" Height="36" Foreground="{DynamicResource DsPrimaryBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="No Visual Dumps Yet" lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Call .Dump(), Display.Chart(), Display.Plot3D(), or Display.Visualizer() in any language to inspect results here." lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding DumpResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DumpTableResult">
                                        <views:DumpTableView />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The kinds drawn here are the ones CSharpCodeStudioViewModel.HasNoResults counts; keep them in step. -->
                            <ItemsControl ItemsSource="{Binding RichOutputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="display:RichCellOutput">
                                        <StackPanel Spacing="0">
                                            <Border IsVisible="{Binding IsImageKind}" Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="8" Margin="0,0,0,12" HorizontalAlignment="Left">
                                                <Image Source="{Binding ImageBytes, Converter={x:Static common:ImageBytesToBitmapConverter.Instance}}" MaxHeight="450" Stretch="Uniform" HorizontalAlignment="Center" />
                                            </Border>
                                            <Border IsVisible="{Binding IsControlKind}" Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="12,8" Margin="0,0,0,12">
                                                <ContentControl Content="{Binding InteractiveControl}" HorizontalAlignment="Stretch" />
                                            </Border>
                                            <Border IsVisible="{Binding IsVisualKind}" Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="12,8" Margin="0,0,0,12">
                                                <visuals:VisualOutputView Output="{Binding Visual}" />
                                            </Border>
                                            <Border IsVisible="{Binding IsInspectorKind}" Margin="0,0,0,12">
                                                <views:ObjectInspectorView DataContext="{Binding InspectorNode}" />
                                            </Border>
                                            <Border IsVisible="{Binding IsHtmlKind}">
                                                <views:RichHtmlView DataContext="{Binding HtmlContent}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Tab 1: Terminal / Console Output, and an input line while the running program reads input -->
                <Border Background="{DynamicResource DsBgBrush}" Padding="12,8">
                    <Grid RowDefinitions="*,Auto">
                        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="4">
                                <!-- 1. Runner Execution Header: Muted secondary styling -->
                                <Border IsVisible="{Binding ConsoleHeader, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Padding="0,2,0,2">
                                    <TextBlock Text="{Binding ConsoleHeader}"
                                               lt:Tokens.FontFamily="DsCodeFontFamily"
                                               FontSize="{Binding EditorFontSize}"
                                               Foreground="{DynamicResource DsMutedBrush}"
                                               Opacity="0.65"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- 2. Program Output: Crisp, high-contrast hero typography -->
                                <TextBox Text="{Binding ConsoleBody, Mode=OneWay}"
                                         lt:Tokens.FontFamily="DsCodeFontFamily"
                                         FontSize="{Binding EditorFontSize}"
                                         Background="Transparent"
                                         Foreground="{DynamicResource DsTextWhiteBrush}"
                                         BorderThickness="0"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         Padding="0" Margin="0" />

                                <!-- 3. Process Exit Footer: Subtle status indicator with status icon -->
                                <Border IsVisible="{Binding ConsoleFooter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Margin="0,4,0,2" Padding="0,6,0,0"
                                        BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderTop">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="13" Height="13"
                                                                    Foreground="{DynamicResource DsGreenBrush}"
                                                                    IsVisible="{Binding IsConsoleExitSuccess}" />
                                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="13" Height="13"
                                                                    Foreground="{DynamicResource DsErrorBrush}"
                                                                    IsVisible="{Binding IsConsoleExitError}" />
                                        <TextBlock Text="{Binding ConsoleFooter}"
                                                   lt:Tokens.FontFamily="DsCodeFontFamily"
                                                   FontSize="{Binding EditorFontSize}"
                                                   Foreground="{DynamicResource DsMutedBrush}"
                                                   Opacity="0.75"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" IsVisible="{Binding IsAcceptingProgramInput}"
                                BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderTop" Padding="0,6,0,0" Margin="0,4,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="ChevronRight" Width="14" Height="14"
                                                            Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Grid.Column="1" Text="{Binding ProgramInputText, Mode=TwoWay}"
                                         common:FocusOnTrueBehavior.IsActive="{Binding IsAcceptingProgramInput}"
                                         lt:Tokens.FontFamily="DsCodeFontFamily" FontSize="{Binding EditorFontSize}"
                                         PlaceholderText="Type input for the program, then Enter"
                                         Background="Transparent" BorderThickness="0" MinHeight="22">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding SendProgramInputCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="2" Command="{Binding SendProgramInputCommand}" Classes="cs-toolbar-icon" ToolTip.Tip="Send (Enter)">
                                    <materialIcons:MaterialIcon Kind="KeyboardReturn" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tab 2: Problems / Diagnostics -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8">
                        <TextBlock Text="No problems detected in script." lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsMutedBrush}" Margin="10" IsVisible="{Binding !Diagnostics.Count}" />
                        <ItemsControl ItemsSource="{Binding Diagnostics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm1:DiagnosticItemViewModel">
                                    <Border Background="Transparent" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderBottom" Padding="8,6">
                                        <Button Command="{Binding NavigateCommand}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0" Cursor="Hand">
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding SeverityIconKind, Converter={x:Static common:IconKindConverter.Instance}}" Foreground="{Binding SeverityColorHex}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Id}" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.FontSize="DsFontSize250" Foreground="{Binding SeverityColorHex}" />
                                                    <TextBlock Text="{Binding Message}" lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsTextWhiteBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Command="{Binding QuickFixCommand}" IsVisible="{Binding HasQuickFix}"
                                                        Classes="cs-toolbar-tonal" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <materialIcons:MaterialIcon Kind="PackageDown" Width="13" Height="13" />
                                                        <TextBlock Text="{Binding QuickFixLabel}" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightEmphasis" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Grid.Column="3" Text="{Binding LocationString}" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Tab 3: Test Cases. Each case is a Check("name", answer, "expected") line in the script; every run
                     reads its ✅/❌ line back into the card. -->
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="14,7" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderBottom">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" lt:Tokens.Spacing="DsSpace10" VerticalAlignment="Center">
                                <TextBlock Text="Test Cases" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TestCasesSummary}" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Command="{Binding GenerateTestCasesCommand}" IsVisible="{Binding CanGenerateTestCases}" Classes="cs-toolbar-tonal"
                                        ToolTip.Tip="Add this problem's examples and edge cases (empty input, duplicates, negatives...), every answer verified">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon Kind="AutoFix" Width="13" Height="13" Foreground="{DynamicResource DsWarningBrush}" />
                                        <TextBlock Text="Generate" lt:Tokens.FontSize="DsFontSize200" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding RunAllTestCasesCommand}" IsVisible="{Binding HasTestCases}" Classes="cs-toolbar-tonal"
                                        ToolTip.Tip="Run the script once and check every case">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource DsGreenBrush}" />
                                        <TextBlock Text="Run All" lt:Tokens.FontSize="DsFontSize200" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding AddTestCaseCommand}" Classes="cs-toolbar-tonal" ToolTip.Tip="Check a value of your own">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" />
                                        <TextBlock Text="Add Test Case" lt:Tokens.FontSize="DsFontSize200" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,10" Spacing="8">
                            <TextBlock Text="{Binding TestCasesStatus}" IsVisible="{Binding TestCasesStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />

                            <!-- New case: what to check and the answer expected -->
                            <Border IsVisible="{Binding IsAddingTestCase}" Background="{DynamicResource DsSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource DsPrimaryBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="12,10">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="New test case" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                    <Grid ColumnDefinitions="72,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                        <TextBlock Grid.Row="0" Text="Name" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NewTestCaseName, Mode=TwoWay}" Classes="sidebar-search-box" />
                                        <TextBlock Grid.Row="1" Text="Check" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewTestCaseCall, Mode=TwoWay}" Classes="sidebar-search-box"
                                                 lt:Tokens.FontFamily="DsCodeFontFamily"
                                                 PlaceholderText="The C# expression to check, e.g. sol.MaxArea(new[] { 1, 1 })" />
                                        <TextBlock Grid.Row="2" Text="Expected" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto">
                                            <TextBox Text="{Binding NewTestCaseExpected, Mode=TwoWay}" Classes="sidebar-search-box"
                                                     lt:Tokens.FontFamily="DsCodeFontFamily"
                                                     PlaceholderText="As LeetCode prints it: 49, true, [0,1], &quot;bab&quot;" />
                                            <CheckBox Grid.Column="1" IsChecked="{Binding NewTestCaseAnyOrder, Mode=TwoWay}" Margin="10,0,0,0"
                                                      ToolTip.Tip="Accept the answer's elements in any order">
                                                <TextBlock Text="Any order" lt:Tokens.FontSize="DsFontSize200" />
                                            </CheckBox>
                                        </Grid>
                                    </Grid>
                                    <TextBlock Text="{Binding TestCaseFormError}" IsVisible="{Binding TestCaseFormError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsErrorBrush}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Adds a Check(...) line to the script; Run or F5 shows whether it passes."
                                                   lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0">
                                            <Button Command="{Binding CancelAddTestCaseCommand}" Classes="cs-toolbar-outlined">
                                                <TextBlock Text="Cancel" lt:Tokens.FontSize="DsFontSize200" />
                                            </Button>
                                            <Button Command="{Binding ConfirmAddTestCaseCommand}" Classes="cs-toolbar-filled">
                                                <TextBlock Text="Add" lt:Tokens.FontSize="DsFontSize200" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock IsVisible="{Binding !HasTestCases}" TextWrapping="Wrap" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}"
                                       Text="No test cases yet. Add one to check a value your code computes; for a Blind 75 problem, Generate brings in its examples and edge cases." />

                            <ItemsControl ItemsSource="{Binding TestCases}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:TestCaseItem">
                                        <Border Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="10,8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!-- Passed, failed, running, or not run yet -->
                                                <Panel Grid.Column="0" Width="18" Height="18" VerticalAlignment="Top" Margin="0,0,10,0">
                                                    <materialIcons:MaterialIcon Kind="CheckCircle" Foreground="{DynamicResource DsGreenBrush}" IsVisible="{Binding IsPassed}" ToolTip.Tip="Passed" />
                                                    <materialIcons:MaterialIcon Kind="CloseCircle" Foreground="{DynamicResource DsErrorBrush}" IsVisible="{Binding IsFailed}" ToolTip.Tip="Failed" />
                                                    <materialIcons:MaterialIcon Kind="TimerSand" Foreground="{DynamicResource DsPrimaryBrush}" IsVisible="{Binding IsRunning}" ToolTip.Tip="Running" />
                                                    <materialIcons:MaterialIcon Kind="CircleOutline" Foreground="{DynamicResource DsBorderBrush}" IsVisible="{Binding IsNotRun}" ToolTip.Tip="Not run yet" />
                                                </Panel>
                                                <StackPanel Grid.Column="1" Spacing="3">
                                                    <TextBlock Text="{Binding Name}" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Input, StringFormat='{}Input: {0}'}" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsTextWhiteBrush}" TextWrapping="Wrap"
                                                               IsVisible="{Binding Input, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <TextBlock Text="{Binding Call, StringFormat='{}Checks: {0}'}" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsTextWhiteBrush}" TextWrapping="Wrap"
                                                               IsVisible="{Binding ShowsCall}" />
                                                    <TextBlock Text="{Binding ExpectedOutput, StringFormat='{}Expected: {0}'}" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap"
                                                               IsVisible="{Binding ExpectedOutput, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                                    <TextBlock Text="{Binding ActualOutput, StringFormat='{}Output: {0}'}" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsGreenBrush}" TextWrapping="Wrap"
                                                               IsVisible="{Binding IsPassed}" />
                                                    <TextBlock Text="{Binding ActualOutput, StringFormat='{}Output: {0}'}" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsErrorBrush}" TextWrapping="Wrap"
                                                               IsVisible="{Binding IsFailed}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Command="{Binding $parent[UserControl].DataContext.DeleteTestCaseCommand}" CommandParameter="{Binding}" Classes="cs-toolbar-icon"
                                                        VerticalAlignment="Top" Margin="8,0,0,0" ToolTip.Tip="Remove this case (and the Check line the panel added for it)">
                                                    <materialIcons:MaterialIcon Kind="DeleteOutline" Width="15" Height="15" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <!-- Tab 4: Debug Console & Immediate REPL -->
                <Grid ColumnDefinitions="*,4,*">
                    <!-- Left: Locals Inspection -->
                    <Border Grid.Column="0" Padding="10,8" Background="{DynamicResource DsBgBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderRight">
                        <Grid RowDefinitions="Auto,*">
                            <!-- Same 20px header row as the REPL pane, so both titles sit on one line. -->
                            <Grid Grid.Row="0" MinHeight="20" Margin="0,0,0,4">
                                <TextBlock Text="LOCAL VARIABLES" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Row="1" IsVisible="{Binding !Locals.Count}"
                                       Text="Start debugging (F5) and stop at a breakpoint to see the local variables here."
                                       lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Locals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DebugVariableItem">
                                            <Border Background="{DynamicResource DsSurfaceHighBrush}" lt:Tokens.CornerRadius="DsRadiusSM" Padding="6,3" Margin="0,0,0,3">
                                                <StackPanel Orientation="Vertical">
                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                                                        <!-- Expander arrow -->
                                                        <Button Grid.Column="0"
                                                                Command="{Binding $parent[UserControl].DataContext.ExpandVariableCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsVisible="{Binding CanExpand}"
                                                                Classes="m3-icon-btn"
                                                                Width="18" Height="18"
                                                                Padding="0" Margin="0,0,3,0">
                                                            <materialIcons:MaterialIcon Kind="{Binding IsExpanded, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=True, FallbackValue=ChevronRight}" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                                                        </Button>

                                                        <!-- Node Icon -->
                                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="{Binding IconKind, Converter={x:Static common:IconKindConverter.Instance}}" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />

                                                        <!-- Variable Name -->
                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource CodeMemberBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <TextBlock Grid.Column="3" Text="=" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />

                                                        <!-- Type Name -->
                                                        <TextBlock Grid.Column="4" Text="{Binding TypeName, StringFormat='\{{0}\}'}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource CodeTypeBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />

                                                        <!-- Value Display (Normal or Changed Highlight) -->
                                                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ValueDisplay}"
                                                                       lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontSize="DsFontSize150"
                                                                       Foreground="{DynamicResource DsTextWhiteBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <Border IsVisible="{Binding HasValueChanged}" Background="{DynamicResource NavPinnedFgBrush}" lt:Tokens.CornerRadius="DsRadiusXS" Padding="3,0" Margin="4,0,0,0" ToolTip.Tip="Value has changed since last evaluation">
                                                                <TextBlock Text="changed" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsBgBrush}" />
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Quick actions (Explore / View) -->
                                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <Button Command="{Binding $parent[UserControl].DataContext.ExploreVariableCommand}" CommandParameter="{Binding}"
                                                                    IsVisible="{Binding IsCollection}"
                                                                    Classes="cs-toolbar-tonal" Height="20" MinHeight="0" Padding="5,0" ToolTip.Tip="Explore in Collection View (Table)">
                                                                <TextBlock Text="Explore" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightEmphasis" />
                                                            </Button>
                                                            <Button Command="{Binding $parent[UserControl].DataContext.ViewVariableCommand}" CommandParameter="{Binding}"
                                                                    IsVisible="{Binding IsTextOrStructured}"
                                                                    Classes="cs-toolbar-tonal" Height="20" MinHeight="0" Padding="5,0" ToolTip.Tip="View full text / JSON">
                                                                <TextBlock Text="View" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightEmphasis" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Sub-children (Level 2) -->
                                                    <ItemsControl ItemsSource="{Binding Children}" IsVisible="{Binding IsExpanded}" Margin="18,3,0,1">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:DebugVariableItem">
                                                                <Border Background="{DynamicResource DsSurfaceHighBrush}" lt:Tokens.CornerRadius="DsRadiusXS" Padding="4,2" Margin="0,1">
                                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
                                                                        <Button Grid.Column="0"
                                                                                Command="{Binding $parent[UserControl].DataContext.ExpandVariableCommand}"
                                                                                CommandParameter="{Binding}"
                                                                                IsVisible="{Binding CanExpand}"
                                                                                Classes="m3-icon-btn"
                                                                                Width="16" Height="16"
                                                                                Padding="0" Margin="0,0,2,0">
                                                                            <materialIcons:MaterialIcon Kind="{Binding IsExpanded, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=True, FallbackValue=ChevronRight}" Width="10" Height="10" Foreground="{DynamicResource DsMutedBrush}" />
                                                                        </Button>
                                                                        <materialIcons:MaterialIcon Grid.Column="1" Kind="{Binding IconKind, Converter={x:Static common:IconKindConverter.Instance}}" Width="12" Height="12" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                                        <TextBlock Grid.Column="2" Text="{Binding Name}" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource CodeMemberBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                                        <TextBlock Grid.Column="3" Text="=" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                                                                        <TextBlock Grid.Column="4" Text="{Binding TypeName, StringFormat='\{{0}\}'}" lt:Tokens.FontSize="DsFontSize075" Foreground="{DynamicResource CodeTypeBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                        <TextBlock Grid.Column="5" Text="{Binding ValueDisplay}" lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsTextWhiteBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                            <Button Command="{Binding $parent[UserControl].DataContext.ExploreVariableCommand}" CommandParameter="{Binding}"
                                                                                    IsVisible="{Binding IsCollection}"
                                                                                    Classes="cs-toolbar-tonal" Height="18" MinHeight="0" Padding="4,0" ToolTip.Tip="Explore in Collection View (Table)">
                                                                                <TextBlock Text="Explore" lt:Tokens.FontSize="DsFontSize075" />
                                                                            </Button>
                                                                            <Button Command="{Binding $parent[UserControl].DataContext.ViewVariableCommand}" CommandParameter="{Binding}"
                                                                                    IsVisible="{Binding IsTextOrStructured}"
                                                                                    Classes="cs-toolbar-tonal" Height="18" MinHeight="0" Padding="4,0" ToolTip.Tip="View full text / JSON">
                                                                                <TextBlock Text="View" lt:Tokens.FontSize="DsFontSize075" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Classes="studio-sash" Width="4" ResizeDirection="Columns" />

                    <!-- Right: Immediate REPL Console -->
                    <Border Grid.Column="2" Padding="10,8" Background="{DynamicResource DsBgBrush}">
                        <Grid RowDefinitions="Auto,*,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                <TextBlock Grid.Column="0" Text="IMMEDIATE REPL CONSOLE" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Command="{Binding ClearImmediateCommand}" Classes="cs-toolbar-icon" Width="20" Height="20">
                                    <materialIcons:MaterialIcon Kind="Eraser" Width="12" Height="12" />
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ImmediateOutput}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsPrimaryBrush}" TextWrapping="Wrap" Margin="0,1" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                <TextBox Grid.Column="0" Text="{Binding ImmediateInputText, Mode=TwoWay}"
                                         lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontSize="DsFontSize200"
                                         Classes="sidebar-search-box" PlaceholderText="{Binding ImmediatePromptWatermark}">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding EvaluateImmediateCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="1" Command="{Binding EvaluateImmediateCommand}" Classes="cs-toolbar-tonal" lt:Tokens.Height="DsControlHeight150" MinHeight="0" Margin="4,0,0,0">
                                    <TextBlock Text="Eval" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightStrong" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

            </Carousel>
        </Grid>
    </Border>
</UserControl>
