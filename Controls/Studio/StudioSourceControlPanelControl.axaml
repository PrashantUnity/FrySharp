<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.CodeStudio;assembly=CSharpEditorPlugin"
             xmlns:git="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.CodeStudio.Git;assembly=CSharpEditorPlugin"
             xmlns:studio="using:PdfEditorApp.Plugins.CSharpEditor.Controls.Studio"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="700"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Studio.StudioSourceControlPanelControl"
             x:DataType="git:IGitStudioHostViewModel"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*">
        <!-- Progress Bar when Git operation is active -->
        <ProgressBar Grid.Row="0" IsIndeterminate="True"
                     Height="2" MinHeight="2"
                     Foreground="{DynamicResource DsPrimaryBrush}"
                     Background="Transparent"
                     BorderThickness="0"
                     IsVisible="{Binding IsGitBusy}" />

        <!-- Main Body Content -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Panel Margin="8,6">
                <!-- State 1: Git Not Installed -->
                <Border Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD"
                        Padding="14,16" Margin="4,16"
                        IsVisible="{Binding !IsGitInstalled}">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="32" Height="32"
                                                    Foreground="{DynamicResource DsWarningBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Git Not Installed" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightStrong"
                                   Foreground="{DynamicResource DsTextWhiteBrush}" TextAlignment="Center" />
                        <TextBlock Text="Git was not found in your system PATH. Install Git to enable version control features."
                                   lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- State 2: Not a Git Repository -->
                <Border Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD"
                        Padding="16,20" Margin="4,16"
                        IsVisible="{Binding !IsGitRepository}">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="SourceBranch" Width="36" Height="36"
                                                    Foreground="{DynamicResource DsPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No Repository Initialized" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightStrong"
                                   Foreground="{DynamicResource DsTextWhiteBrush}" TextAlignment="Center" />
                        <TextBlock Text="Initialize a Git repository to track file changes and collaborate in this workspace."
                                   lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                        <Button Command="{Binding InitGitRepositoryCommand}" Classes="cs-toolbar-filled"
                                Background="{DynamicResource DsPrimaryBrush}" Foreground="{DynamicResource DsTextWhiteBrush}"
                                HorizontalAlignment="Center" Padding="14,6" lt:Tokens.CornerRadius="DsRadiusSM">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="SourceBranchPlus" Width="14" Height="14" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Initialize Repository" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- State 3: Active Git Repository -->
                <StackPanel Spacing="8" IsVisible="{Binding IsGitRepository}">
                    
                    <!-- Sleek Branch Selector Card -->
                    <Button Command="{Binding OpenBranchPickerCommand}" Classes="git-row-btn" Padding="0">
                        <Border Classes="git-branch-card" HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="SourceBranch" Width="13" Height="13"
                                                                Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding CurrentGitBranch}" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong"
                                               Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                    <materialIcons:MaterialIcon Kind="ChevronDown" Width="11" Height="11"
                                                                Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Sync Badge (Ahead/Behind counts) -->
                                <Border Grid.Column="2"
                                        Background="{DynamicResource DsPrimarySubtleBrush}"
                                        lt:Tokens.CornerRadius="DsRadiusXS" Padding="5,1"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding SyncStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        ToolTip.Tip="{Binding SyncButtonText}">
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="CloudSyncOutline" Width="11" Height="11"
                                                                    Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SyncStatusText}" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong"
                                                   Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <studio:StudioBranchPickerControl />
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Commit Area Card -->
                    <Border Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}"
                            lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="8">
                        <StackPanel Spacing="6">
                            <!-- Text Input Container -->
                            <Grid RowDefinitions="Auto,Auto">
                                <TextBox Grid.Row="0"
                                         Text="{Binding GitCommitMessage, Mode=TwoWay}"
                                         KeyDown="OnCommitBoxKeyDown"
                                         AcceptsReturn="True"
                                         MinHeight="62" MaxHeight="130"
                                         lt:Tokens.FontSize="DsFontSize200"
                                         TextWrapping="Wrap"
                                         Padding="8,6"
                                         PlaceholderText="{Binding CommitPlaceholderText}"
                                         Classes="sidebar-search-box" />

                                <!-- Floating AI Smart Commit Button -->
                                <Button Grid.Row="0"
                                        Command="{Binding GenerateSmartCommitMessageCommand}"
                                        Classes="git-tool-btn" Width="22" Height="22"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,4,4,0"
                                        ToolTip.Tip="Generate Smart Commit Message ✨">
                                    <materialIcons:MaterialIcon Kind="Creation" Width="13" Height="13"
                                                                Foreground="{DynamicResource DsWarningBrush}" VerticalAlignment="Center" />
                                </Button>
                            </Grid>

                            <!-- Primary Full-Width Commit Button -->
                            <Button Command="{Binding CommitCommand}"
                                    Classes="cs-toolbar-filled"
                                    Background="{DynamicResource DsPrimaryBrush}" Foreground="{DynamicResource DsTextWhiteBrush}"
                                    lt:Tokens.Height="DsControlHeight100" lt:Tokens.CornerRadius="DsRadiusSM"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTip.Tip="Commit Changes (⌘Enter / Ctrl+Enter)">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Check" Width="13" Height="13" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="Commit" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Sync Changes Button (Visible when commits are ahead/behind remote) -->
                            <Button Command="{Binding SyncChangesCommand}"
                                    Classes="cs-toolbar-tonal"
                                    Foreground="{DynamicResource DsPrimaryBrush}"
                                    BorderBrush="{DynamicResource DsPrimaryBrush}"
                                    lt:Tokens.BorderThickness="DsBorderThin"
                                    lt:Tokens.Height="DsControlHeight100" lt:Tokens.CornerRadius="DsRadiusSM"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    IsVisible="{Binding IsSyncButtonVisible}"
                                    ToolTip.Tip="Pull and push commits with remote">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Sync" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SyncButtonText}" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightStrong" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Section: Staged Changes -->
                    <StackPanel Spacing="2" IsVisible="{Binding HasStagedChanges}">
                        <!-- Header -->
                        <Grid ColumnDefinitions="*,Auto,Auto" Height="26" MinHeight="26">
                            <Button Grid.Column="0" Command="{Binding ToggleStagedSectionCommand}" Classes="git-row-btn" Padding="4,4">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="{Binding StagedSectionChevronKind}"
                                                                Width="12" Height="12"
                                                                Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="STAGED CHANGES" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightStrong"
                                               Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Count Badge Pill -->
                            <Border Grid.Column="1" Background="{DynamicResource DsSurfaceHighBrush}"
                                    lt:Tokens.CornerRadius="DsRadiusXS" Padding="5,1" Margin="4,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StagedChanges.Count}" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong"
                                           Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            </Border>

                            <Button Grid.Column="2" Command="{Binding UnstageAllCommand}"
                                    Classes="git-tool-btn" Width="20" Height="20" ToolTip.Tip="Unstage All Changes" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Minus" Width="12" Height="12"
                                                            Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <!-- Staged Items -->
                        <ItemsControl ItemsSource="{Binding StagedChanges}" IsVisible="{Binding IsStagedSectionExpanded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="git:GitFileChangeItemViewModel">
                                    <Border Classes="git-row" Padding="2,0" Height="26" MinHeight="26">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <!-- File Button (Diff) -->
                                            <Button Grid.Column="0" Command="{Binding $parent[UserControl].DataContext.OpenChangedFileCommand}"
                                                    CommandParameter="{Binding}" Classes="git-row-btn" Padding="4,2" Height="26" MinHeight="26">
                                                <Grid ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding FileIconKind}" Foreground="{Binding FileIconColor}"
                                                                                Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Classes.deleted="{Binding IsDeleted}"
                                                               lt:Tokens.FontSize="DsFontSize200"
                                                               Foreground="{DynamicResource DsTextWhiteBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DirectoryDisplay}"
                                                               IsVisible="{Binding HasDirectory}"
                                                               lt:Tokens.FontSize="DsFontSize075"
                                                               Foreground="{DynamicResource DsMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </Grid>
                                            </Button>

                                            <!-- Row Hover Actions -->
                                            <StackPanel Grid.Column="1" Classes="git-row-actions" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Button Command="{Binding $parent[UserControl].DataContext.OpenSourceFileCommand}"
                                                        CommandParameter="{Binding}" Classes="git-tool-btn" Width="19" Height="19"
                                                        ToolTip.Tip="Open File">
                                                    <materialIcons:MaterialIcon Kind="OpenInApp" Width="11" Height="11"
                                                                                Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                </Button>
                                                <Button Command="{Binding $parent[UserControl].DataContext.UnstageFileCommand}"
                                                        CommandParameter="{Binding}" Classes="git-tool-btn" Width="19" Height="19"
                                                        ToolTip.Tip="Unstage Changes">
                                                    <materialIcons:MaterialIcon Kind="Minus" Width="11" Height="11"
                                                                                Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>

                                            <!-- Status Letter Badge -->
                                            <Border Grid.Column="2" Margin="4,0,0,0" Width="16" Height="16" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusLetter}" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightStrong"
                                                           Foreground="{Binding StatusColorHex}" TextAlignment="Center" VerticalAlignment="Center"
                                                           ToolTip.Tip="{Binding TooltipText}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Section: Changes (Working Tree) -->
                    <StackPanel Spacing="2">
                        <!-- Header -->
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" Height="26" MinHeight="26">
                            <Button Grid.Column="0" Command="{Binding ToggleWorkingSectionCommand}" Classes="git-row-btn" Padding="4,4">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="{Binding WorkingSectionChevronKind}"
                                                                Width="12" Height="12"
                                                                Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="CHANGES" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightStrong"
                                               Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Count Badge Pill -->
                            <Border Grid.Column="1" Background="{DynamicResource DsSurfaceHighBrush}"
                                    lt:Tokens.CornerRadius="DsRadiusXS" Padding="5,1" Margin="4,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding WorkingChanges.Count}" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong"
                                           Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            </Border>

                            <Button Grid.Column="2" Command="{Binding DiscardAllChangesCommand}"
                                    Classes="git-tool-btn" Width="20" Height="20" Margin="0,0,2,0" ToolTip.Tip="Discard All Changes" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Undo" Width="12" Height="12"
                                                            Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            </Button>
                            <Button Grid.Column="3" Command="{Binding StageAllCommand}"
                                    Classes="git-tool-btn" Width="20" Height="20" ToolTip.Tip="Stage All Changes" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Plus" Width="12" Height="12"
                                                            Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <!-- Changes Items -->
                        <ItemsControl ItemsSource="{Binding WorkingChanges}" IsVisible="{Binding IsWorkingSectionExpanded}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="git:GitFileChangeItemViewModel">
                                    <Border Classes="git-row" Padding="2,0" Height="26" MinHeight="26">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <!-- File Button (Diff) -->
                                            <Button Grid.Column="0" Command="{Binding $parent[UserControl].DataContext.OpenChangedFileCommand}"
                                                    CommandParameter="{Binding}" Classes="git-row-btn" Padding="4,2" Height="26" MinHeight="26">
                                                <Grid ColumnDefinitions="Auto,Auto,*" VerticalAlignment="Center" Margin="0,0,4,0">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding FileIconKind}" Foreground="{Binding FileIconColor}"
                                                                                Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" Classes.deleted="{Binding IsDeleted}"
                                                               lt:Tokens.FontSize="DsFontSize200"
                                                               Foreground="{DynamicResource DsTextWhiteBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding DirectoryDisplay}"
                                                               IsVisible="{Binding HasDirectory}"
                                                               lt:Tokens.FontSize="DsFontSize075"
                                                               Foreground="{DynamicResource DsMutedBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </Grid>
                                            </Button>

                                            <!-- Row Hover Actions -->
                                            <StackPanel Grid.Column="1" Classes="git-row-actions" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                <Button Command="{Binding $parent[UserControl].DataContext.OpenSourceFileCommand}"
                                                        CommandParameter="{Binding}" Classes="git-tool-btn" Width="19" Height="19"
                                                        ToolTip.Tip="Open File">
                                                    <materialIcons:MaterialIcon Kind="OpenInApp" Width="11" Height="11"
                                                                                Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                </Button>
                                                <Button Command="{Binding $parent[UserControl].DataContext.DiscardFileChangesCommand}"
                                                        CommandParameter="{Binding}" Classes="git-tool-btn" Width="19" Height="19"
                                                        ToolTip.Tip="Discard Changes">
                                                    <materialIcons:MaterialIcon Kind="Undo" Width="11" Height="11"
                                                                                Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                </Button>
                                                <Button Command="{Binding $parent[UserControl].DataContext.StageFileCommand}"
                                                        CommandParameter="{Binding}" Classes="git-tool-btn" Width="19" Height="19"
                                                        ToolTip.Tip="Stage Changes">
                                                    <materialIcons:MaterialIcon Kind="Plus" Width="12" Height="12"
                                                                                Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                </Button>
                                            </StackPanel>

                                            <!-- Status Letter Badge -->
                                            <Border Grid.Column="2" Margin="4,0,0,0" Width="16" Height="16" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusLetter}" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightStrong"
                                                           Foreground="{Binding StatusColorHex}" TextAlignment="Center" VerticalAlignment="Center"
                                                           ToolTip.Tip="{Binding TooltipText}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Clean State Message -->
                        <Border Background="{DynamicResource DsSurfaceBrush}"
                                lt:Tokens.CornerRadius="DsRadiusSM" Padding="12,14" Margin="0,8"
                                IsVisible="{Binding !HasAnyGitChanges}">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16"
                                                            Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Working tree clean. No uncommitted changes." lt:Tokens.FontSize="DsFontSize150"
                                           Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Git Status Notice / Error Banner -->
                    <Border Background="{DynamicResource DsSurfaceHighBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            lt:Tokens.BorderThickness="DsBorderThin"
                            lt:Tokens.CornerRadius="DsRadiusSM"
                            Padding="8,5" Margin="0,4"
                            IsVisible="{Binding GitStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding GitStatusMessage}" lt:Tokens.FontSize="DsFontSize100"
                                       Foreground="{DynamicResource DsTextWhiteBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Command="{Binding RefreshGitStatusCommand}" Classes="git-tool-btn" Width="16" Height="16"
                                    Margin="4,0,0,0" ToolTip.Tip="Dismiss">
                                <materialIcons:MaterialIcon Kind="Close" Width="10" Height="10" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                </StackPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
