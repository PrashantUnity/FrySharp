<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:studio="using:PdfEditorApp.Plugins.CSharpEditor.Controls.Studio"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="22"
             xmlns:activities="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Activities"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Studio.StudioStatusBarControl"
             x:CompileBindings="False">



    <Border Background="{DynamicResource DsSurfaceBrush}"
            BorderBrush="{DynamicResource DsBorderBrush}"
            lt:Tokens.BorderThickness="DsBorderTop"
            Height="22"
            Padding="8,1">
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <!-- Left: Remote Pill & Problems Badge -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" lt:Tokens.Spacing="DsSpace10" VerticalAlignment="Center">
                <!-- VS Code Remote-Style Accent Pill -->
                <Border Background="{DynamicResource DsPrimaryBrush}" lt:Tokens.CornerRadius="DsRadiusXS" Padding="6,1">
                    <TextBlock Text="&gt;&lt; FrySharp" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                </Border>

                <!-- Git Branch Pill with Branch Switcher Flyout -->
                <Button DataContext="{Binding Git}"
                        Command="{Binding OpenBranchPickerCommand}"
                        Classes="status-item"
                        IsVisible="{Binding IsGitRepository}"
                        ToolTip.Tip="Checkout or switch Git Branch">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="SourceBranch" Width="12" Height="12" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentGitBranch}" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedLeft">
                            <studio:StudioBranchPickerControl />
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Git Sync Pill -->
                <Button DataContext="{Binding Git}"
                        Command="{Binding SyncChangesCommand}"
                        Classes="status-item"
                        IsVisible="{Binding IsSyncButtonVisible}"
                        ToolTip.Tip="Synchronize changes with remote repository">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="Sync" Width="11" Height="11" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SyncStatusText}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Problems Quick Button -->
                <Button Command="{Binding ShowProblemsTabCommand}" Classes="status-item" ToolTip.Tip="Errors and warnings (Ctrl+Shift+M)">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="12" Height="12" Foreground="{DynamicResource DsErrorBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ErrorCount}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                        <materialIcons:MaterialIcon Kind="AlertOutline" Width="12" Height="12" Foreground="{DynamicResource DsWarningBrush}" VerticalAlignment="Center" Margin="2,0,0,0" />
                        <TextBlock Text="{Binding WarningCount}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Running work (opening a file, starting the engine, loading extensions) -->
                <activities:ActivityStatusItem />

                <!-- Roslyn Compiler Status -->
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="12" Height="12" Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CompilerStatusText}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- Center: Execution Time -->
            <TextBlock Grid.Column="1" Text="{Binding ExecutionTimeText, StringFormat='{}⏱ {0}'}"
                       lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}"
                       Margin="14,0,0,0" VerticalAlignment="Center"
                       IsVisible="{Binding ExecutionTimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Right: Ln, Col, Indentation, Encoding, Language, Bottom Deck Toggle -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <!-- Clickable Ln, Col -> Go To Line Dialog -->
                <Button Command="{Binding ShowGoToLineCommand}"
                        Classes="status-item"
                        ToolTip.Tip="Go to Line/Column (Ctrl+G)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CaretLine, StringFormat='{}Ln {0}'}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CaretColumn, StringFormat='{}, Col {0}'}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Indentation Toggle Button -->
                <Button Command="{Binding ToggleIndentationCommand}"
                        Classes="status-item"
                        ToolTip.Tip="Toggle Indentation (2 vs 4 Spaces)">
                    <TextBlock Text="{Binding IndentationStatusText}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                </Button>

                <TextBlock Text="UTF-8" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="5,0" />

                <!-- Zoom Level Indicator / Reset Button -->
                <Button Command="{Binding ResetZoomCommand}"
                        Classes="status-item"
                        ToolTip.Tip="Editor Font Zoom (Cmd+= / Cmd+- / Cmd+0 / Cmd+Scroll) — Click to reset to 100%">
                    <TextBlock Text="{Binding ZoomPercentageText}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                </Button>

                <!-- Language Mode Selector Flyout -->
                <Button Classes="status-item"
                        IsVisible="{Binding SupportsExecutionModes}"
                        ToolTip.Tip="Select C# Execution Mode">
                    <Button.Flyout>
                        <MenuFlyout Placement="TopEdgeAlignedRight">
                            <MenuItem Header="C# Top-Level Statements" Command="{Binding SetLanguageModeCommand}" CommandParameter="0" />
                            <MenuItem Header="C# Program with Main()" Command="{Binding SetLanguageModeCommand}" CommandParameter="1" />
                            <MenuItem Header="C# Single Expression" Command="{Binding SetLanguageModeCommand}" CommandParameter="2" />
                            <Separator />
                            <MenuItem Header="In-Process Roslyn (.NET 10)" Command="{Binding SetCSharpRunnerCommand}" CommandParameter="internal" />
                            <MenuItem Header="External .NET SDK (dotnet CLI)" Command="{Binding SetCSharpRunnerCommand}" CommandParameter="external" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <TextBlock Text="{Binding LanguageModeStatusText}" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                </Button>

                <!-- Toolchain picker (e.g. which Python runs .py files), for a language that runs with an installed toolchain -->
                <Button Classes="status-item"
                        IsVisible="{Binding HasToolchain}"
                        Command="{Binding RefreshToolchainsCommand}"
                        ToolTip.Tip="Choose which installed toolchain runs this file">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <StackPanel Spacing="2" MinWidth="300" MaxWidth="460">
                                <TextBlock Text="Run with" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightEmphasis" Margin="8,4,8,2" Foreground="{DynamicResource DsMutedBrush}" />
                                <ItemsControl ItemsSource="{Binding ToolchainChoices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding Command}" Classes="status-item" Height="NaN" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4">
                                                <Grid ColumnDefinitions="18,*">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Check" Width="13" Height="13" IsVisible="{Binding IsSelected}"
                                                                                Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <TextBlock Text="{Binding Label}" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                                        <TextBlock Text="{Binding Detail}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Separator Margin="4,2" />
                                <ItemsControl ItemsSource="{Binding ToolchainActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding Command}" Classes="status-item" Height="NaN" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="8,4" ToolTip.Tip="{Binding Description}">
                                                <TextBlock Text="{Binding Label}" lt:Tokens.FontSize="DsFontSize250" Margin="18,0,0,0" Foreground="{DynamicResource DsPrimaryBrush}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Command="{Binding RefreshToolchainsCommand}" Classes="status-item" Height="NaN" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4">
                                    <TextBlock Text="Look again for installed toolchains" lt:Tokens.FontSize="DsFontSize250" Margin="18,0,0,0" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <materialIcons:MaterialIcon Kind="AlertOutline" Width="12" Height="12" IsVisible="{Binding IsToolchainMissing}"
                                                    Foreground="{DynamicResource DsWarningBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LanguageStatusText}" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Bottom Deck Toggle Button -->
                <Button Command="{Binding ToggleBottomDeckCommand}" Classes="status-item" Padding="4,0" ToolTip.Tip="Toggle Terminal Panel (Ctrl+J)">
                    <materialIcons:MaterialIcon Kind="DockBottom" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                </Button>

                <!-- Light/Dark Theme Toggle Button -->
                <Button Command="{Binding ToggleThemeCommand}" Classes="status-item" Padding="4,0" ToolTip.Tip="Toggle Light/Dark Theme">
                    <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
