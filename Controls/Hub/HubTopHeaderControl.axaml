<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:hub="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Hub"
             mc:Ignorable="d"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Hub.HubTopHeaderControl"
             x:DataType="hub:CSharpManagerViewModel">

                <Border Grid.Row="0"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderBottom"
                        Padding="32,0">
                    <Grid ColumnDefinitions="*,Auto">

                        <!-- Global Search Box -->
                        <Border Grid.Column="0"
                                MaxWidth="580"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource DsSurfaceBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                lt:Tokens.BorderThickness="DsBorderThin"
                                lt:Tokens.CornerRadius="DsRadiusLG"
                                Height="38"
                                Padding="12,0"
                                VerticalAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="18" Height="18"
                                                            Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1"
                                         x:Name="SearchBox"
                                         Text="{Binding SearchQuery, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         MinHeight="0" lt:Tokens.Height="DsControlHeight150" Padding="0"
                                         lt:Tokens.FontSize="DsFontSize400"
                                         Foreground="{DynamicResource DsTextWhiteBrush}"
                                         VerticalAlignment="Center" VerticalContentAlignment="Center"
                                         PlaceholderText="Search notebooks, scripts, or connections" />
                                <Button Grid.Column="2"
                                        Command="{Binding ClearSearchCommand}"
                                        IsVisible="{Binding HasSearchQuery}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="4"
                                        Cursor="Hand"
                                        ToolTip.Tip="Clear search">
                                    <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <!-- Ctrl+K / ⌘K Badge: the shortcut that focuses this box (the Hub view handles it) -->
                                <Border Grid.Column="3" Background="{DynamicResource DsBorderBrush}" lt:Tokens.CornerRadius="DsRadiusSM" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock x:Name="ShortcutModifier" Text="Ctrl" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsMutedBrush}" />
                                        <TextBlock Text="K" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Right Actions: Refresh & System Status Rail Toggle -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" lt:Tokens.Spacing="DsSpace10" VerticalAlignment="Center">
                            <!-- Refresh: reads the workspace from disk again (nothing is uploaded anywhere) -->
                            <Button Command="{Binding RefreshWorkspaceCommand}"
                                    Classes="nexus-btn-surface"
                                    lt:Tokens.Height="DsControlHeight500" Padding="14,0"
                                    ToolTip.Tip="Reload workspace items from disk">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Text="Refresh" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Toggle System Status Rail -->
                            <ToggleButton IsChecked="{Binding IsSystemStatusRailVisible, Mode=TwoWay}"
                                          Classes="nexus-btn-ghost"
                                          Width="36" lt:Tokens.Height="DsControlHeight500" Padding="0"
                                          ToolTip.Tip="Toggle System Status &amp; Environment Rail">
                                <materialIcons:MaterialIcon Kind="DockRight" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </ToggleButton>
                        </StackPanel>

                    </Grid>
                </Border>
</UserControl>
