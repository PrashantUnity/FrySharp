<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:hub="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Hub"
             xmlns:common="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Common"
             xmlns:hub1="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Hub"
             xmlns:explorer="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.CodeStudio.Explorer"
             mc:Ignorable="d"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Controls.Hub.HubWorkspacesPanelControl"
             x:DataType="hub:CSharpManagerViewModel">

    <StackPanel Grid.Column="0" lt:Tokens.Spacing="DsSpace16">

        <!-- Dashboard Navigation & View Switcher (Workspaces vs Starter Templates) -->
        <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin"
                    lt:Tokens.CornerRadius="DsRadiusFull" Padding="3">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Command="{Binding SetActiveDashboardViewCommand}" CommandParameter="Workspaces"
                            Classes="nexus-tab-pill"
                            Classes.active="{Binding IsWorkspacesTabActive}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FileTreeOutline" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="Workspaces" VerticalAlignment="Center" />
                            <Border Classes="nexus-badge-pill" Background="{DynamicResource DsBorderBrush}">
                                <TextBlock Text="{Binding TotalRecentWorkspaces}" Foreground="{DynamicResource DsTextBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SetActiveDashboardViewCommand}" CommandParameter="Templates"
                            Classes="nexus-tab-pill"
                            Classes.active="{Binding IsTemplatesTabActive}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="Starter Templates" VerticalAlignment="Center" />
                            <Border Classes="nexus-badge-pill" Background="{DynamicResource DsBorderBrush}">
                                <TextBlock Text="{Binding StarterTemplates.Count}" Foreground="{DynamicResource DsTextBrush}" />
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- RECENT WORKSPACES & PROJECTS (RIDER / VS CODE STYLE)    -->
        <!-- ======================================================== -->
        <StackPanel lt:Tokens.Spacing="DsSpace12" IsVisible="{Binding IsWorkspacesTabActive}">

            <!-- Header: Title & Category Filter Chips -->
            <Border common:CompactWhenCrowded.IsEnabled="True">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
                        <materialIcons:MaterialIcon Kind="History" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="RECENT WORKSPACES" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Segmented Category Filter Chips -->
                    <StackPanel Classes="hub-filter-chips" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- All Chip -->
                        <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="All"
                                Classes="nexus-filter-chip"
                                Classes.active="{Binding IsAllFilterActive}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="All" />
                                <TextBlock Text="{Binding TotalRecentWorkspaces}" lt:Tokens.FontSize="DsFontSize100" Opacity="0.7" />
                            </StackPanel>
                        </Button>

                        <!-- Workspaces Chip -->
                        <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Workspaces"
                                Classes="nexus-filter-chip"
                                Classes.active="{Binding IsWorkspacesFilterActive}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="Workspaces" />
                                <TextBlock Text="{Binding RecentWorkspacesCount}" lt:Tokens.FontSize="DsFontSize100" Opacity="0.7" />
                            </StackPanel>
                        </Button>

                        <!-- Notebooks Chip -->
                        <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Notebooks"
                                Classes="nexus-filter-chip"
                                Classes.active="{Binding IsNotebooksFilterActive}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="Notebooks" />
                                <TextBlock Text="{Binding RecentNotebooksCount}" lt:Tokens.FontSize="DsFontSize100" Opacity="0.7" />
                            </StackPanel>
                        </Button>

                        <!-- Pinned Chip -->
                        <Button Command="{Binding SetSelectedTypeFilterCommand}" CommandParameter="Pinned"
                                Classes="nexus-filter-chip"
                                Classes.active="{Binding IsPinnedFilterActive}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Pin" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Text="Pinned" />
                                <TextBlock Text="{Binding RecentPinnedCount}" lt:Tokens.FontSize="DsFontSize100" Opacity="0.7" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search & Action Bar -->
            <Grid ColumnDefinitions="*,Auto">
                <!-- Search Box -->
                <Border Grid.Column="0" Background="{DynamicResource DsSurfaceBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin"
                        lt:Tokens.CornerRadius="DsRadiusLG" Height="36" Padding="10,0" Margin="0,0,10,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <materialIcons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0"
                                 MinHeight="0" lt:Tokens.Height="DsControlHeight150" Padding="0"
                                 lt:Tokens.FontSize="DsFontSize350" Foreground="{DynamicResource DsTextWhiteBrush}"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 PlaceholderText="Search projects, workspaces, or notebooks..." />
                        <Button Grid.Column="2" Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding HasSearchQuery}"
                                Classes="nexus-btn-ghost" Width="24" Height="24" Padding="0" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Quick Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Click="OnNewWorkspaceClick"
                            Classes="nexus-btn-primary" lt:Tokens.Height="DsControlHeight500"
                            ToolTip.Tip="Create or select a new isolated workspace folder">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="New Workspace..." VerticalAlignment="Center" lt:Tokens.FontSize="DsFontSize300" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnOpenFolderClick"
                            Classes="nexus-btn-surface" lt:Tokens.Height="DsControlHeight500"
                            ToolTip.Tip="Open an existing folder as workspace">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="Open Folder..." VerticalAlignment="Center" lt:Tokens.FontSize="DsFontSize300" />
                        </StackPanel>
                    </Button>
                    <Button Click="OnOpenProjectFileClick"
                            Classes="nexus-btn-surface" lt:Tokens.Height="DsControlHeight500"
                            ToolTip.Tip="Open a script, notebook, or project file">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="15" Height="15" VerticalAlignment="Center" />
                            <TextBlock Text="Open File..." VerticalAlignment="Center" lt:Tokens.FontSize="DsFontSize300" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Projects & Workspaces List Container -->
            <Border Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    lt:Tokens.BorderThickness="DsCardBorder"
                    lt:Tokens.CornerRadius="DsRadius2XL"
                    ClipToBounds="True" lt:Tokens.BoxShadow="DsCardShadow">
                <StackPanel>
                    <!-- Empty State -->
                    <Border IsVisible="{Binding ShowRecentEmptyState}" Padding="32,48">
                        <StackPanel HorizontalAlignment="Center" lt:Tokens.Spacing="DsSpace12">
                            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource DsSurfaceHoverBrush}" HorizontalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="26" Height="26" Foreground="{DynamicResource DsMutedBrush}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Text="No recent workspaces yet" IsVisible="{Binding IsRecentWorkspacesEmpty}"
                                       lt:Tokens.FontSize="DsFontSize600" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Open a project or workspace folder from disk, or start with one of our curated templates."
                                       IsVisible="{Binding IsRecentWorkspacesEmpty}"
                                       lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                            <TextBlock Text="No matching workspaces found" IsVisible="{Binding !IsRecentWorkspacesEmpty}"
                                       lt:Tokens.FontSize="DsFontSize600" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Try clearing your search query or switching category filters."
                                       IsVisible="{Binding !IsRecentWorkspacesEmpty}"
                                       lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" lt:Tokens.Spacing="DsSpace10" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button Command="{Binding SetActiveDashboardViewCommand}" CommandParameter="Templates"
                                        Classes="nexus-btn-surface"
                                        IsVisible="{Binding IsRecentWorkspacesEmpty}">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="LightningBoltOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Browse Templates" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ResetRecentSearchAndFiltersCommand}"
                                        Classes="nexus-btn-surface"
                                        IsVisible="{Binding HasSearchQuery}">
                                    <TextBlock Text="Reset Search &amp; Filters" />
                                </Button>
                                <Button Click="OnOpenFolderClick"
                                        Classes="nexus-btn-primary">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Open Folder..." VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Rider-Style Project Items List -->
                    <ItemsControl ItemsSource="{Binding FilteredWorkspaces}" IsVisible="{Binding ShowRecentWorkspaces}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="0" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate x:DataType="models:RecentWorkspaceItem">
                                <Button Command="{Binding $parent[UserControl].((hub:CSharpManagerViewModel)DataContext).OpenRecentWorkspaceCommand}"
                                        CommandParameter="{Binding}"
                                        Classes="nexus-card-btn">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open Workspace / Project"
                                                      Command="{Binding $parent[UserControl].((hub:CSharpManagerViewModel)DataContext).OpenRecentWorkspaceCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="OpenInNew" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Pin / Unpin to Top"
                                                      Command="{Binding $parent[UserControl].((hub:CSharpManagerViewModel)DataContext).TogglePinRecentWorkspaceCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Pin" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Reveal in Finder / Explorer"
                                                      Command="{Binding $parent[UserControl].((hub:CSharpManagerViewModel)DataContext).RevealWorkspaceInFinderCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="FolderEyeOutline" Width="16" Height="16" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                             <MenuItem Header="Remove from Recent List"
                                                      Command="{Binding $parent[UserControl].((hub:CSharpManagerViewModel)DataContext).RemoveRecentWorkspaceCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="CloseCircleOutline" Width="16" Height="16" Foreground="{DynamicResource DsErrorBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>

                                    <Border Classes="nexus-table-row">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <!-- Col 0: Monogram + Project Name, Tag & Path -->
                                            <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                <!-- Monogram Tile (JetBrains Rider Style) -->
                                                <Border Grid.Column="0" Width="36" Height="36" lt:Tokens.CornerRadius="DsRadiusLG"
                                                        Background="{Binding MonogramBgBrush}"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,14,0">
                                                    <TextBlock Text="{Binding Monogram}"
                                                                lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightStrong"
                                                                Foreground="{Binding MonogramFgBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <!-- Title & Subtitle Stack -->
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   lt:Tokens.FontSize="DsFontSize400" lt:Tokens.FontWeight="DsWeightEmphasis"
                                                                   Foreground="{DynamicResource DsTextWhiteBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding Name}" />

                                                        <!-- Kind Badge Pill -->
                                                        <Border Background="{DynamicResource DsSurfaceHighBrush}"
                                                                BorderBrush="{DynamicResource DsBorderBrush}"
                                                                lt:Tokens.BorderThickness="DsBorderThin"
                                                                lt:Tokens.CornerRadius="DsRadiusSM" Padding="5,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding KindBadgeText}"
                                                                       lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong"
                                                                       Foreground="{DynamicResource DsPrimaryBrush}" />
                                                        </Border>

                                                        <!-- Git Branch Pill (if inside a git repository) -->
                                                        <Border Background="{DynamicResource DsSurfaceHoverBrush}"
                                                                BorderBrush="{DynamicResource DsBorderBrush}"
                                                                lt:Tokens.BorderThickness="DsBorderThin"
                                                                lt:Tokens.CornerRadius="DsRadiusSM" Padding="5,1"
                                                                IsVisible="{Binding HasGitBranch}"
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="SourceBranch" Width="11" Height="11" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding GitBranch}" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Pinned Indicator -->
                                                        <materialIcons:MaterialIcon Kind="Pin" Width="13" Height="13"
                                                                                    Foreground="{DynamicResource DsPrimaryBrush}"
                                                                                    IsVisible="{Binding IsPinned}"
                                                                                    VerticalAlignment="Center"
                                                                                    ToolTip.Tip="Pinned to Top" />
                                                    </StackPanel>

                                                    <!-- Path with ~ substitution -->
                                                    <TextBlock Text="{Binding DisplayPath}"
                                                               lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontFamily="DsCodeFontFamily"
                                                               Foreground="{DynamicResource DsMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding Path}" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Col 1: Last Opened Time -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LastModifiedDisplay}"
                                                       lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Margin="16,0,16,0" />

                                            <!-- Col 2: Actions (Pin + Remove + Open Chevron) -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <!-- Pin Toggle -->
                                                <Button Command="{Binding $parent[UserControl].((hub:CSharpManagerViewModel)DataContext).TogglePinRecentWorkspaceCommand}"
                                                        CommandParameter="{Binding}"
                                                        Classes="nexus-btn-ghost"
                                                        Width="28" lt:Tokens.Height="DsControlHeight150" Padding="0"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand">
                                                    <Panel>
                                                        <materialIcons:MaterialIcon Kind="Pin" Width="16" Height="16"
                                                                                    Foreground="{DynamicResource DsPrimaryBrush}"
                                                                                    IsVisible="{Binding IsPinned}"
                                                                                    ToolTip.Tip="Unpin from top" />
                                                        <materialIcons:MaterialIcon Kind="PinOutline" Width="16" Height="16"
                                                                                    Foreground="{DynamicResource DsMutedBrush}"
                                                                                    IsVisible="{Binding !IsPinned}"
                                                                                    ToolTip.Tip="Pin to top" />
                                                    </Panel>
                                                </Button>

                                                <!-- Remove from Recent List -->
                                                <Button Command="{Binding $parent[UserControl].((hub:CSharpManagerViewModel)DataContext).RemoveRecentWorkspaceCommand}"
                                                        CommandParameter="{Binding}"
                                                        Classes="nexus-btn-ghost"
                                                        Width="28" lt:Tokens.Height="DsControlHeight150" Padding="0"
                                                        VerticalAlignment="Center"
                                                        Cursor="Hand"
                                                        ToolTip.Tip="Remove from Recent Projects">
                                                    <materialIcons:MaterialIcon Kind="Close" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                                                </Button>

                                                <materialIcons:MaterialIcon Kind="ChevronRight" Width="16" Height="16" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>

                    <!-- The library's own documents of one kind (Scripts, Notebooks, API Servers, Pinned): what the side bar's
                         counts count. Light rows, the first 100, the rest one "Show more" away (searching covers them all). -->
                    <StackPanel IsVisible="{Binding IsLibraryListVisible}">
                        <TextBlock Text="Nothing of this kind in the library yet" IsVisible="{Binding !HasFilteredItems}"
                                   Margin="32,40" HorizontalAlignment="Center"
                                   lt:Tokens.FontSize="DsFontSize300" Foreground="{DynamicResource DsMutedBrush}" />
                        <ItemsControl ItemsSource="{Binding FilteredItems}">
                            <ItemsControl.DataTemplates>
                                <DataTemplate x:DataType="models:WorkspaceItemSummary">
                                    <Button Command="{Binding $parent[UserControl].((hub:CSharpManagerViewModel)DataContext).OpenItemCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="nexus-card-btn"
                                            ToolTip.Tip="{Binding DisplayLocationTooltip}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="18,10">
                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="18" Height="18" VerticalAlignment="Center"
                                                                        Foreground="{Binding IconForeground, Converter={x:Static common:HexToBrushConverter.Instance}}" />
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                           lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightEmphasis"
                                                           Foreground="{DynamicResource DsTextWhiteBrush}" />
                                                <TextBlock Text="{Binding DisplayLocation}" TextTrimming="CharacterEllipsis"
                                                           lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding KindLabel}" VerticalAlignment="Center"
                                                       lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                                <DataTemplate x:DataType="explorer:WorkspaceGroupHeaderViewModel">
                                    <StackPanel Margin="18,12,18,6">
                                        <TextBlock Text="{Binding Title}" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightStrong"
                                                   Foreground="{DynamicResource DsTextWhiteBrush}" />
                                        <TextBlock Text="{Binding SubtitleText}" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                        <Button Command="{Binding ShowMoreItemsCommand}" IsVisible="{Binding HasHiddenItems}"
                                Classes="nexus-btn-surface" HorizontalAlignment="Center" Margin="0,8,0,14">
                            <TextBlock Text="{Binding HiddenItemsText}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- STARTER TEMPLATES GALLERY VIEW -->
        <hub1:HubStarterTemplatesGalleryControl IsVisible="{Binding IsTemplatesTabActive}" />
    </StackPanel>
</UserControl>
