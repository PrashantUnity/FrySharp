<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:views="using:PdfEditorApp.Plugins.CSharpEditor.Views"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:notebooks="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Notebooks"
             xmlns:controls1="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Notebooks"
             xmlns:nb="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Notebooks"
             xmlns:studio="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Studio"
             xmlns:activities="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Activities"
             xmlns:common="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Common"
             xmlns:editor="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Editor"
             xmlns:docs="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Docs"
             xmlns:overlays="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Overlays"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="850"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpNotebookStudioView"
             x:DataType="notebooks:CSharpNotebookStudioViewModel">

    <UserControl.Resources>
        <ResourceDictionary>
            <CornerRadius x:Key="M3ShapeCornerFull">9999</CornerRadius>
            <CornerRadius x:Key="M3ShapeCornerMedium">12</CornerRadius>
            <CornerRadius x:Key="M3ShapeCornerSmall">8</CornerRadius>
            <CornerRadius x:Key="M3ShapeCornerExtraSmall">4</CornerRadius>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto" Background="{DynamicResource DsBgBrush}">

        <!-- ============================================================ -->
        <!-- ROW 0: MAIN WORKSPACE (EXPLORER SIDEBAR + SPLITTER + STUDIO) -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="{Binding SideBarGridLength, Mode=TwoWay}" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- ZONE 1: ACTIVITY BAR (Column 0, 48px fixed)              -->
            <!-- ======================================================== -->
            <Border Grid.Column="0"
                    Width="48"
                    Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    lt:Tokens.BorderThickness="DsBorderRight">
                <Grid RowDefinitions="*,Auto">
                    <!-- Top Activity Tool Buttons -->
                    <StackPanel Grid.Row="0" Spacing="0">
                        <!-- Explorer (0) -->
                        <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="0"
                                Classes="activity-bar-btn"
                                Classes.active="{Binding IsExplorerActive}"
                                ToolTip.Tip="Explorer (Ctrl+Shift+E)">
                            <materialIcons:MaterialIcon Kind="FolderMultipleOutline" Width="20" Height="20" />
                        </Button>

                        <!-- Outline (1) -->
                        <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="1"
                                Classes="activity-bar-btn"
                                Classes.active="{Binding IsOutlineActive}"
                                ToolTip.Tip="Notebook Outline">
                            <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="20" Height="20" />
                        </Button>

                        <!-- Live Variables (2) -->
                        <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="2"
                                Classes="activity-bar-btn"
                                Classes.active="{Binding IsVariablesActive}"
                                ToolTip.Tip="Live Variables">
                            <Grid>
                                <materialIcons:MaterialIcon Kind="CodeBraces" Width="20" Height="20" />
                                <Border Background="{DynamicResource DsPrimaryBrush}" lt:Tokens.CornerRadius="DsRadiusMD"
                                        Height="14" MinHeight="14" MinWidth="14" Padding="3,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0"
                                        IsVisible="{Binding Variables.Count}">
                                    <TextBlock Text="{Binding Variables.Count}" lt:Tokens.FontSize="DsFontSize050" lt:Tokens.FontWeight="DsWeightStrong"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Foreground="{DynamicResource DsTextWhiteBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Search (3) -->
                        <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="3"
                                Classes="activity-bar-btn"
                                Classes.active="{Binding IsSearchActive}"
                                ToolTip.Tip="Search Cells &amp; Code (Ctrl+Shift+F)">
                            <materialIcons:MaterialIcon Kind="Magnify" Width="20" Height="20" />
                        </Button>

                        <!-- Source Control (6) -->
                        <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="6"
                                Classes="activity-bar-btn"
                                Classes.active="{Binding IsSourceControlActive}"
                                ToolTip.Tip="Source Control (Ctrl+Shift+G / ⌘Shift+G)">
                            <Grid>
                                <materialIcons:MaterialIcon Kind="SourceCommit" Width="20" Height="20" />
                                <Border Background="{DynamicResource DsPrimaryBrush}" lt:Tokens.CornerRadius="DsRadiusMD"
                                        Height="14" MinHeight="14" MinWidth="14" Padding="3,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0"
                                        IsVisible="{Binding UncommittedChangesCount}">
                                    <TextBlock Text="{Binding UncommittedChangesCount}" lt:Tokens.FontSize="DsFontSize050" lt:Tokens.FontWeight="DsWeightStrong"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Foreground="{DynamicResource DsOnAccentBrush}" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Utility Buttons -->
                    <StackPanel Grid.Row="1" Spacing="0" Margin="0,0,0,4">
                        <!-- Documentation & Learning Center -->
                        <Button Command="{Binding NavigateToDocsCommand}"
                                Classes="activity-bar-btn"
                                ToolTip.Tip="Documentation &amp; Visualizer API Guide">
                            <materialIcons:MaterialIcon Kind="BookOpenPageVariantOutline" Width="18" Height="18" />
                        </Button>

                        <!-- Settings & Environment Setup -->
                        <Button Command="{Binding NavigateToSettingsCommand}"
                                Classes="activity-bar-btn"
                                ToolTip.Tip="Settings &amp; Environment Setup (Ctrl+, / ⌘,)">
                            <materialIcons:MaterialIcon Kind="CogOutline" Width="18" Height="18" />
                        </Button>

                        <!-- Return to Scripts Hub -->
                        <Button Command="{Binding BackToHubCommand}"
                                Classes="activity-bar-btn"
                                ToolTip.Tip="Return to Scripts &amp; Notebooks Hub">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- ZONE 2: PRIMARY SIDEBAR (Column 1, Resizable, Collapsible) -->
            <!-- ======================================================== -->
            <Border Grid.Column="1"
                    IsVisible="{Binding IsSideBarVisible}"
                    MinWidth="160"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    lt:Tokens.BorderThickness="DsBorderRight">
                <Grid RowDefinitions="Auto,*">
                    <!-- SideBar Header -->
                    <Border Grid.Row="0" Height="36"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            lt:Tokens.BorderThickness="DsBorderBottom"
                            Padding="12,0,8,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding SideBarTitle}"
                                       lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightEmphasis"
                                       Foreground="{DynamicResource DsTextWhiteBrush}"
                                       VerticalAlignment="Center" />

                            <!-- Context actions for Explorer (View 0) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                        IsVisible="{Binding IsExplorerActive}">
                                <Button Command="{Binding NewFileCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="New Notebook (.frynb)">
                                    <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding NewFolderCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="New Folder">
                                    <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Click="OnOpenProjectClick" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Open Project or File... (Ctrl+O)">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding RefreshExplorerCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Refresh Explorer">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding CollapseAllExplorerCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Collapse Folders">
                                    <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding ToggleSideBarCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)">
                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Source Control Tools (View 6) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                        IsVisible="{Binding IsSourceControlActive}">
                                <Button Command="{Binding RefreshGitStatusCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Refresh (Check for changes)">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="More Actions...">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="Sync Changes" Command="{Binding SyncChangesCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Sync" Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Commit All Changes" Command="{Binding CommitCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Check" Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Stage All Changes" Command="{Binding StageAllCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Unstage All Changes" Command="{Binding UnstageAllCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Minus" Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Discard All Changes" Command="{Binding DiscardAllChangesCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="Undo" Width="14" Height="14" Foreground="{DynamicResource DsErrorBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Initialize Repository" Command="{Binding InitGitRepositoryCommand}">
                                                <MenuItem.Icon>
                                                    <materialIcons:MaterialIcon Kind="SourceBranchPlus" Width="14" Height="14" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding ToggleSideBarCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)">
                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Collapse Button for Non-Explorer / Non-Git views -->
                            <Button Grid.Column="1" Command="{Binding ToggleSideBarCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)"
                                    IsVisible="{Binding IsDefaultSidebarCloseVisible}">
                                <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- SideBar Body Panels -->
                    <Panel Grid.Row="1">
                        <!-- 1. EXPLORER VIEW (Index 0) -->
                        <studio:StudioExplorerPanelControl IsVisible="{Binding IsExplorerActive}" OpenProjectRequested="OnOpenProjectClick" />

                        <!-- 2. OUTLINE VIEW (Index 1) -->
                        <Grid IsVisible="{Binding IsOutlineActive}" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource DsSurfaceHighBrush}" Height="28" Padding="12,0">
                                <TextBlock Text="{Binding Cells.Count, StringFormat='{}CELLS ({0})'}"
                                           lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis"
                                           Foreground="{DynamicResource DsMutedBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding OutlineCells}">
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter Margin="4,6,4,0" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="notebooks:NotebookCellViewModel">
                                            <Button Command="{Binding $parent[UserControl].((notebooks:CSharpNotebookStudioViewModel)DataContext).SelectCellFromOutlineCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    lt:Tokens.BorderThickness="DsBorderAccentLeft"
                                                    BorderBrush="Transparent"
                                                    Classes.selected="{Binding IsSelected}"
                                                    HorizontalAlignment="Stretch"
                                                    lt:Tokens.Height="DsControlHeight150"
                                                    Padding="6,0"
                                                    Cursor="Hand">
                                                <Grid ColumnDefinitions="Auto,Auto,*">
                                                    <materialIcons:MaterialIcon Grid.Column="0"
                                                                                Kind="CodeBraces"
                                                                                Width="13" Height="13"
                                                                                Foreground="{DynamicResource DsPrimaryBrush}"
                                                                                IsVisible="{Binding IsCodeCell}"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,6,0" />
                                                    <materialIcons:MaterialIcon Grid.Column="0"
                                                                                Kind="FormatHeaderPound"
                                                                                Width="13" Height="13"
                                                                                Foreground="{DynamicResource NavNotebooksFgBrush}"
                                                                                IsVisible="{Binding IsMarkdownCell}"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ExecutionBadgeText}"
                                                               lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightStrong"
                                                               Foreground="{DynamicResource DsPrimaryBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0"
                                                               IsVisible="{Binding IsCodeCell}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding MarkdownTitle}"
                                                               lt:Tokens.FontSize="DsFontSize200"
                                                               Foreground="{DynamicResource DsTextWhiteBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsMarkdownCell}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Source}"
                                                               lt:Tokens.FontSize="DsFontSize200"
                                                               lt:Tokens.FontFamily="DsCodeFontFamily"
                                                               Foreground="{DynamicResource DsMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding IsCodeCell}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </Grid>

                        <!-- 3. LIVE VARIABLES VIEW (Index 2) -->
                        <Grid IsVisible="{Binding IsVariablesActive}" RowDefinitions="Auto,*">
                            <!-- The side bar title already says LIVE VARIABLES; this line is the count. -->
                            <Border Grid.Row="0" Background="{DynamicResource DsSurfaceHighBrush}" Height="28" Padding="12,0">
                                <TextBlock Text="{Binding Variables.Count, StringFormat='{}{0} in scope'}"
                                           lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis"
                                           Foreground="{DynamicResource DsMutedBrush}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Row="1" IsVisible="{Binding !Variables.Count}"
                                       Text="Run a code cell and the variables it defines show up here."
                                       lt:Tokens.FontSize="DsFontSize250" TextWrapping="Wrap" Margin="12,10"
                                       Foreground="{DynamicResource DsMutedBrush}" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Variables}" Margin="8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:NotebookVariableInfo">
                                            <Border Background="{DynamicResource DsSurfaceHighBrush}"
                                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                                    lt:Tokens.BorderThickness="DsBorderThin"
                                                    lt:Tokens.CornerRadius="DsRadiusMD"
                                                    Padding="8,6"
                                                    Margin="0,0,0,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2">
                                                        <TextBlock Text="{Binding Name}" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                                        <TextBlock Text="{Binding TypeName}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding ValueDisplay}"
                                                               lt:Tokens.FontSize="DsFontSize200"
                                                               Foreground="{DynamicResource DsMutedBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="8,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- 4. SEARCH VIEW (Index 3) -->
                        <Grid IsVisible="{Binding IsSearchActive}" RowDefinitions="Auto,Auto,*">
                            <Border Grid.Row="0" Padding="10,8">
                                <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                                         PlaceholderText="Search cells &amp; code..."
                                         Classes="sidebar-search-box" />
                            </Border>
                            <Border Grid.Row="1" Padding="12,2,12,6">
                                <TextBlock Text="{Binding SearchResultsCount, StringFormat='{}{0} matching cells'}"
                                           lt:Tokens.FontSize="DsFontSize150"
                                           Foreground="{DynamicResource DsMutedBrush}" />
                            </Border>
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding SearchPanelCells}">
                                <ItemsControl.Template>
                                    <ControlTemplate>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter Margin="4,4,4,0" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="notebooks:NotebookCellViewModel">
                                            <Button Command="{Binding $parent[UserControl].((notebooks:CSharpNotebookStudioViewModel)DataContext).SelectCellFromOutlineCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    HorizontalAlignment="Stretch"
                                                    Padding="8,6"
                                                    Cursor="Hand">
                                                <StackPanel Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <materialIcons:MaterialIcon Kind="CodeBraces" Width="12" Height="12" Foreground="{DynamicResource DsPrimaryBrush}" IsVisible="{Binding IsCodeCell}" />
                                                        <materialIcons:MaterialIcon Kind="FormatHeaderPound" Width="12" Height="12" Foreground="{DynamicResource NavNotebooksFgBrush}" IsVisible="{Binding IsMarkdownCell}" />
                                                        <TextBlock Text="{Binding ExecutionBadgeText}" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsPrimaryBrush}" IsVisible="{Binding IsCodeCell}" />
                                                        <TextBlock Text="{Binding LanguageTag}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Source}" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsTextWhiteBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </Grid>

                        <!-- 5. SOURCE CONTROL VIEW (Index 6) -->
                        <studio:StudioSourceControlPanelControl IsVisible="{Binding IsSourceControlActive}" />
                    </Panel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- VERTICAL GRID SPLITTER (Column 2)                        -->
            <!-- ======================================================== -->
            <GridSplitter Grid.Column="2"
                          Classes="studio-sash"
                          Width="4"
                          ResizeDirection="Columns"
                          Cursor="SizeWestEast"
                          IsVisible="{Binding IsSideBarVisible}" />

            <!-- ======================================================== -->
            <!-- ZONE 3: MAIN NOTEBOOK STUDIO CANVAS (Column 3)           -->
            <!-- ======================================================== -->
            <Grid Grid.Column="3" RowDefinitions="Auto,Auto,Auto,*">

                <!-- ==================================================== -->
                <!-- ROW 0: DOCUMENT TAB BAR (36px)                       -->
                <!-- ==================================================== -->
                <!-- Opening a notebook that takes a while: a line along the tab strip's bottom edge -->
                <activities:ActivityProgressLine Grid.Row="0" Location="Notebook" VerticalAlignment="Bottom" ZIndex="1" />

                <Border Grid.Row="0"
                        Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderBottom"
                        Height="36"
                        Padding="6,0,10,0">
                    <Grid>
                        <!-- Scrollable Tabs Strip -->
                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom">
                                <ItemsControl ItemsSource="{Binding Tabs}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="notebooks:NotebookTabViewModel">
                                            <!-- Tab Item -->
                                            <Border Classes="studio-tab-item"
                                                    Classes.active="{Binding IsActive}"
                                                    Height="31"
                                                    VerticalAlignment="Bottom"
                                                    Background="Transparent"
                                                    PointerPressed="OnTabPointerPressed">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Close" Command="{Binding CloseTabCommand}">
                                                            <MenuItem.Icon>
                                                                <materialIcons:MaterialIcon Kind="Close" Width="14" Height="14" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Close Others" Command="{Binding CloseOthersCommand}">
                                                            <MenuItem.Icon>
                                                                <materialIcons:MaterialIcon Kind="CloseBoxMultipleOutline" Width="14" Height="14" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Close to the Right" Command="{Binding CloseToTheRightCommand}">
                                                            <MenuItem.Icon>
                                                                <materialIcons:MaterialIcon Kind="ArrowRightBoldOutline" Width="14" Height="14" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Close All" Command="{Binding CloseAllCommand}">
                                                            <MenuItem.Icon>
                                                                <materialIcons:MaterialIcon Kind="CloseOctagonOutline" Width="14" Height="14" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="Copy Path" Command="{Binding CopyPathCommand}">
                                                            <MenuItem.Icon>
                                                                <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="Reveal in Explorer" Command="{Binding RevealInExplorerCommand}">
                                                            <MenuItem.Icon>
                                                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid RowDefinitions="2,*">
                                                    <!-- Top active accent line -->
                                                    <Border Grid.Row="0"
                                                            Height="2"
                                                            Background="{DynamicResource NavNotebooksFgBrush}"
                                                            IsVisible="{Binding IsActive}"
                                                            lt:Tokens.CornerRadius="DsRadiusXSTop" />
                                                    <Button Grid.Row="1"
                                                            Command="{Binding SelectTabCommand}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="10,0,6,0"
                                                            Cursor="Hand"
                                                            VerticalAlignment="Stretch">
                                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                                            <!-- Orange Notebook Icon -->
                                                            <materialIcons:MaterialIcon Kind="{Binding IconKind}" Width="14" Height="14" Foreground="{Binding IconColor}" VerticalAlignment="Center" />
                                                            <!-- Tab Title -->
                                                            <TextBlock Classes="tab-title"
                                                                       Text="{Binding Title}"
                                                                       lt:Tokens.FontSize="DsFontSize300"
                                                                       VerticalAlignment="Center" />
                                                            <!-- Unsaved Dot Indicator -->
                                                            <Border Width="6" Height="6" lt:Tokens.CornerRadius="DsRadiusXS" Background="{DynamicResource DsPrimaryBrush}" IsVisible="{Binding IsModified}" VerticalAlignment="Center" />
                                                            <!-- Close Tab Button -->
                                                            <Button Command="{Binding CloseTabCommand}"
                                                                    Classes="cell-tool-btn"
                                                                    Width="18" Height="18"
                                                                    Margin="2,0,0,0"
                                                                    ToolTip.Tip="Close Tab">
                                                                <materialIcons:MaterialIcon Kind="Close" Width="11" Height="11" Foreground="{DynamicResource DsMutedBrush}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- New Tab Button (+) -->
                                <Button Command="{Binding NewNotebookTabCommand}"
                                        Classes="cell-tool-btn"
                                        Width="24" Height="24"
                                        Margin="4,0,0,4"
                                        VerticalAlignment="Bottom"
                                        ToolTip.Tip="New Notebook (Ctrl+N)">
                                    <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>
                </Border>

                <!-- ==================================================== -->
                <!-- ROW 1: DEDICATED BREADCRUMB STRIP (26px)             -->
                <!-- ==================================================== -->
                <Border Grid.Row="1"
                        Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderBottom"
                        Height="26"
                        Padding="16,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" VerticalAlignment="Center">
                        <!-- Segment 1: Folder -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="13" Height="13" Foreground="{DynamicResource NavNotebooksFgBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BreadcrumbFolder}" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Chevron 1 -->
                        <materialIcons:MaterialIcon Grid.Column="1" Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.6" VerticalAlignment="Center" Margin="5,0" />

                        <!-- Segment 2: Document -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="{Binding ActiveTab.IconKind}" Width="13" Height="13" Foreground="{Binding ActiveTab.IconColor}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BreadcrumbDocument}" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightLabel" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Chevron 2 -->
                        <materialIcons:MaterialIcon Grid.Column="3" Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.6" VerticalAlignment="Center" Margin="5,0" />

                        <!-- Segment 3: Active Cell Chip -->
                        <Border Grid.Column="4"
                                Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                lt:Tokens.BorderThickness="DsBorderThin"
                                lt:Tokens.CornerRadius="DsRadiusSM"
                                Padding="6,1"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="{Binding ActiveCellTypeIcon}" Width="11" Height="11" common:ThemeBrush.Foreground="{Binding ActiveCellTypeColorKey}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveCellBadgeText}"
                                           lt:Tokens.FontSize="DsFontSize200"
                                           Foreground="{DynamicResource DsTextWhiteBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="400" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================================================== -->
                <!-- ROW 2: PROFESSIONAL ACTION TOOLBAR (38px)            -->
                <!-- ==================================================== -->
                <Border Grid.Row="2"
                        common:CompactWhenCrowded.IsEnabled="True"
                        Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderBottom"
                        Height="38"
                        Padding="14,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Left: Core Actions -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Segmented Pill for Cell Creation (+ Code & + Markdown) -->
                            <Border Background="{DynamicResource DsSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                    lt:Tokens.BorderThickness="DsBorderThin"
                                    lt:Tokens.CornerRadius="DsRadiusMD"
                                    Padding="2"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <!-- + Code -->
                                    <Button Command="{Binding AddCodeCellCommand}" Classes="nb-action-btn" lt:Tokens.Height="DsControlHeight100" Padding="8,0" ToolTip.Tip="Add Code Cell (Ctrl+Shift+Enter)">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" />
                                            <TextBlock Text="Code" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- + Markdown -->
                                    <Button Command="{Binding AddMarkdownCellCommand}" Classes="nb-action-btn" lt:Tokens.Height="DsControlHeight100" Padding="8,0" ToolTip.Tip="Add Markdown Cell">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" />
                                            <TextBlock Text="Markdown" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Rectangle Width="1" Height="18" Fill="{DynamicResource DsBorderBrush}" Margin="6,0" VerticalAlignment="Center" />

                            <!-- Run All -->
                            <Button Command="{Binding RunAllCellsCommand}" IsVisible="{Binding !IsExecuting}" Classes="nb-action-btn" ToolTip.Tip="Run All Cells (Linear Sequence)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Play" Width="13" Height="13" Foreground="{DynamicResource DsGreenBrush}" />
                                    <TextBlock Text="Run All" Classes="toolbar-label" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightLabel" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Stop / Interrupt (visible whenever any cell in this tab is executing) -->
                            <Button Command="{Binding InterruptExecutionCommand}" IsVisible="{Binding IsExecuting}" Classes="nb-action-btn" ToolTip.Tip="Stop / Interrupt Execution (Shift+F5)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Stop" Width="13" Height="13" Foreground="{DynamicResource DsErrorBrush}" />
                                    <TextBlock Text="Stop" Classes="toolbar-label" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightLabel" Foreground="{DynamicResource DsErrorBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Restart Kernel -->
                            <Button Command="{Binding RestartKernelCommand}" Classes="nb-action-btn" ToolTip.Tip="Restart Kernel &amp; Reset Variables">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="Restart" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                    <TextBlock Text="Restart" Classes="toolbar-label" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightLabel" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Clear All Outputs -->
                            <Button Command="{Binding ClearAllOutputsCommand}" Classes="nb-action-btn" ToolTip.Tip="Clear All Cell Outputs">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="CloseBoxOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                    <TextBlock Text="Clear Outputs" Classes="toolbar-label" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightLabel" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Collapse / View Options Dropdown -->
                            <Button Classes="nb-action-btn" ToolTip.Tip="Collapse or Expand Cells and Outputs">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                        <MenuItem Header="Collapse All Inputs" Command="{Binding CollapseAllInputsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="UnfoldLessHorizontal" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Expand All Inputs" Command="{Binding ExpandAllInputsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="UnfoldMoreHorizontal" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Collapse All Outputs" Command="{Binding CollapseAllOutputsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Expand All Outputs" Command="{Binding ExpandAllOutputsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="ArrowExpandVertical" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Collapse All Cells" Command="{Binding CollapseAllCellsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Expand All Cells" Command="{Binding ExpandAllCellsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Fold All Code Blocks (Ctrl+Shift+[)" Command="{Binding FoldAllCodeBlocksCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Unfold All Code Blocks (Ctrl+Shift+])" Command="{Binding UnfoldAllCodeBlocksCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="ArrowExpandVertical" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Format All Code Cells (Ctrl+K Ctrl+D)" Command="{Binding FormatAllCodeCellsCommand}">
                                            <MenuItem.Icon>
                                                <materialIcons:MaterialIcon Kind="FormatIndentIncrease" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                    <TextBlock Text="Collapse" Classes="toolbar-label" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightLabel" VerticalAlignment="Center" />
                                    <materialIcons:MaterialIcon Kind="MenuDown" Width="11" Height="11" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Rectangle Width="1" Height="18" Fill="{DynamicResource DsBorderBrush}" Margin="6,0" VerticalAlignment="Center" />

                            <!-- Outline Toggle -->
                            <Button Command="{Binding ToggleOutlineCommand}" Classes="nb-action-btn" ToolTip.Tip="Toggle Notebook Outline">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                    <TextBlock Text="Outline" Classes="toolbar-label" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightLabel" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Variables Toggle -->
                            <Button Command="{Binding ToggleVariableInspectorCommand}" Classes="nb-action-btn" ToolTip.Tip="Toggle Live Variable Inspector">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="CodeBraces" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" />
                                    <TextBlock Text="Variables" Classes="toolbar-label" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightLabel" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource DsPrimaryBrush}" lt:Tokens.CornerRadius="DsRadiusLG" Height="16" MinHeight="16" MinWidth="16" Padding="4,0" VerticalAlignment="Center" Margin="2,0,0,0">
                                        <TextBlock Text="{Binding Variables.Count}" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,1,0,0" />
                                    </Border>
                                </StackPanel>
                            </Button>

                            <!-- Save -->
                            <Button Command="{Binding SaveCommand}" Classes="nb-action-btn" ToolTip.Tip="Save Notebook (Ctrl+S)">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                    <TextBlock Text="Save" Classes="toolbar-label" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightLabel" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Right: Kernel Indicator Badge -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="nb-action-btn"
                                    Background="{DynamicResource DsSurfaceHighBrush}"
                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                    lt:Tokens.BorderThickness="DsBorderThin"
                                    lt:Tokens.CornerRadius="DsRadiusMD"
                                    lt:Tokens.Height="DsControlHeight100"
                                    Padding="10,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding KernelName}">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="ide-menu-flyout">
                                        <StackPanel Spacing="3" MinWidth="270" MaxWidth="320">
                                            <!-- Section 1: Active Runtimes in this notebook -->
                                            <TextBlock Text="ACTIVE RUNTIMES" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.LetterSpacing="DsTracking050"
                                                       Margin="8,4,8,2" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.75" />
                                            <ItemsControl ItemsSource="{Binding ActiveKernels}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="notebooks:NotebookKernelStatusItem">
                                                        <Border Padding="8,4" Margin="0,1" lt:Tokens.CornerRadius="DsRadiusSM"
                                                                Background="{DynamicResource DsSurfaceHighBrush}">
                                                            <Grid ColumnDefinitions="22,*,Auto">
                                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="14" Height="14"
                                                                                            Foreground="{Binding AccentHex}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightLabel"
                                                                            Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" Margin="6,0,8,0" />
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <Border Width="6" Height="6" lt:Tokens.CornerRadius="DsRadiusXS"
                                                                            Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding StatusText}" lt:Tokens.FontSize="DsFontSize100"
                                                                               Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Separator Margin="4,3" Background="{DynamicResource DsBorderBrush}" Height="1" />

                                            <!-- Section 2: Default Language for new cells -->
                                            <TextBlock Text="DEFAULT LANGUAGE FOR NEW CELLS" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.LetterSpacing="DsTracking050"
                                                       Margin="8,2,8,2" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.75" />
                                            <ItemsControl ItemsSource="{Binding ActiveTab.DefaultLanguageChoices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="notebooks:CellLanguageChoice">
                                                        <Button Command="{Binding Command}" Classes="ide-menu-item-btn"
                                                                Classes.selected="{Binding IsSelected}"
                                                                ToolTip.Tip="{Binding Detail}">
                                                            <Grid ColumnDefinitions="22,*,Auto,20">
                                                                <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="14" Height="14"
                                                                                            Foreground="{Binding AccentHex}" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0" Spacing="1">
                                                                    <TextBlock Text="{Binding Label}" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightEmphasis"
                                                                               Foreground="{DynamicResource DsTextWhiteBrush}" />
                                                                    <TextBlock Text="{Binding Detail}" lt:Tokens.FontSize="DsFontSize075"
                                                                               Foreground="{DynamicResource DsMutedBrush}"
                                                                               IsVisible="{Binding !!Detail}"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <Border Grid.Column="2" Background="{DynamicResource DsSurfaceHoverBrush}"
                                                                        lt:Tokens.CornerRadius="DsRadiusXS" Padding="4,1" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                        IsVisible="{Binding !!Directive}">
                                                                    <TextBlock Text="{Binding Directive}" lt:Tokens.FontSize="DsFontSize075"
                                                                               lt:Tokens.FontFamily="DsCodeFontFamily"
                                                                               Foreground="{DynamicResource DsMutedBrush}" />
                                                                </Border>
                                                                <materialIcons:MaterialIcon Grid.Column="3" Kind="Check" Width="13" Height="13"
                                                                                            IsVisible="{Binding IsSelected}"
                                                                                            Foreground="{DynamicResource DsPrimaryBrush}"
                                                                                            HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Separator Margin="4,3" Background="{DynamicResource DsBorderBrush}" Height="1" />

                                            <!-- Section 3: Restart Kernels Action -->
                                            <Button Command="{Binding RestartKernelCommand}" Classes="ide-menu-item-btn"
                                                    ToolTip.Tip="Restart every kernel of this notebook: all variables and runtime memory are cleared">
                                                <Grid ColumnDefinitions="22,*">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Restart" Width="14" Height="14"
                                                                                Foreground="{DynamicResource DsWarningBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Spacing="1">
                                                        <TextBlock Text="Restart all notebook kernels" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightEmphasis"
                                                                   Foreground="{DynamicResource DsWarningBrush}" />
                                                        <TextBlock Text="Reset runtime state and clear variables" lt:Tokens.FontSize="DsFontSize075"
                                                                   Foreground="{DynamicResource DsMutedBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="FlaskOutline" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding KernelName}"
                                               lt:Tokens.FontSize="DsFontSize250"
                                               lt:Tokens.FontWeight="DsWeightEmphasis"
                                               Foreground="{DynamicResource DsTextWhiteBrush}"
                                               VerticalAlignment="Center"
                                               MaxWidth="240"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Width="6" Height="6" lt:Tokens.CornerRadius="DsRadiusXS" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" Margin="2,0,0,0" ToolTip.Tip="Kernel: Ready" />
                                    <materialIcons:MaterialIcon Kind="MenuDown" Width="11" Height="11" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================================================== -->
                <!-- ROW 3: MAIN NOTEBOOK CANVAS                          -->
                <!-- ==================================================== -->
                <Grid Grid.Row="3">
                    <!-- Active Canvas (Visible when HasActiveTab) -->
                    <Grid IsVisible="{Binding HasActiveTab}">

                    <!-- Notebook Canvas: one continuous list of rows (the header, then a row per cell, then the footer).
                         Using StackPanel ensures consistent layout and accurate scroll extents for variable-height cells,
                         avoiding virtualization extent jumps when cells, images, or interactive tables are resized or focused. -->
                    <ItemsControl ItemsSource="{Binding CanvasRows}">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <controls1:NotebookCanvasScrollViewer x:Name="NotebookCanvasScrollViewer"
                                                                     HorizontalScrollBarVisibility="Disabled"
                                                                     VerticalScrollBarVisibility="Auto">
                                    <!-- Side margins only: the top and bottom gaps are the header and footer rows. A vertical margin
                                         here would shrink the area the virtualizing panel fills. -->
                                    <ItemsPresenter Margin="8,0,20,0" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </controls1:NotebookCanvasScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>

                            <!-- Top Insert Divider (before first cell) -->
                            <DataTemplate DataType="notebooks:NotebookCanvasHeader" x:DataType="notebooks:NotebookCanvasHeader">
                            <Border Classes="cell-insert-divider" Margin="36,8,0,6">
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <Rectangle Classes="divider-line" Height="1" Fill="{DynamicResource DsBorderBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                    <StackPanel Classes="insert-pill-group" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Command="{Binding $parent[UserControl].((notebooks:CSharpNotebookStudioViewModel)DataContext).AddCellAboveCommand}"
                                                Classes="insert-cell-pill" ToolTip.Tip="Insert Code Cell at Beginning">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="11" Height="11" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                <TextBlock Text="Code" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding $parent[UserControl].((notebooks:CSharpNotebookStudioViewModel)DataContext).AddMarkdownCellCommand}"
                                                Classes="insert-cell-pill" ToolTip.Tip="Insert Markdown Cell at Beginning">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Plus" Width="11" Height="11" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                <TextBlock Text="Markdown" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </DataTemplate>

                            <!-- Cells -->
                                    <DataTemplate DataType="notebooks:NotebookCellViewModel" x:DataType="notebooks:NotebookCellViewModel">
                                        <StackPanel Spacing="0">
                                            <!-- 2-Column IDE Cell Layout: Col 0 = Gutter, Col 1 = Unified Cell Card -->
                                            <Grid ColumnDefinitions="36,*" Margin="0,0,0,0">
                                                <!-- COLUMN 0: LEFT GUTTER (Aligned with Line 1) -->
                                                <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Right" Margin="0,4,4,0" VerticalAlignment="Top"
                                                             nb:StickyGutterBehavior.IsEnabled="{Binding IsCodeCell}">
                                                    <!-- Row 1: Gutter Input Fold & Run Button -->
                                                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                                        <Button Command="{Binding ToggleInputCollapseCommand}"
                                                                Classes="gutter-fold-btn"
                                                                ToolTip.Tip="{Binding ToggleInputCollapseTooltip}">
                                                            <Panel Width="10" Height="10">
                                                                <materialIcons:MaterialIcon Kind="ChevronDown" IsVisible="{Binding !IsInputCollapsed}" Width="10" Height="10" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                <materialIcons:MaterialIcon Kind="ChevronRight" IsVisible="{Binding IsInputCollapsed}" Width="10" Height="10" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Panel>
                                                        </Button>

                                                        <!-- Gutter Run Button (Code Cells) -->
                                                        <Button Command="{Binding RunCellCommand}"
                                                                Classes="gutter-run-btn"
                                                                Width="16" Height="16"
                                                                IsVisible="{Binding IsCodeCell}"
                                                                ToolTip.Tip="Execute Cell (Ctrl+Enter)">
                                                            <materialIcons:MaterialIcon Kind="Play" Width="10" Height="10" Foreground="{DynamicResource DsGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- COLUMN 1: UNIFIED CELL CARD -->
                                                <Border Grid.Column="1"
                                                        Classes="notebook-cell-card"
                                                        Classes.active="{Binding IsSelected}">
                                                    <Grid>
                                                        <!-- 3px Left Vertical Accent Focus Indicator -->
                                                        <Border Width="3"
                                                                Background="{DynamicResource DsPrimaryBrush}"
                                                                lt:Tokens.CornerRadius="DsRadiusSMLeft"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Stretch"
                                                                IsVisible="{Binding IsSelected}" />

                                                        <StackPanel Margin="6,0,0,0">
                                                            <!-- Code / Markdown Editor Box (Visible when !IsInputCollapsed) -->
                                                            <Grid IsVisible="{Binding IsInputVisible}">
                                                                <!-- Editor Content -->
                                                                <Panel Margin="6,4,6,4">
                                                                    <!-- The source: code in its language, markdown while it is edited (Shift+Enter renders it) -->
                                                                    <editor:BindableTextEditor IsVisible="{Binding IsSourceEditorVisible}"
                                                                                                 TextContent="{Binding Source, Mode=TwoWay}"
                                                                                                 ExecuteCommand="{Binding RunCellCommand}"
                                                                                                 ExecuteAndNextCommand="{Binding RunCellAndSelectNextCommand}"
                                                                                                 MinHeight="24"
                                                                                                 FontSize="{Binding ((notebooks:CSharpNotebookStudioViewModel)DataContext).EditorFontSize, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=13.0}" />

                                                                    <!-- Markdown View (Rendered Header & Notes) -->
                                                                    <docs:MarkdownView IsVisible="{Binding IsViewingMarkdown}" Margin="8,6"
                                                                                           Markdown="{Binding Source}"
                                                                                           FontSize="{Binding ((notebooks:CSharpNotebookStudioViewModel)DataContext).EditorFontSize, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue=12.5}" Foreground="{DynamicResource DsTextWhiteBrush}" />

                                                                </Panel>

                                                                <!-- Floating Action Bar & Language Tag (Top Right Overlay) -->
                                                                <Border Classes="cell-floating-toolbar"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        Margin="0,-14,12,0"
                                                                        Padding="4,2">
                                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                                        <!-- Language Tag Chip (C# / MD) -->
                                                                        <Border Background="{DynamicResource DsSurfaceBrush}"
                                                                                BorderBrush="{DynamicResource DsBorderBrush}"
                                                                                lt:Tokens.BorderThickness="DsBorderThin"
                                                                                lt:Tokens.CornerRadius="DsRadiusSM"
                                                                                Padding="6,1"
                                                                                Height="22"
                                                                                VerticalAlignment="Center"
                                                                                IsVisible="{Binding !HasLanguageChoices}">
                                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                <materialIcons:MaterialIcon Kind="{Binding EffectiveLanguageDefinition.IconKind, FallbackValue=FileDocumentOutline}"
                                                                                                            Width="11" Height="11"
                                                                                                            Foreground="{Binding EffectiveLanguageDefinition.AccentHex, FallbackValue=#8B949E}"
                                                                                                            VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding LanguageTag}"
                                                                                           lt:Tokens.FontSize="DsFontSize100"
                                                                                           lt:Tokens.FontWeight="DsWeightEmphasis"
                                                                                           Foreground="{DynamicResource DsTextWhiteBrush}"
                                                                                           VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- The code cell's language (C# / PY / JAVA / JS), a menu when the notebook has more than one -->
                                                                        <Button Classes="cell-lang-chip"
                                                                                Background="{DynamicResource DsSurfaceBrush}"
                                                                                BorderBrush="{DynamicResource DsBorderBrush}"
                                                                                lt:Tokens.BorderThickness="DsBorderThin"
                                                                                lt:Tokens.CornerRadius="DsRadiusSM"
                                                                                Padding="6,1"
                                                                                Height="22"
                                                                                IsVisible="{Binding HasLanguageChoices}"
                                                                                ToolTip.Tip="The cell's language (or start it with a line like #!python)">
                                                                            <Button.Flyout>
                                                                                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="ide-menu-flyout">
                                                                                    <StackPanel Spacing="3" MinWidth="260" MaxWidth="300">
                                                                                        <TextBlock Text="RUN THIS CELL AS" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.LetterSpacing="DsTracking050"
                                                                                                   Margin="8,4,8,2" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.75" />
                                                                                        <ItemsControl ItemsSource="{Binding LanguageChoices}">
                                                                                            <ItemsControl.ItemTemplate>
                                                                                                <DataTemplate x:DataType="notebooks:CellLanguageChoice">
                                                                                                    <Button Command="{Binding Command}" Classes="ide-menu-item-btn"
                                                                                                            Classes.selected="{Binding IsSelected}"
                                                                                                            ToolTip.Tip="{Binding Detail}">
                                                                                                        <Grid ColumnDefinitions="22,*,Auto,20">
                                                                                                            <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind}" Width="14" Height="14"
                                                                                                                                        Foreground="{Binding AccentHex}" VerticalAlignment="Center" />
                                                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,8,0" Spacing="1">
                                                                                                                <TextBlock Text="{Binding Label}" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightEmphasis"
                                                                                                                           Foreground="{DynamicResource DsTextWhiteBrush}" />
                                                                                                                <TextBlock Text="{Binding Detail}" lt:Tokens.FontSize="DsFontSize075"
                                                                                                                           Foreground="{DynamicResource DsMutedBrush}"
                                                                                                                           IsVisible="{Binding !!Detail}"
                                                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                                            </StackPanel>
                                                                                                            <Border Grid.Column="2" Background="{DynamicResource DsSurfaceHoverBrush}"
                                                                                                                    lt:Tokens.CornerRadius="DsRadiusXS" Padding="4,1" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                                                                    IsVisible="{Binding !!Directive}">
                                                                                                                <TextBlock Text="{Binding Directive}" lt:Tokens.FontSize="DsFontSize075"
                                                                                                                           lt:Tokens.FontFamily="DsCodeFontFamily"
                                                                                                                           Foreground="{DynamicResource DsMutedBrush}" />
                                                                                                            </Border>
                                                                                                            <materialIcons:MaterialIcon Grid.Column="3" Kind="Check" Width="13" Height="13"
                                                                                                                                        IsVisible="{Binding IsSelected}"
                                                                                                                                        Foreground="{DynamicResource DsPrimaryBrush}"
                                                                                                                                        HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                                                        </Grid>
                                                                                                    </Button>
                                                                                                </DataTemplate>
                                                                                            </ItemsControl.ItemTemplate>
                                                                                        </ItemsControl>
                                                                                    </StackPanel>
                                                                                </Flyout>
                                                                            </Button.Flyout>
                                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                <materialIcons:MaterialIcon Kind="{Binding EffectiveLanguageDefinition.IconKind, FallbackValue=CodeBraces}"
                                                                                                            Width="11" Height="11"
                                                                                                            Foreground="{Binding EffectiveLanguageDefinition.AccentHex, FallbackValue=#58A6FF}"
                                                                                                            VerticalAlignment="Center" />
                                                                                <TextBlock Text="{Binding EffectiveLanguageDefinition.DisplayName, FallbackValue=C#}"
                                                                                            lt:Tokens.FontSize="DsFontSize150"
                                                                                            lt:Tokens.FontWeight="DsWeightEmphasis"
                                                                                            Foreground="{DynamicResource DsTextWhiteBrush}"
                                                                                            VerticalAlignment="Center" />
                                                                                <materialIcons:MaterialIcon Kind="ChevronDown" Width="10" Height="10" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>

                                                                        <!-- Markdown preview/edit toggle button (if markdown cell) -->
                                                                        <Button Command="{Binding ToggleMarkdownPreviewCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="NaN"
                                                                                Height="20"
                                                                                Padding="5,0"
                                                                                IsVisible="{Binding IsMarkdownCell}">
                                                                            <TextBlock Text="{Binding MarkdownPreviewButtonText}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                        </Button>

                                                                        <!-- Thin Separator -->
                                                                        <Rectangle Width="1" Height="12" Fill="{DynamicResource DsBorderBrush}" VerticalAlignment="Center" Margin="2,0" />

                                                                        <!-- Run Action -->
                                                                        <Button Command="{Binding RunCellCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                IsVisible="{Binding IsCodeCell}"
                                                                                ToolTip.Tip="Execute Cell (Ctrl+Enter)">
                                                                            <materialIcons:MaterialIcon Kind="Play" Width="12" Height="12" Foreground="{DynamicResource DsGreenBrush}" />
                                                                        </Button>

                                                                        <!-- Split / Add Below -->
                                                                        <Button Command="{Binding AddCodeBelowCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                ToolTip.Tip="Insert Code Cell Below">
                                                                            <materialIcons:MaterialIcon Kind="Plus" Width="12" Height="12" />
                                                                        </Button>

                                                                        <!-- Move Up -->
                                                                        <Button Command="{Binding MoveUpCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                ToolTip.Tip="Move Cell Up">
                                                                            <materialIcons:MaterialIcon Kind="ArrowUp" Width="12" Height="12" />
                                                                        </Button>

                                                                        <!-- Move Down -->
                                                                        <Button Command="{Binding MoveDownCommand}"
                                                                                Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                ToolTip.Tip="Move Cell Down">
                                                                            <materialIcons:MaterialIcon Kind="ArrowDown" Width="12" Height="12" />
                                                                        </Button>

                                                                        <!-- Delete Cell -->
                                                                        <Button Command="{Binding DeleteCommand}"
                                                                                Classes="cell-tool-btn delete-tool"
                                                                                Width="20" Height="20"
                                                                                ToolTip.Tip="Delete Cell">
                                                                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="12" Height="12" />
                                                                        </Button>

                                                                        <!-- More Options Menu Flyout -->
                                                                        <Button Classes="cell-tool-btn"
                                                                                Width="20" Height="20"
                                                                                ToolTip.Tip="More Options">
                                                                            <Button.Flyout>
                                                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                                    <MenuItem Header="Run Cell" Command="{Binding RunCellCommand}" IsVisible="{Binding IsCodeCell}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="Play" Width="14" Height="14" Foreground="{DynamicResource DsGreenBrush}" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="Clear Output" Command="{Binding ClearOutputCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="DeleteSweepOutline" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <Separator />
                                                                                    <MenuItem Header="{Binding ToggleInputCollapseText}" Command="{Binding ToggleInputCollapseCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="UnfoldLessHorizontal" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="{Binding ToggleOutputCollapseText}" Command="{Binding ToggleOutputCollapseCommand}" IsVisible="{Binding HasOutput}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="{Binding ToggleOutputScrolledText}" Command="{Binding ToggleOutputScrolledCommand}" IsVisible="{Binding HasOutput}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="FormatLineSpacing" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="{Binding ToggleCellCollapseText}" Command="{Binding ToggleCellCollapseCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <Separator IsVisible="{Binding IsCodeCell}" />
                                                                                    <MenuItem Header="Fold Code Blocks (Ctrl+Shift+[)" Command="{Binding FoldAllCodeCommand}" IsVisible="{Binding IsCodeCell}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="Unfold Code Blocks (Ctrl+Shift+])" Command="{Binding UnfoldAllCodeCommand}" IsVisible="{Binding IsCodeCell}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="ArrowExpandVertical" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="Format Code (Ctrl+K Ctrl+D)" Command="{Binding FormatCodeCommand}" IsVisible="{Binding IsCodeCell}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="FormatIndentIncrease" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <Separator />
                                                                                    <MenuItem Header="Insert Code Below" Command="{Binding AddCodeBelowCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="Insert Markdown Below" Command="{Binding AddMarkdownBelowCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="FormatHeaderPound" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <Separator />
                                                                                    <MenuItem Header="Move Up" Command="{Binding MoveUpCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="ArrowUp" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <MenuItem Header="Move Down" Command="{Binding MoveDownCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="ArrowDown" Width="14" Height="14" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                    <Separator />
                                                                                    <MenuItem Header="Delete Cell" Command="{Binding DeleteCommand}">
                                                                                        <MenuItem.Icon>
                                                                                            <materialIcons:MaterialIcon Kind="DeleteOutline" Width="14" Height="14" Foreground="{DynamicResource DsErrorBrush}" />
                                                                                        </MenuItem.Icon>
                                                                                    </MenuItem>
                                                                                </MenuFlyout>
                                                                            </Button.Flyout>
                                                                            <TextBlock Text="..." lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Collapsed Input Placeholder Banner (Visible when IsInputCollapsed) -->
                                                            <Border Classes="notebook-collapsed-banner" IsVisible="{Binding IsInputCollapsed}">
                                                                <Button Command="{Binding ToggleInputCollapseCommand}"
                                                                        Classes="collapsed-banner-btn"
                                                                        ToolTip.Tip="Click to expand cell input"
                                                                        HorizontalAlignment="Stretch">
                                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                                        <materialIcons:MaterialIcon Grid.Column="0"
                                                                                                    Kind="ChevronRight"
                                                                                                    Width="14" Height="14"
                                                                                                    Foreground="{DynamicResource DsPrimaryBrush}"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Margin="0,0,6,0" />

                                                                        <Border Grid.Column="1"
                                                                                Background="{DynamicResource DsSurfaceHighBrush}"
                                                                                lt:Tokens.CornerRadius="DsRadiusXS"
                                                                                Padding="5,1"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0">
                                                                            <TextBlock Text="{Binding LanguageTag}"
                                                                                       lt:Tokens.FontSize="DsFontSize100"
                                                                                       lt:Tokens.FontWeight="DsWeightEmphasis"
                                                                                       Foreground="{DynamicResource DsMutedBrush}" />
                                                                        </Border>

                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding InputCollapsedSummaryText}"
                                                                                   lt:Tokens.FontSize="DsFontSize250"
                                                                                   lt:Tokens.FontFamily="DsCodeFontFamily"
                                                                                   Foreground="{DynamicResource DsTextWhiteBrush}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center" />

                                                                        <Border Grid.Column="3"
                                                                                Background="{DynamicResource DsSurfaceHighBrush}"
                                                                                BorderBrush="{DynamicResource DsBorderBrush}"
                                                                                lt:Tokens.BorderThickness="DsBorderThin"
                                                                                lt:Tokens.CornerRadius="DsRadiusXS"
                                                                                Padding="6,2"
                                                                                VerticalAlignment="Center">
                                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                <materialIcons:MaterialIcon Kind="UnfoldMoreHorizontal" Width="12" Height="12" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                                                <TextBlock Text="Expand Input" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightLabel" Foreground="{DynamicResource DsPrimaryBrush}" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                </Button>
                                                            </Border>

                                                            <!-- The running code asks for a line of input (Python's input()) -->
                                                            <Border IsVisible="{Binding IsAwaitingInput}"
                                                                    Margin="4,0,4,6"
                                                                    Padding="8,4"
                                                                    lt:Tokens.CornerRadius="DsRadiusMD"
                                                                    Background="{DynamicResource DsBgBrush}"
                                                                    BorderBrush="{DynamicResource DsPrimaryBrush}"
                                                                    lt:Tokens.BorderThickness="DsBorderThin">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                                    <TextBlock Grid.Column="0" Text="{Binding InputPrompt}"
                                                                               lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontSize="DsFontSize300"
                                                                               Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                                               MaxWidth="360" TextTrimming="CharacterEllipsis" />
                                                                    <TextBox Grid.Column="1"
                                                                             common:FocusOnTrueBehavior.IsActive="{Binding IsAwaitingInput}"
                                                                             Text="{Binding InputText, Mode=TwoWay}"
                                                                             PasswordChar="•"
                                                                             RevealPassword="{Binding !IsPasswordInput}"
                                                                             lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontSize="DsFontSize300"
                                                                             PlaceholderText="Type the input, then Enter"
                                                                             Background="Transparent" BorderThickness="0" MinHeight="22" VerticalContentAlignment="Center">
                                                                        <TextBox.KeyBindings>
                                                                            <KeyBinding Gesture="Enter" Command="{Binding SubmitInputCommand}" />
                                                                        </TextBox.KeyBindings>
                                                                    </TextBox>
                                                                    <Button Grid.Column="2" Command="{Binding SubmitInputCommand}" Classes="cell-tool-btn" ToolTip.Tip="Send (Enter)">
                                                                        <materialIcons:MaterialIcon Kind="KeyboardReturn" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                    </Button>
                                                                    <Button Grid.Column="3" Command="{Binding EndInputCommand}" Classes="cell-tool-btn" ToolTip.Tip="End of input (as Ctrl+D would)">
                                                                        <materialIcons:MaterialIcon Kind="KeyboardOffOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>

                                                            <!-- VS Code Cell Footer Status Bar (Execution count, duration, language) -->
                                                            <Border Background="{DynamicResource DsSurfaceContainerLowestBrush}"
                                                                    BorderBrush="{DynamicResource DsBorderSubtleBrush}"
                                                                    lt:Tokens.BorderThickness="DsBorderTop"
                                                                    Padding="8,4"
                                                                    Margin="-6,0,0,0"
                                                                    IsVisible="{Binding IsCodeCell}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                                    <!-- Left: [1] ✓ 0.5s -->
                                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding ExecutionBadgeText}"
                                                                                   lt:Tokens.FontFamily="DsCodeFontFamily"
                                                                                   lt:Tokens.FontSize="DsFontSize150"
                                                                                   lt:Tokens.FontWeight="DsWeightEmphasis"
                                                                                   Foreground="{Binding StatusBadgeForeground}"
                                                                                   VerticalAlignment="Center" />
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Spacing="2"
                                                                                    VerticalAlignment="Center"
                                                                                    IsVisible="{Binding ExecutionDurationShortText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                            <materialIcons:MaterialIcon Kind="Check" Width="10" Height="10" Foreground="{DynamicResource DsGreenBrush}" IsVisible="{Binding !HasError}" VerticalAlignment="Center" />
                                                                            <materialIcons:MaterialIcon Kind="Close" Width="10" Height="10" Foreground="{DynamicResource DsErrorBrush}" IsVisible="{Binding HasError}" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding ExecutionDurationShortText}"
                                                                                       lt:Tokens.FontSize="DsFontSize075"
                                                                                       Foreground="{DynamicResource DsMutedBrush}"
                                                                                       VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <!-- Right: Language name (Python, C#, etc.) -->
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding EffectiveLanguageDefinition.DisplayName, FallbackValue=C#}"
                                                                               lt:Tokens.FontSize="DsFontSize100"
                                                                               Foreground="{DynamicResource DsMutedBrush}"
                                                                               VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <!-- 2-Column IDE Cell Layout: Output Block -->
                                            <Grid ColumnDefinitions="36,*" IsVisible="{Binding HasOutput}" Margin="0,3,0,0">
                                                <!-- COLUMN 0: OUTPUT GUTTER (Output options '...' and Output Fold) -->
                                                <StackPanel Grid.Column="0" Spacing="2" HorizontalAlignment="Right" Margin="0,4,4,0">
                                                    <!-- Output Options Menu (...) Flyout -->
                                                    <Button Classes="gutter-fold-btn"
                                                            Width="16" Height="16"
                                                            ToolTip.Tip="Output Options">
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                                                <MenuItem Header="Clear Output" Command="{Binding ClearOutputCommand}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="DeleteSweepOutline" Width="14" Height="14" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="{Binding ToggleOutputCollapseText}" Command="{Binding ToggleOutputCollapseCommand}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="14" Height="14" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="{Binding ToggleOutputScrolledText}" Command="{Binding ToggleOutputScrolledCommand}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="FormatLineSpacing" Width="14" Height="14" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                                <MenuItem Header="Copy Console Output" Command="{Binding CopyOutputCommand}" IsVisible="{Binding HasTextOutput}">
                                                                    <MenuItem.Icon>
                                                                        <materialIcons:MaterialIcon Kind="ContentCopy" Width="14" Height="14" />
                                                                    </MenuItem.Icon>
                                                                </MenuItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                        <materialIcons:MaterialIcon Kind="DotsHorizontal" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>

                                                    <!-- Gutter Output Fold Button -->
                                                    <Button Command="{Binding ToggleOutputCollapseCommand}"
                                                            Classes="gutter-fold-btn"
                                                            ToolTip.Tip="{Binding ToggleOutputCollapseTooltip}"
                                                            HorizontalAlignment="Right">
                                                        <Panel Width="10" Height="10">
                                                            <materialIcons:MaterialIcon Kind="ChevronDown" IsVisible="{Binding !IsOutputCollapsed}" Width="10" Height="10" Foreground="{DynamicResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <materialIcons:MaterialIcon Kind="ChevronRight" IsVisible="{Binding IsOutputCollapsed}" Width="10" Height="10" Foreground="{DynamicResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Panel>
                                                    </Button>
                                                </StackPanel>

                                                <!-- COLUMN 1: DEDICATED OUTPUT CONTAINER -->
                                                <Border Grid.Column="1"
                                                        Classes="notebook-output-card">
                                                    <controls1:NotebookCellOutputControl />
                                                </Border>
                                            </Grid>

                                            <!-- Between-Cell Interactive Insertion Divider -->
                                            <Border Classes="cell-insert-divider">
                                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                    <Rectangle Classes="divider-line" Height="1" Fill="{DynamicResource DsBorderBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                                    <StackPanel Classes="insert-pill-group" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Command="{Binding $parent[UserControl].((notebooks:CSharpNotebookStudioViewModel)DataContext).InsertCodeCellAfterCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="insert-cell-pill" ToolTip.Tip="Insert Code Cell Below">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="Plus" Width="11" Height="11" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                <TextBlock Text="Code" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding $parent[UserControl].((notebooks:CSharpNotebookStudioViewModel)DataContext).InsertMarkdownCellAfterCommand}"
                                                                CommandParameter="{Binding}"
                                                                Classes="insert-cell-pill" ToolTip.Tip="Insert Markdown Cell Below">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <materialIcons:MaterialIcon Kind="Plus" Width="11" Height="11" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                <TextBlock Text="Markdown" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>

                            <!-- The space at the end of the notebook -->
                            <DataTemplate DataType="notebooks:NotebookCanvasFooter" x:DataType="notebooks:NotebookCanvasFooter">
                                <Border Height="48" />
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                    </Grid>

                <!-- 2. Empty State (Visible when HasNoTabs) -->
                <Border IsVisible="{Binding HasNoTabs}"
                        Background="{DynamicResource DsBgBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" lt:Tokens.Spacing="DsSpace16" MaxWidth="440">
                        <Border Width="64" Height="64" lt:Tokens.CornerRadius="DsRadius3XL" Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" HorizontalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="NotebookOutline" Width="32" Height="32" Foreground="{DynamicResource NavNotebooksFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="No Open Notebooks" lt:Tokens.FontSize="DsFontSize700" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Open a notebook from the Explorer sidebar or click below to create a new notebook."
                                       lt:Tokens.FontSize="DsFontSize350" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Button Command="{Binding NewNotebookTabCommand}"
                                Background="{DynamicResource DsPrimaryBrush}"
                                Foreground="{DynamicResource DsTextWhiteBrush}"
                                lt:Tokens.CornerRadius="DsRadiusMD"
                                lt:Tokens.Height="DsControlHeight400"
                                Padding="18,0"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="Plus" Width="15" Height="15" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                <TextBlock Text="New Notebook" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>

        <!-- ============================================================ -->
        <!-- ROW 1: STATUS BAR FOOTER                                     -->
        <!-- ============================================================ -->
        <Border Grid.Row="1"
                Background="{DynamicResource DsSurfaceBrush}"
                BorderBrush="{DynamicResource DsBorderBrush}"
                lt:Tokens.BorderThickness="DsBorderTop"
                Height="24"
                Padding="12,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Kernel status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" lt:Tokens.Spacing="DsSpace12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Border Width="6" Height="6" lt:Tokens.CornerRadius="DsRadiusXS" Background="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CompilerStatusText}" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Running work (opening a notebook, starting the engine) -->
                    <activities:ActivityStatusItem />
                </StackPanel>

                <!-- Right: Metadata & Kernel Indicator -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" lt:Tokens.Spacing="DsSpace12" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Cells.Count, StringFormat='{}Cell {0}'}" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding KernelName}" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- QUICK OPEN & COMMAND PALETTE OVERLAY MODAL                   -->
        <!-- ============================================================ -->
        <overlays:QuickOpenOverlayControl DataContext="{Binding QuickOpen}"
                                          Grid.RowSpan="2"
                                          ZIndex="999"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch" />
    </Grid>
</UserControl>
