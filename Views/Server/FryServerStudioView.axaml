<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studio="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Studio"
             xmlns:common="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Server"
             xmlns:serverControls="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Server"
             xmlns:models="using:PdfEditorApp.Plugins.CSharpEditor.Models"
             xmlns:server="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Server"
             xmlns:server1="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Models.Server"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.Server.FryServerStudioView"
             x:DataType="vm:FryServerStudioViewModel"
             Background="{DynamicResource DsBgBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <CornerRadius x:Key="M3ShapeCornerFull">9999</CornerRadius>
            <CornerRadius x:Key="ServerTabTopRadius">4,4,0,0</CornerRadius>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid RowDefinitions="*,22">
        <!-- ============================================================ -->
        <!-- ROW 0: MAIN WORKSPACE (Zone 1 - 4)                          -->
        <!-- ============================================================ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="{Binding SideBarGridLength, Mode=TwoWay}" MinWidth="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ======================================================== -->
            <!-- ZONE 1: ACTIVITY BAR (Column 0, 48px fixed)              -->
            <!-- ======================================================== -->
            <Border Grid.Column="0"
                    Width="48"
                    Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    lt:Tokens.BorderThickness="DsBorderRight">
                <Grid RowDefinitions="*,Auto">
                    <!-- Top Navigation Tool Buttons -->
                    <StackPanel Grid.Row="0" Spacing="0">
                        <!-- Explorer (Index 2), first as in the other studios -->
                        <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="2"
                                Classes="activity-bar-btn"
                                Classes.active="{Binding IsExplorerActive}"
                                ToolTip.Tip="Explorer (Ctrl+Shift+E)">
                            <materialIcons:MaterialIcon Kind="FolderMultipleOutline" Width="20" Height="20" />
                        </Button>

                        <!-- Outline (Index 0) -->
                        <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="0"
                                Classes="activity-bar-btn"
                                Classes.active="{Binding IsEndpointsOutlineActive}"
                                ToolTip.Tip="Endpoints Outline">
                            <materialIcons:MaterialIcon Kind="FormatListBulleted" Width="20" Height="20" />
                        </Button>

                        <!-- Traffic Logs (Index 1) -->
                        <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="1"
                                Classes="activity-bar-btn"
                                Classes.active="{Binding IsTrafficActive}"
                                ToolTip.Tip="Traffic Logs &amp; Telemetry">
                            <Grid>
                                <materialIcons:MaterialIcon Kind="SwapVertical" Width="20" Height="20" />
                                <Border Background="{DynamicResource DsPrimaryBrush}" lt:Tokens.CornerRadius="DsRadiusMD"
                                        Height="14" MinHeight="14" MinWidth="14" Padding="3,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0"
                                        IsVisible="{Binding TrafficLog.Count}">
                                    <TextBlock Text="{Binding TrafficLog.Count}" lt:Tokens.FontSize="DsFontSize050" lt:Tokens.FontWeight="DsWeightStrong"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Foreground="{DynamicResource DsTextWhiteBrush}" />
                                </Border>
                            </Grid>
                        </Button>

                        <!-- Running Servers (Index 3) -->
                        <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="3"
                                Classes="activity-bar-btn"
                                Classes.active="{Binding IsServersActive}"
                                ToolTip.Tip="Running Servers &amp; Processes">
                            <Grid>
                                <materialIcons:MaterialIcon Kind="ServerNetwork" Width="20" Height="20" />
                                <Border Background="{DynamicResource DsGreenBrush}" lt:Tokens.CornerRadius="DsRadiusMD"
                                        Height="14" MinHeight="14" MinWidth="14" Padding="3,0"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0"
                                        IsVisible="{Binding HasRunningServers}">
                                    <TextBlock Text="{Binding RunningServersBadgeText}" lt:Tokens.FontSize="DsFontSize050" lt:Tokens.FontWeight="DsWeightStrong"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                               Margin="0,1,0,0"
                                               Foreground="{DynamicResource DsTextWhiteBrush}" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Return to Hub Tool -->
                    <StackPanel Grid.Row="1" Spacing="0" Margin="0,0,0,4">
                        <Button Command="{Binding ReturnToHubCommand}"
                                Classes="activity-bar-btn"
                                ToolTip.Tip="Return to Scripts &amp; Servers Hub">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="18" Height="18" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================================================== -->
            <!-- ZONE 2: PRIMARY SIDEBAR (Column 1, Resizable, Collapsible) -->
            <!-- ======================================================== -->
            <Border Grid.Column="1"
                    IsVisible="{Binding IsSideBarVisible}"
                    Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    lt:Tokens.BorderThickness="DsBorderRight">
                <Grid RowDefinitions="Auto,*">
                    <!-- SideBar Header -->
                    <Border Grid.Row="0" Height="36"
                            Background="{DynamicResource DsSurfaceBrush}"
                            BorderBrush="{DynamicResource DsBorderBrush}"
                            lt:Tokens.BorderThickness="DsBorderBottom"
                            Padding="12,0,8,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding SideBarTitle}"
                                       lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightEmphasis"
                                       Foreground="{DynamicResource DsTextWhiteBrush}"
                                       VerticalAlignment="Center" />

                            <!-- The Explorer's actions, as in the other studios -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center"
                                        IsVisible="{Binding IsExplorerActive}">
                                <Button Command="{Binding Explorer.NewScriptCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="New Server (.fryserver)">
                                    <materialIcons:MaterialIcon Kind="FilePlusOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding Explorer.NewFolderCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="New Folder">
                                    <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding Explorer.RefreshExplorerCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Refresh Explorer">
                                    <materialIcons:MaterialIcon Kind="Refresh" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding Explorer.CollapseAllExplorerCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Collapse Folders">
                                    <materialIcons:MaterialIcon Kind="ArrowCollapseVertical" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                                <Button Command="{Binding ToggleSideBarCommand}" Classes="cell-tool-btn" Width="20" Height="20" ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)">
                                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                                </Button>
                            </StackPanel>

                            <!-- Header Collapse Action (other views) -->
                            <Button Grid.Column="1"
                                    Command="{Binding ToggleSideBarCommand}"
                                    IsVisible="{Binding !IsExplorerActive}"
                                    Classes="cell-tool-btn" Width="20" Height="20"
                                    ToolTip.Tip="Hide Primary Side Bar (Ctrl+B)">
                                <materialIcons:MaterialIcon Kind="ChevronLeft" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- SideBar Body Panels (Enclosed in single Panel) -->
                    <Panel Grid.Row="1">
                        <!-- View 0: Endpoints Outline Tree -->
                        <Grid IsVisible="{Binding IsEndpointsOutlineActive}" RowDefinitions="Auto,*">
                            <!-- Section Sub-Header -->
                            <Border Grid.Row="0" Background="{DynamicResource DsSurfaceHighBrush}" Height="26" Padding="12,0"
                                    BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderBottom">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Cells.Count, StringFormat='{}CELLS &amp; ROUTES ({0})'}"
                                               lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis"
                                               Foreground="{DynamicResource DsMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Command="{Binding AddEndpointCellCommand}"
                                            Classes="cell-tool-btn" Width="18" Height="18"
                                            ToolTip.Tip="Add Endpoint">
                                        <materialIcons:MaterialIcon Kind="Plus" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Cells}" Margin="0,2">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:FryServerCellViewModel">
                                            <Button Command="{Binding $parent[UserControl;1].((vm:FryServerStudioViewModel)DataContext).SelectCellCommand}"
                                                    CommandParameter="{Binding}"
                                                    Classes="server-outline-row"
                                                    Classes.selected="{Binding IsSelected}"
                                                    ToolTip.Tip="{Binding OutlineTooltip}">
                                                <Grid ColumnDefinitions="42,*,Auto" VerticalAlignment="Center">
                                                    <!-- Method Badge / Icon Chip -->
                                                    <Border Grid.Column="0"
                                                            common:ThemeBrush.Background="{Binding TypeBadgeBgKey}"
                                                            common:ThemeBrush.BorderBrush="{Binding TypeBadgeBorderKey}"
                                                            lt:Tokens.BorderThickness="DsBorderThin"
                                                            lt:Tokens.CornerRadius="DsRadiusXS"
                                                            Width="38"
                                                            Height="16"
                                                            Margin="0,0,4,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeBadgeText}"
                                                                   lt:Tokens.FontSize="DsFontSize050"
                                                                   lt:Tokens.FontWeight="DsWeightStrong"
                                                                   common:ThemeBrush.Foreground="{Binding TypeBadgeFgKey}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>

                                                    <!-- Route for Endpoints -->
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Route}"
                                                               IsVisible="{Binding IsEndpoint}"
                                                               lt:Tokens.FontFamily="DsCodeFontFamily"
                                                               lt:Tokens.FontSize="DsFontSize200"
                                                               lt:Tokens.FontWeight="DsWeightLabel"
                                                               Foreground="{DynamicResource DsTextWhiteBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="2,0,4,0" />

                                                    <!-- Title for Endpoints -->
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Title}"
                                                               IsVisible="{Binding IsEndpoint}"
                                                               lt:Tokens.FontSize="DsFontSize100"
                                                               Foreground="{DynamicResource DsMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               MaxWidth="90" />

                                                    <!-- Title for Non-Endpoints (Startup, Scenario, Markdown) -->
                                                    <TextBlock Grid.Column="1"
                                                               Grid.ColumnSpan="2"
                                                               Text="{Binding Title}"
                                                               IsVisible="{Binding !IsEndpoint}"
                                                               lt:Tokens.FontSize="DsFontSize200"
                                                               Foreground="{DynamicResource DsTextWhiteBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Margin="2,0,0,0" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>

                        <!-- View 1: Traffic Telemetry Log -->
                        <Grid IsVisible="{Binding IsTrafficActive}" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource DsSurfaceHighBrush}" Height="26" Padding="12,0"
                                    BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderBottom">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding TrafficLog.Count, StringFormat='{}REQUESTS ({0})'}"
                                               lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightEmphasis"
                                               Foreground="{DynamicResource DsMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Command="{Binding ClearTrafficLogCommand}" Classes="cell-tool-btn" Width="18" Height="18" ToolTip.Tip="Clear Logs">
                                        <materialIcons:MaterialIcon Kind="Broom" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Panel Grid.Row="1">
                                <!-- Empty State -->
                                <StackPanel IsVisible="{Binding !TrafficLog.Count}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="16">
                                    <materialIcons:MaterialIcon Kind="SwapVertical" Width="28" Height="28" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.4" HorizontalAlignment="Center" />
                                    <TextBlock Text="No Traffic Recorded" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Requests to this server will appear here in real time." lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Flat Streamlined Traffic Log List -->
                                <ListBox IsVisible="{Binding TrafficLog.Count}"
                                         ItemsSource="{Binding TrafficLog}"
                                         Classes="server-traffic-list"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="server1:FryServerTrafficLogItem">
                                            <Border BorderBrush="{DynamicResource DsBorderBrush}"
                                                    lt:Tokens.BorderThickness="DsBorderBottom"
                                                    Padding="4,5">
                                                <Grid RowDefinitions="Auto,Auto">
                                                    <!-- Row 0: Method, Path, Status -->
                                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                        <Border Grid.Column="0"
                                                                Background="{DynamicResource DsSurfaceHighBrush}"
                                                                BorderBrush="{DynamicResource DsBorderBrush}"
                                                                lt:Tokens.BorderThickness="DsBorderThin"
                                                                lt:Tokens.CornerRadius="DsRadiusXS"
                                                                Width="34"
                                                                Height="15"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Method}" lt:Tokens.FontSize="DsFontSize050" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Path}"
                                                                   lt:Tokens.FontFamily="DsCodeFontFamily"
                                                                   lt:Tokens.FontSize="DsFontSize200"
                                                                   Foreground="{DynamicResource DsTextWhiteBrush}"
                                                                   Margin="6,0,6,0"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Border Grid.Column="2"
                                                                Background="{DynamicResource DsSurfaceHoverBrush}"
                                                                lt:Tokens.CornerRadius="DsRadiusXS"
                                                                Padding="4,0"
                                                                Height="15"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding StatusCode}" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>
                                                    <!-- Row 1: Timestamp & Latency -->
                                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,3,0,0">
                                                        <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsMutedBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding ElapsedMilliseconds, StringFormat='{}{0:F1}ms'}" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontFamily="DsCodeFontFamily" Foreground="{DynamicResource DsMutedBrush}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Panel>
                        </Grid>

                        <!-- View 2: Explorer, the workspace folder as in the other studios, and the server's overview below -->
                        <Grid IsVisible="{Binding IsExplorerActive}" RowDefinitions="*,Auto,Auto">
                            <studio:StudioExplorerPanelControl Grid.Row="0" DataContext="{Binding Explorer}" />

                            <Button Grid.Row="1" Command="{Binding ToggleServerInfoCommand}" Classes="server-outline-row"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Height="28" Padding="8,0"
                                    BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderTop">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="{Binding ServerInfoChevron, Converter={x:Static common:IconKindConverter.Instance}}" Width="14" Height="14" Foreground="{DynamicResource DsMutedBrush}" />
                                    <TextBlock Text="SERVER CONFIGURATION" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <ScrollViewer Grid.Row="2" MaxHeight="360" Padding="12" IsVisible="{Binding IsServerInfoExpanded}">
                                <StackPanel lt:Tokens.Spacing="DsSpace10">
                                    <!-- Document Info Card -->
                                    <Border Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="10">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <materialIcons:MaterialIcon Kind="ServerNetwork" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                <TextBlock Text="{Binding BreadcrumbDocument}" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding FilePath, FallbackValue='In-Memory Active Session'}" lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" TextWrapping="Wrap" />
                                            <Border Height="1" Background="{DynamicResource DsBorderBrush}" Margin="0,2" />
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Runtime Engine" lt:Tokens.FontSize="DsFontSize075" Foreground="{DynamicResource DsMutedBrush}" />
                                                    <TextBlock Text=".NET 10 Roslyn" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightLabel" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="CORS Status" lt:Tokens.FontSize="DsFontSize075" Foreground="{DynamicResource DsMutedBrush}" />
                                                    <TextBlock Text="Enabled (*)" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightLabel" Foreground="{DynamicResource DsGreenBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Metrics Card -->
                                    <Border Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadiusMD" Padding="10">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="METRICS &amp; STATS" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" />
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel Grid.Column="0" Spacing="1">
                                                    <TextBlock Text="Total Endpoints" lt:Tokens.FontSize="DsFontSize075" Foreground="{DynamicResource DsMutedBrush}" />
                                                    <TextBlock Text="{Binding EndpointCount}" lt:Tokens.FontSize="DsFontSize500" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="Requests Served" lt:Tokens.FontSize="DsFontSize075" Foreground="{DynamicResource DsMutedBrush}" />
                                                    <TextBlock Text="{Binding TrafficLog.Count}" lt:Tokens.FontSize="DsFontSize500" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>


                                    <!-- Quick Export Actions -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="QUICK EXPORTS" lt:Tokens.FontSize="DsFontSize100" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" Margin="0,4,0,2" />
                                        <Button Command="{Binding ExportMinimalApiCommand}" Classes="server-outline-row" lt:Tokens.Height="DsControlHeight150" Padding="6,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="LanguageCsharp" Width="13" Height="13" Foreground="{DynamicResource NavScriptsFgBrush}" />
                                                <TextBlock Text="Export ASP.NET Program.cs" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportOpenApiCommand}" Classes="server-outline-row" lt:Tokens.Height="DsControlHeight150" Padding="6,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="FileCodeOutline" Width="13" Height="13" Foreground="{DynamicResource DsGreenBrush}" />
                                                <TextBlock Text="Export OpenAPI 3.0 (Swagger)" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding ExportCurlCommand}" Classes="server-outline-row" lt:Tokens.Height="DsControlHeight150" Padding="6,0">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <materialIcons:MaterialIcon Kind="Console" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                <TextBlock Text="Copy cURL Command Collection" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- View 3: Running Servers Manager -->
                        <Grid IsVisible="{Binding IsServersActive}" RowDefinitions="Auto,*">
                            <Border Grid.Row="0" Background="{DynamicResource DsSurfaceHighBrush}" Height="28" Padding="12,0"
                                    BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderBottom">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding RunningServerCount, StringFormat='{}RUNNING SERVERS ({0})'}"
                                               lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis"
                                               Foreground="{DynamicResource DsMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Command="{Binding StopAllRunningServersCommand}"
                                            Classes="cell-tool-btn"
                                            IsVisible="{Binding HasRunningServers}"
                                            Padding="6,2"
                                            ToolTip.Tip="Stop All Running Servers">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <materialIcons:MaterialIcon Kind="StopCircleOutline" Width="12" Height="12" Foreground="{DynamicResource DsRedBrush}" />
                                            <TextBlock Text="Stop All" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsRedBrush}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>

                            <Panel Grid.Row="1">
                                <!-- Empty State -->
                                <StackPanel IsVisible="{Binding !HasRunningServers}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="16">
                                    <Border Width="40" Height="40" lt:Tokens.CornerRadius="DsRadius3XL" Background="{DynamicResource DsSurfaceHighBrush}"
                                            HorizontalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="ServerNetworkOff" Width="22" Height="22" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No Active Servers" lt:Tokens.FontSize="DsFontSize200" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Servers started from this or other files will appear here with live metrics and control actions."
                                               lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Running Servers List -->
                                <ScrollViewer IsVisible="{Binding HasRunningServers}" Padding="10">
                                    <ItemsControl ItemsSource="{Binding RunningServers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="server:FryRunningServerItem">
                                                <Border Background="{DynamicResource DsSurfaceHighBrush}"
                                                        BorderBrush="{DynamicResource DsBorderBrush}"
                                                        lt:Tokens.BorderThickness="DsBorderThin"
                                                        lt:Tokens.CornerRadius="DsRadiusMD"
                                                        Padding="10"
                                                        Margin="0,0,0,8">
                                                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                                        <!-- Row 0: Status Dot + Title + Port Badge -->
                                                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" VerticalAlignment="Center">
                                                            <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DocumentTitle}"
                                                                       lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightStrong"
                                                                       Foreground="{DynamicResource DsTextWhiteBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <Border Grid.Column="2" Background="{DynamicResource DsSurfaceHoverBrush}"
                                                                    BorderBrush="{DynamicResource DsBorderBrush}"
                                                                    lt:Tokens.BorderThickness="DsBorderThin"
                                                                    lt:Tokens.CornerRadius="DsRadiusXS"
                                                                    Padding="4,1">
                                                                <TextBlock Text="{Binding BoundPort, StringFormat=':{0}'}"
                                                                           lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong"
                                                                           Foreground="{DynamicResource DsPrimaryBrush}" />
                                                            </Border>
                                                        </Grid>

                                                        <!-- Row 1: URL and Metrics -->
                                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                            <TextBlock Grid.Column="0" Text="{Binding BaseUrl}"
                                                                       lt:Tokens.FontFamily="DsCodeFontFamily" lt:Tokens.FontSize="DsFontSize100"
                                                                       Foreground="{DynamicResource DsMutedBrush}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{Binding EndpointCount, StringFormat='{}{0} routes'}"
                                                                           lt:Tokens.FontSize="DsFontSize075" Foreground="{DynamicResource DsMutedBrush}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="•" lt:Tokens.FontSize="DsFontSize075" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding TotalRequests, StringFormat='{}{0} reqs'}"
                                                                           lt:Tokens.FontSize="DsFontSize075" Foreground="{DynamicResource DsPrimaryBrush}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Row 2: Actions (Switch / Open in Editor + Stop) -->
                                                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,2,0,0" ColumnSpacing="6">
                                                            <Button Grid.Column="0"
                                                                    Command="{Binding $parent[UserControl;1].((vm:FryServerStudioViewModel)DataContext).SwitchToRunningServerCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Classes="cell-tool-btn"
                                                                    HorizontalAlignment="Stretch"
                                                                    Height="24"
                                                                    Padding="6,0">
                                                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                                                    <materialIcons:MaterialIcon Kind="FileEditOutline" Width="12" Height="12" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                                    <TextBlock Text="Open in Editor" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                                                </StackPanel>
                                                            </Button>

                                                            <Button Grid.Column="1"
                                                                    Command="{Binding $parent[UserControl;1].((vm:FryServerStudioViewModel)DataContext).StopRunningServerCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Classes="cell-tool-btn"
                                                                    Width="24" Height="24"
                                                                    ToolTip.Tip="Stop This Server">
                                                                <materialIcons:MaterialIcon Kind="Stop" Width="14" Height="14" Foreground="{DynamicResource DsRedBrush}" />
                                                            </Button>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Panel>
                        </Grid>
                    </Panel>
                </Grid>
            </Border>

            <!-- Resizable Column Sash Splitter between Sidebar and Editor Canvas -->
            <GridSplitter Grid.Column="2"
                          Classes="studio-sash"
                          Width="4"
                          IsVisible="{Binding IsSideBarVisible}"
                          ResizeDirection="Columns" />

            <!-- ======================================================== -->
            <!-- ZONE 3 & 4: CENTRAL EDITOR CANVAS & BOTTOM TOOL DECK     -->
            <!-- ======================================================== -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="{Binding BottomDeckGridLength, Mode=TwoWay}" MinHeight="0" />
                </Grid.RowDefinitions>

                <!-- ROW 0: VS CODE DOCUMENT TAB BAR (35px) -->
                <Border Grid.Row="0"
                        Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderBottom"
                        Height="35">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Active Server Tab -->
                        <Border Grid.Column="0" Classes="vscode-tab active" Padding="12,0,16,0" Height="35">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="ServerNetwork" Width="14" Height="14" Foreground="{DynamicResource DsPrimaryBrush}" />
                                <TextBlock Classes="tab-title"
                                           Text="{Binding BreadcrumbDocument}"
                                           lt:Tokens.FontSize="DsFontSize300"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ROW 1: DEDICATED BREADCRUMB STRIP (26px) -->
                <Border Grid.Row="1"
                        Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderBottom"
                        Height="26"
                        Padding="16,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" VerticalAlignment="Center">
                        <!-- Segment 1: Folder -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="FolderOutline" Width="13" Height="13" Foreground="{DynamicResource NavHomeFgBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BreadcrumbFolder}" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Chevron 1 -->
                        <materialIcons:MaterialIcon Grid.Column="1" Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.6" VerticalAlignment="Center" Margin="5,0" />

                        <!-- Segment 2: Document -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ServerNetwork" Width="13" Height="13" Foreground="{DynamicResource DsPrimaryBrush}" />
                            <TextBlock Text="{Binding BreadcrumbDocument}" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightLabel" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" MaxWidth="180" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Chevron 2 -->
                        <materialIcons:MaterialIcon Grid.Column="3" Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.6" VerticalAlignment="Center" Margin="5,0" />

                        <!-- Segment 3: Active Cell Badge -->
                        <Border Grid.Column="4"
                                Background="{DynamicResource DsSurfaceHighBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                lt:Tokens.BorderThickness="DsBorderThin"
                                lt:Tokens.CornerRadius="DsRadiusSM"
                                Padding="6,1"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <materialIcons:MaterialIcon Kind="{Binding ActiveCellTypeIcon, Converter={x:Static common:IconKindConverter.Instance}}" Width="11" Height="11" common:ThemeBrush.Foreground="{Binding ActiveCellTypeColorKey}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveCellBadgeText}"
                                           lt:Tokens.FontSize="DsFontSize200"
                                           Foreground="{DynamicResource DsTextWhiteBrush}"
                                           VerticalAlignment="Center"
                                           MaxWidth="180"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ROW 2: MASTER SERVER ACTION TOOLBAR (38px) -->
                <serverControls:FryServerMasterBarControl Grid.Row="2" DataContext="{Binding}" />

                <!-- ROW 3: SCROLLABLE CELLS CANVAS (Notebook Padded Canvas) -->
                <ScrollViewer Grid.Row="3" Padding="24,16,24,32">
                    <StackPanel>
                        <!-- Top Insert Divider (Above first cell) -->
                        <Border Classes="top-insert-divider">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Rectangle Classes="divider-line" Height="1" Fill="{DynamicResource DsBorderBrush}" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                                <StackPanel Classes="insert-pill-group" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Command="{Binding AddEndpointCellCommand}" Classes="insert-cell-pill" ToolTip.Tip="Insert Endpoint Cell at Top">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="11" Height="11" Foreground="{DynamicResource DsPrimaryBrush}" />
                                            <TextBlock Text="Endpoint" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding AddMiddlewareCellCommand}" Classes="insert-cell-pill" ToolTip.Tip="Insert Middleware Cell at Top">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <materialIcons:MaterialIcon Kind="Plus" Width="11" Height="11" Foreground="{DynamicResource NavHomeFgBrush}" />
                                            <TextBlock Text="Middleware" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Cell Cards -->
                        <ItemsControl ItemsSource="{Binding Cells}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:FryServerCellViewModel">
                                    <serverControls:FryServerEndpointCellControl DataContext="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom Canvas Padding -->
                        <Border Height="48" />
                    </StackPanel>
                </ScrollViewer>

                <!-- ROW 4: RESIZABLE SASH SPLITTER FOR BOTTOM TOOL DECK -->
                <GridSplitter Grid.Row="4"
                              Classes="studio-sash"
                              Height="4"
                              IsVisible="{Binding IsBottomPanelVisible}"
                              ResizeDirection="Rows" />

                <!-- ROW 5: BOTTOM PANEL / TOOL DECK (Server Logs & Telemetry, Collapsible) -->
                <Border Grid.Row="5"
                        IsVisible="{Binding IsBottomPanelVisible}"
                        Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderTop">
                    <Grid RowDefinitions="30,*">
                        <!-- Bottom Deck Header Tabs -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource DsSurfaceHoverBrush}"
                                BorderBrush="{DynamicResource DsBorderBrush}"
                                lt:Tokens.BorderThickness="DsBorderBottom"
                                Padding="12,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Tabs -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="ide-tab-btn active">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="SERVER TRAFFIC" lt:Tokens.FontWeight="DsWeightEmphasis" lt:Tokens.FontSize="DsFontSize200" />
                                            <Border Classes="ide-tab-badge" Background="{DynamicResource DsPrimaryBrush}">
                                                <TextBlock Text="{Binding TrafficLog.Count}" Foreground="{DynamicResource DsTextWhiteBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Panel Actions -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Classes="cell-tool-btn"
                                            Command="{Binding ClearTrafficLogCommand}"
                                            ToolTip.Tip="Clear Logs">
                                        <materialIcons:MaterialIcon Kind="Broom" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                    </Button>
                                    <Button Classes="cell-tool-btn"
                                            Command="{Binding ToggleBottomPanelCommand}"
                                            ToolTip.Tip="Close Panel (Ctrl+J)">
                                        <materialIcons:MaterialIcon Kind="Close" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Panel Grid.Row="1">
                            <!-- Empty State -->
                            <StackPanel IsVisible="{Binding !TrafficLog.Count}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6" Margin="16">
                                <materialIcons:MaterialIcon Kind="ServerNetwork" Width="26" Height="26" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.4" HorizontalAlignment="Center" />
                                <TextBlock Text="Server Ready — Waiting for Traffic" lt:Tokens.FontSize="DsFontSize250" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsMutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="Execute loopback test requests or consume endpoints via external HTTP clients to view real-time telemetry." lt:Tokens.FontSize="DsFontSize150" Foreground="{DynamicResource DsMutedBrush}" Opacity="0.7" TextAlignment="Center" />
                            </StackPanel>

                            <!-- Structured Telemetry Table -->
                            <Grid IsVisible="{Binding TrafficLog.Count}" RowDefinitions="24,*">
                                <!-- Column Headers -->
                                <Border Grid.Row="0" Background="{DynamicResource DsSurfaceHighBrush}" BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderBottom" Padding="10,0">
                                    <Grid ColumnDefinitions="75,60,*,70,75,140">
                                        <TextBlock Grid.Column="0" Text="TIME" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="METHOD" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="ROUTE / PATH" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="STATUS" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="LATENCY" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="CLIENT IP" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding TrafficLog}"
                                         Classes="server-traffic-list"
                                         Background="{DynamicResource DsBgBrush}"
                                         BorderThickness="0"
                                         Padding="4,2">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="server1:FryServerTrafficLogItem">
                                            <Grid ColumnDefinitions="75,60,*,70,75,140" Margin="4,2">
                                                <!-- Timestamp -->
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}"
                                                           lt:Tokens.FontSize="DsFontSize150"
                                                           lt:Tokens.FontFamily="DsCodeFontFamily"
                                                           Foreground="{DynamicResource DsMutedBrush}"
                                                           VerticalAlignment="Center" />

                                                <!-- Method Badge -->
                                                <Border Grid.Column="1"
                                                        Background="{DynamicResource DsSurfaceHoverBrush}"
                                                        BorderBrush="{DynamicResource DsBorderBrush}"
                                                        lt:Tokens.BorderThickness="DsBorderThin"
                                                        lt:Tokens.CornerRadius="DsRadiusXS"
                                                        Padding="4,1"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Method}" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsPrimaryBrush}" />
                                                </Border>

                                                <!-- Path -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Path}"
                                                           lt:Tokens.FontFamily="DsCodeFontFamily"
                                                           lt:Tokens.FontSize="DsFontSize200"
                                                           Foreground="{DynamicResource DsTextWhiteBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />

                                                <!-- Status Badge -->
                                                <Border Grid.Column="3"
                                                        Background="{DynamicResource DsSurfaceHighBrush}"
                                                        BorderBrush="{DynamicResource DsBorderBrush}"
                                                        lt:Tokens.BorderThickness="DsBorderThin"
                                                        lt:Tokens.CornerRadius="DsRadiusXS"
                                                        Padding="6,1"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusCode}" lt:Tokens.FontSize="DsFontSize075" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsGreenBrush}" />
                                                </Border>

                                                <!-- Latency -->
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding ElapsedMilliseconds, StringFormat='{}{0:F1}ms'}"
                                                           lt:Tokens.FontFamily="DsCodeFontFamily"
                                                           lt:Tokens.FontSize="DsFontSize150"
                                                           Foreground="{DynamicResource DsMutedBrush}"
                                                           VerticalAlignment="Center" />

                                                <!-- Client IP -->
                                                <TextBlock Grid.Column="5"
                                                           Text="{Binding ClientIp}"
                                                           lt:Tokens.FontFamily="DsCodeFontFamily"
                                                           lt:Tokens.FontSize="DsFontSize100"
                                                           Foreground="{DynamicResource DsMutedBrush}"
                                                           Opacity="0.7"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Panel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================ -->
        <!-- ZONE 5: STATUS BAR (Bottom 22px fixed)                       -->
        <!-- ============================================================ -->
        <Border Grid.Row="1"
                Background="{DynamicResource DsSurfaceBrush}"
                BorderBrush="{DynamicResource DsBorderBrush}"
                lt:Tokens.BorderThickness="DsBorderTop"
                Height="22"
                Padding="10,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" lt:Tokens.Spacing="DsSpace10" VerticalAlignment="Center">
                    <TextBlock Text="&gt;&lt; FryServer" lt:Tokens.FontWeight="DsWeightStrong" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Border Width="6" Height="6" lt:Tokens.CornerRadius="DsRadiusXS"
                                Background="{DynamicResource DsGreenBrush}"
                                IsVisible="{Binding IsServerRunning}"
                                VerticalAlignment="Center" />
                        <Border Width="6" Height="6" lt:Tokens.CornerRadius="DsRadiusXS"
                                Background="{DynamicResource DsMutedBrush}"
                                Opacity="0.5"
                                IsVisible="{Binding !IsServerRunning}"
                                VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ServerStatusText}" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <Button Command="{Binding SelectActivityBarItemCommand}" CommandParameter="3"
                            Classes="cell-tool-btn"
                            IsVisible="{Binding HasRunningServers}"
                            Height="18" Padding="4,0"
                            ToolTip.Tip="View all running servers">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ServerNetwork" Width="11" Height="11" Foreground="{DynamicResource DsGreenBrush}" />
                            <TextBlock Text="{Binding RunningServerCount, StringFormat='{}{0} active'}" lt:Tokens.FontSize="DsFontSize100" Foreground="{DynamicResource DsGreenBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Indicators -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" lt:Tokens.Spacing="DsSpace14" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalRequestsText}" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="UTF-8" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="C# Roslyn" lt:Tokens.FontSize="DsFontSize200" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    <Button Classes="cell-tool-btn"
                            Width="18" Height="18"
                            Command="{Binding ToggleBottomPanelCommand}"
                            ToolTip.Tip="Toggle Server Logs Panel (Ctrl+J)">
                        <materialIcons:MaterialIcon Kind="DockBottom" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
