<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="using:PdfEditorApp.Plugins.CSharpEditor.Controls.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:settings="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Settings"
             xmlns:settings1="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Settings"
             xmlns:studio="using:PdfEditorApp.Plugins.CSharpEditor.Controls.Studio"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpSettingsView"
             x:DataType="settings:CSharpSettingsViewModel"
             Background="{DynamicResource DsBgBrush}">



    <Panel>
        <Grid RowDefinitions="54,*">
        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- 1. TOP HEADER BAR (54px)                                       -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource DsSurfaceBrush}"
                BorderBrush="{DynamicResource DsBorderBrush}"
                lt:Tokens.BorderThickness="DsBorderBottom"
                Padding="16,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <!-- Back Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding BackToPreviousCommand}"
                            Classes="snippet-action-btn"
                            ToolTip.Tip="Return (Esc)">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="15" Height="15" Foreground="{DynamicResource DsMutedBrush}" />
                            <TextBlock Text="Back" lt:Tokens.FontSize="DsFontSize300" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource DsBorderBrush}" Margin="4,0" />
                </StackPanel>

                <!-- Page Title & Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" lt:Tokens.Spacing="DsSpace10" VerticalAlignment="Center" Margin="8,0,16,0">
                    <Border Width="30" Height="30" lt:Tokens.CornerRadius="DsRadiusMD"
                            Background="{DynamicResource DsPrimarySubtleBrush}"
                            BorderBrush="{DynamicResource DsPrimaryBorderSubtleBrush}"
                            lt:Tokens.BorderThickness="DsBorderThin"
                            VerticalAlignment="Center">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="17" Height="17" Foreground="{DynamicResource DsPrimaryBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Settings &amp; Environment Setup" lt:Tokens.FontSize="DsFontSize500" lt:Tokens.FontWeight="DsWeightStrong" Foreground="{DynamicResource DsTextWhiteBrush}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource DsPrimarySubtleBrush}" BorderBrush="{DynamicResource DsPrimaryBorderSubtleBrush}" lt:Tokens.BorderThickness="DsBorderThin"
                            Height="20" MinHeight="20" lt:Tokens.CornerRadius="DsRadiusXL" Padding="8,0" VerticalAlignment="Center">
                        <TextBlock Text="VS Code Ergonomics" lt:Tokens.FontSize="DsFontSize150" lt:Tokens.FontWeight="DsWeightEmphasis" Foreground="{DynamicResource DsPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Status / Notification Pill (when saving or error) -->
                <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource DsSurfaceHighBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}"
                        lt:Tokens.BorderThickness="DsBorderThin" lt:Tokens.CornerRadius="DsRadius2XL" Padding="12,4"
                        IsVisible="{Binding HasStatusMessage}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <materialIcons:MaterialIcon Kind="CheckCircleOutline" Width="15" Height="15" Foreground="{DynamicResource DsGreenBrush}" />
                        <TextBlock Text="{Binding StatusMessage}" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsTextBrush}" VerticalAlignment="Center" />
                        <Button Command="{Binding DismissNotificationCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="4,0,0,0">
                            <materialIcons:MaterialIcon Kind="Close" Width="12" Height="12" Foreground="{DynamicResource DsMutedBrush}" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Saved indicator (every change saves itself) & Reset -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" lt:Tokens.Spacing="DsSpace12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"
                                ToolTip.Tip="Settings save themselves as you change them">
                        <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="13" Height="13" Foreground="{DynamicResource DsMutedBrush}" />
                        <TextBlock Text="{Binding SaveStatusText}" lt:Tokens.FontSize="DsFontSize250" Foreground="{DynamicResource DsMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Command="{Binding ResetDefaultsCommand}"
                            Classes="cs-toolbar-outlined"
                            ToolTip.Tip="Reset all settings to default values">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <materialIcons:MaterialIcon Kind="Restore" Width="14" Height="14" />
                            <TextBlock Text="Reset Defaults" lt:Tokens.FontSize="DsFontSize300" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- 2. MASTER-DETAIL BODY                                          -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="250,1,*">
            <!-- LEFT NAVIGATION RAIL -->
            <Border Grid.Column="0"
                    Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}"
                    lt:Tokens.BorderThickness="DsBorderRight">
                <Grid RowDefinitions="Auto,*">
                    <!-- Search Input Box -->
                    <Border Grid.Row="0" Padding="12,12,12,8">
                        <TextBox Text="{Binding SearchQuery, Mode=TwoWay}"
                                 PlaceholderText="Search settings &amp; runtimes…"
                                 Classes="nexus-search-input"
                                 lt:Tokens.FontSize="DsFontSize300" lt:Tokens.Height="DsControlHeight300">
                            <TextBox.InnerLeftContent>
                                <materialIcons:MaterialIcon Kind="Magnify" Width="16" Height="16" Margin="8,0,0,0" Foreground="{DynamicResource DsMutedBrush}" />
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </Border>

                    <!-- Category Items & Languages Subtree -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="3" Margin="8,4">
                            <!-- Category: Languages & Runtimes -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Languages"
                                    Classes="doc-nav-item"
                                    Classes.active="{Binding IsLanguagesCategoryActive}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="TuneVariant" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Languages &amp; Runtimes" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Sub-items: Each registered language -->
                            <StackPanel Spacing="2" Margin="16,2,0,8" IsVisible="{Binding IsLanguagesCategoryActive}">
                                <ItemsControl ItemsSource="{Binding FilteredLanguages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="settings:LanguageSettingItemViewModel">
                                            <Button Command="{Binding ((settings:CSharpSettingsViewModel)DataContext).SelectLanguageItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue={x:Null}}"
                                                    CommandParameter="{Binding}"
                                                    Classes="doc-nav-item"
                                                    Classes.active="{Binding IsSelected}"
                                                    Margin="0,1">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding IconKind, Converter={x:Static common:IconKindConverter.Instance}}" Width="16" Height="16" Foreground="{Binding AccentHex}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" lt:Tokens.FontSize="DsFontSize300" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    <Ellipse Grid.Column="2" Width="6" Height="6" Fill="{Binding StatusColor}" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- Category: Editor & Formatting -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Editor"
                                    Classes="doc-nav-item"
                                    Classes.active="{Binding IsEditorCategoryActive}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="CodeBraces" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Editor &amp; Formatting" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Category: Theme & Colors -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Themes"
                                    Classes="doc-nav-item"
                                    Classes.active="{Binding IsThemesCategoryActive}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="PaletteOutline" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Theme &amp; Colors" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Category: Layout & Typography -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Layout"
                                    Classes="doc-nav-item"
                                    Classes.active="{Binding IsLayoutCategoryActive}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="FormatSize" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Layout &amp; Typography" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Category: Execution & Terminal -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Execution"
                                    Classes="doc-nav-item"
                                    Classes.active="{Binding IsExecutionCategoryActive}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="Console" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Execution &amp; Terminal" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Category: Keymap Reference -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Keymap"
                                    Classes="doc-nav-item"
                                    Classes.active="{Binding IsKeymapCategoryActive}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="KeyboardOutline" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Keymap &amp; Shortcuts" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Category: Customization & Extensions -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="Customization"
                                    Classes="doc-nav-item"
                                    Classes.active="{Binding IsCustomizationCategoryActive}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="PuzzleOutline" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Customization &amp; Extensions" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <!-- Category: AI Agent & Local LLM -->
                            <Button Command="{Binding SelectCategoryCommand}" CommandParameter="AI"
                                    Classes="doc-nav-item"
                                    Classes.active="{Binding IsAiCategoryActive}">
                                <Grid ColumnDefinitions="Auto,*">
                                    <materialIcons:MaterialIcon Grid.Column="0" Kind="RobotOutline" Width="17" Height="17" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="AI Agent &amp; Local LLM" lt:Tokens.FontSize="DsFontSize350" lt:Tokens.FontWeight="DsWeightEmphasis" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- SPLITTER BORDER -->
            <Rectangle Grid.Column="1" Fill="{DynamicResource DsBorderBrush}" Width="1" />

            <!-- RIGHT DETAIL CANVAS -->
            <Border Grid.Column="2" Background="{DynamicResource DsBgBrush}">
                <Panel>
                    <!-- Detail for Languages & Runtimes -->
                    <Panel IsVisible="{Binding IsLanguagesCategoryActive}">
                        <settings1:LanguageEnvironmentSettingControl
                            DataContext="{Binding SelectedLanguage}" />
                    </Panel>

                    <!-- Detail for Editor & Formatting -->
                    <settings1:EditorSettingsSectionControl
                        IsVisible="{Binding IsEditorCategoryActive}" />

                    <!-- Detail for Theme & Colors -->
                    <settings1:ThemeSettingsSectionControl
                        IsVisible="{Binding IsThemesCategoryActive}" />

                    <!-- Detail for Layout & Typography -->
                    <settings1:LayoutSettingsSectionControl
                        IsVisible="{Binding IsLayoutCategoryActive}" />

                    <!-- Detail for Execution & Terminal -->
                    <settings1:ExecutionSettingsSectionControl
                        IsVisible="{Binding IsExecutionCategoryActive}" />

                    <!-- Detail for Keymap Reference -->
                    <settings1:KeymapSettingsSectionControl
                        IsVisible="{Binding IsKeymapCategoryActive}" />

                    <!-- Detail for Customization & Extensions -->
                    <settings1:CustomizationSettingsSectionControl
                        IsVisible="{Binding IsCustomizationCategoryActive}" />

                    <!-- Detail for AI Agent & Local LLM -->
                    <settings1:AiSettingsSectionControl
                        IsVisible="{Binding IsAiCategoryActive}" />
                </Panel>
            </Border>
        </Grid>
    </Grid>

</Panel>
</UserControl>
