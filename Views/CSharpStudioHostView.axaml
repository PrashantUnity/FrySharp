<UserControl xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PdfEditorApp.Plugins.CSharpEditor.ViewModels"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:common="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.ViewModels.Common"
             xmlns:common1="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Common"
             xmlns:studio="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Studio"
             xmlns:ai="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.AI"
             xmlns:activities="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Activities"
             xmlns:overlays="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Overlays"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="800"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Views.CSharpStudioHostView"
             x:DataType="common:CSharpStudioHostViewModel"
             activities:ActivityScope.Presenter="{Binding Activity}"
             lt:Tokens.FontFamily="DsUiFontFamily"
             lt:Tokens.FontWeight="DsWeightBody"
             Background="{DynamicResource M3SurfaceBrush}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CSharpEditorPlugin/Styles/Tokens/StudioPaletteTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <CornerRadius x:Key="M3ShapeCornerFull">9999</CornerRadius>
            <CornerRadius x:Key="M3ShapeCornerMedium">12</CornerRadius>
            <CornerRadius x:Key="M3ShapeCornerSmall">8</CornerRadius>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The studio's styles: included from code (StudioStyleSheet), here only when the application doesn't apply them
         already, as the Runner does. A second copy doubled what every control of the studio cost. -->

    <Panel>
        <!-- Main Studio Workspace with dynamic Right Panel and Bottom Deck docking slots for AI Assistant -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="{Binding AiComposer.BottomDockGridLength, Mode=TwoWay}" MinHeight="0" />
            </Grid.RowDefinitions>

            <!-- Row 0: Center PageHost + Right Docked AI SideBar -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="{Binding AiComposer.SideBarDockGridLength, Mode=TwoWay}" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <!-- Main Studio Pages (Home, Studio, Notebooks, Settings, Docs, etc.) -->
                <common1:KeepAlivePageHost x:Name="PageHost" Grid.Column="0" Page="{Binding CurrentPage}" />

                <!-- GridSplitter between PageHost and Right Docked AI SideBar -->
                <GridSplitter Grid.Column="1" Width="4"
                              Background="{DynamicResource DsBorderBrush}"
                              Classes="studio-sash"
                              ResizeDirection="Columns"
                              Cursor="SizeWestEast"
                              IsVisible="{Binding AiComposer.IsSideBarDocked}" />

                <!-- Right Docked AI Assistant Panel (Dedicated Secondary Side Bar) -->
                <Border Grid.Column="2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="{DynamicResource DsSurfaceBrush}"
                        BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderLeft"
                        IsVisible="{Binding AiComposer.IsSideBarDocked}">
                    <ai:StudioFloatingComposerControl DataContext="{Binding AiComposer}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch" />
                </Border>
            </Grid>

            <!-- Row 1: GridSplitter between Workspace and Bottom Docked AI Deck -->
            <GridSplitter Grid.Row="1" Height="4"
                          Background="{DynamicResource DsBorderBrush}"
                          Classes="studio-sash"
                          ResizeDirection="Rows"
                          Cursor="SizeNorthSouth"
                          IsVisible="{Binding AiComposer.IsBottomDocked}" />

            <!-- Row 2: Bottom Docked AI Assistant Deck -->
            <Border Grid.Row="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource DsSurfaceBrush}"
                    BorderBrush="{DynamicResource DsBorderBrush}" lt:Tokens.BorderThickness="DsBorderTop"
                    IsVisible="{Binding AiComposer.IsBottomDocked}">
                <ai:StudioFloatingComposerControl DataContext="{Binding AiComposer}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
            </Border>
        </Grid>

        <!-- App-Wide Floating AI Agent & Composer Overlay (Used when DockMode == FloatingOverlay) -->
        <Border IsVisible="{Binding AiComposer.IsOverlayVisible}" ZIndex="998">
            <ai:StudioFloatingComposerControl DataContext="{Binding AiComposer}" />
        </Border>

        <!-- Work for the whole studio (opening a document from another page, reloading scripts): a line across the top -->
        <activities:ActivityProgressLine Location="Window" ZIndex="997" />

        <!-- Long work that can be cancelled, and failures: toasts in the corner, never in the way -->
        <activities:ActivityToastHost DataContext="{Binding Activity}" ZIndex="999" />

        <!-- Only blocking work (cold start, switching workspace) covers the studio, and only once it has run a while -->
        <studio:StudioLoadingOverlayControl IsLoading="{Binding Activity.HasCard}"
                                              LoadingTitle="{Binding Activity.Card.Title, FallbackValue=''}"
                                              LoadingSubtitle="{Binding Activity.Card.Detail, FallbackValue=''}"
                                              ShowCancel="{Binding Activity.Card.Cancellable, FallbackValue=False}"
                                              CancelCommand="{Binding Activity.CancelCardCommand}"
                                              ZIndex="1000"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />

        <!-- The studio's one modal question (unsaved changes, deletes, discards): above everything, including the loading card -->
        <overlays:StudioDialogOverlayControl x:Name="DialogOverlay" DataContext="{Binding Dialogs}" ZIndex="1001" />
    </Panel>
</UserControl>
