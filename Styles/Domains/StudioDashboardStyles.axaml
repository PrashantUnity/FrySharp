<Styles xmlns:lt="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Services.Extensibility.Theming.Layout;assembly=CSharpEditorPlugin" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia">


    <!-- ===================================================================== -->
    <!-- Nexus Dashboard Styles — consumed by CSharpManagerView (the Hub).      -->
    <!-- Colors come from StudioPaletteTokens.axaml's Ds*Brush tokens,   -->
    <!-- which are theme-variant aware (Light/Dark).                           -->
    <!-- ===================================================================== -->

    <!-- Card Button Reset -->
    <Style Selector="Button.nexus-card-btn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  HorizontalContentAlignment="Stretch"
                                  VerticalContentAlignment="Stretch"
                                  ClipToBounds="False" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.nexus-card-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Glass Card Base -->
    <Style Selector="Border.nexus-glass-card">
        <Setter Property="Background" Value="{DynamicResource DsGlassBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadius2XL" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                <BrushTransition Property="Background" Duration="0:0:0.18" />
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18" />
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nexus-card-btn:pointerover Border.nexus-glass-card, Border.nexus-glass-card.interactive:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="RenderTransform" Value="translateY(-2px)" />
        <Setter Property="lt:Tokens.BoxShadow" Value="DsFloatingShadow" />
    </Style>

    <!-- Placeholder Icon Circle Highlight on Card Hover -->
    <Style Selector="Border.nexus-placeholder-icon-badge">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.nexus-placeholder-icon-badge materialIcons|MaterialIcon">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nexus-card-btn:pointerover Border.nexus-placeholder-icon-badge">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBorderSubtleBrush}" />
    </Style>
    <Style Selector="Button.nexus-card-btn:pointerover Border.nexus-placeholder-icon-badge materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
    </Style>

    <!-- Selected Glass Card State -->
    <Style Selector="Border.nexus-glass-card.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="lt:Tokens.BoxShadow" Value="=0 4 20 0 #442F81F7" />
    </Style>
    <Style Selector="Button.nexus-card-btn:pointerover Border.nexus-glass-card.selected, Border.nexus-glass-card.selected.interactive:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryHoverBrush}" />
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="RenderTransform" Value="translateY(-2px)" />
    </Style>

    <!-- Direct Use Button on Template Card -->
    <Style Selector="Button.nexus-card-use-btn">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusMD" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize200" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightEmphasis" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nexus-card-use-btn:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryHoverBrush}" />
    </Style>
    <Style Selector="Border.nexus-glass-card.selected Button.nexus-card-use-btn">
        <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryHoverBrush}" />
    </Style>

    <!-- Sidebar Nav Button -->
    <Style Selector="Button.nexus-nav-item">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusLG" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextBrush}" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize400" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightLabel" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nexus-nav-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsHoverOverlayBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>
    <Style Selector="Button.nexus-nav-item.active">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBorderSubtleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightEmphasis" />
    </Style>

    <!-- Sidebar Icon Container with Micro-interaction -->
    <Style Selector="Border.nav-icon-box">
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nexus-nav-item:pointerover Border.nav-icon-box">
        <Setter Property="RenderTransform" Value="scale(1.06)" />
    </Style>

    <!-- Centered Badge Pill / Circle -->
    <Style Selector="Border.nexus-badge-pill">
        <Setter Property="Height" Value="18" />
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="MinWidth" Value="18" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusLG" />
        <Setter Property="Padding" Value="5.5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.nexus-badge-pill > TextBlock">
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize075" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightStrong" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1.5,0,0" />
    </Style>

    <!-- Primary Action Button (New Notebook) -->
    <Style Selector="Button.nexus-btn-primary">
        <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryHoverBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusLG" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize400" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightEmphasis" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nexus-btn-primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsPrimaryHoverBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.nexus-btn-primary:pressed">
        <Setter Property="Background" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.nexus-btn-primary materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.nexus-btn-primary TextBlock">
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Surface Action Button (New Script) -->
    <Style Selector="Button.nexus-btn-surface">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusLG" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize400" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightEmphasis" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nexus-btn-surface:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsMutedBrush}" />
    </Style>

    <!-- Ghost Icon Button & ToggleButton -->
    <Style Selector="Button.nexus-btn-ghost, ToggleButton.nexus-btn-ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusLG" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nexus-btn-ghost:pointerover, ToggleButton.nexus-btn-ghost:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
    </Style>
    <Style Selector="Button.nexus-btn-ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.nexus-btn-ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
    </Style>
    <Style Selector="ToggleButton.nexus-btn-ghost:checked">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBorderSubtleBrush}" />
    </Style>
    <Style Selector="ToggleButton.nexus-btn-ghost:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBorderSubtleBrush}" />
    </Style>
    <Style Selector="ToggleButton.nexus-btn-ghost:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.nexus-btn-ghost:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.nexus-btn-ghost:not(:checked) materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
    </Style>
    <Style Selector="ToggleButton.nexus-btn-ghost:checked materialIcons|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
    </Style>

    <!-- Nexus Input TextBox -->
    <Style Selector="TextBox.nexus-input">
        <Setter Property="Background" Value="{DynamicResource DsBgBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusLG" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize400" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource DsSelectionBrush}" />
    </Style>
    <Style Selector="TextBox.nexus-input:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource DsFocusBorderBrush}" />
        <Setter Property="Background" Value="{DynamicResource DsBgBrush}" />
    </Style>
    <Style Selector="TextBox.nexus-input:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource DsMutedBrush}" />
    </Style>

    <!-- Flyout & ContextMenu Styles for GitHub Dark/Light Nexus Theme -->
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusXL" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusLG" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusLG" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusSM" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize350" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextBrush}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>

    <!-- Tag Pill -->
    <Style Selector="Border.nexus-tag-pill">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="Height" Value="18" />
        <Setter Property="MinHeight" Value="18" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusSM" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.nexus-tag-pill TextBlock">
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize100" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightLabel" />
        <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.nexus-tag-pill.overflow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=0" />
    </Style>

    <!-- Table Row Button -->
    <Style Selector="Border.nexus-table-row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderSubtleBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderBottom" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nexus-card-btn:pointerover Border.nexus-table-row">
        <Setter Property="Background" Value="{DynamicResource DsHoverOverlayBrush}" />
    </Style>

    <!-- Segmented Tab Pill (Dashboard View Switcher) -->
    <Style Selector="Button.nexus-tab-pill">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="lt:Tokens.BorderThickness" Value="=0" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusFull" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize350" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightLabel" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nexus-tab-pill:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsHoverOverlayBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>
    <Style Selector="Button.nexus-tab-pill.active">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightEmphasis" />
    </Style>

    <!-- Category Filter Chip -->
    <Style Selector="Button.nexus-filter-chip">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadiusFull" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Foreground" Value="{DynamicResource DsMutedBrush}" />
        <Setter Property="lt:Tokens.FontSize" Value="DsFontSize250" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightLabel" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <BrushTransition Property="Foreground" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.nexus-filter-chip:pointerover">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsTextWhiteBrush}" />
    </Style>
    <Style Selector="Button.nexus-filter-chip.active">
        <Setter Property="Background" Value="{DynamicResource DsPrimarySubtleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DsPrimaryBrush}" />
        <Setter Property="lt:Tokens.FontWeight" Value="DsWeightEmphasis" />
    </Style>

    <!-- Status dots (Border.status-pulse-dot) stay still on purpose. They used to pulse forever, and an endless animation
         redraws the page on every frame for as long as it is shown: the idle Hub cost about 60 ms of drawing per frame
         instead of nothing. See the performance mandate on animations. -->


    <!-- Hub Welcome & Workspaces Responsive Styles -->
    <Style Selector="StackPanel.hub-welcome-actions">
        <Setter Property="Grid.Column" Value="2" />
    </Style>
    <Style Selector="Border.compact StackPanel.hub-welcome-actions">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,16,0,0" />
    </Style>

    <Style Selector="StackPanel.hub-filter-chips">
        <Setter Property="Grid.Column" Value="2" />
    </Style>
    <Style Selector="Border.compact StackPanel.hub-filter-chips">
        <Setter Property="Grid.Row" Value="1" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>

    <!-- Studio Loading Overlay Card -->
    <Style Selector="Border.studio-loading-card">
        <Setter Property="Background" Value="{DynamicResource DsSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DsBorderBrush}" />
        <Setter Property="lt:Tokens.BorderThickness" Value="DsBorderThin" />
        <Setter Property="lt:Tokens.CornerRadius" Value="DsRadius3XL" />
        <Setter Property="lt:Tokens.BoxShadow" Value="=0 24 64 0 #B0000000" />
    </Style>

</Styles>
