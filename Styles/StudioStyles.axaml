<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ -->
    <!-- MASTER C# CODE STUDIO STYLE BUNDLE                           -->
    <!-- Unified canonical entry point for all studio styles & tokens -->
    <!-- ============================================================ -->
    <!-- Include this bundle once on any branch of the tree, through StudioStyleSheet (Controls/Common): Avalonia gives
         every control an instance of each style of its type in each copy, matched or not, so a second copy doubled what
         every control cost to build. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CSharpEditorPlugin/Styles/Tokens/StudioPaletteTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- How a tree tells it already has this bundle (StudioStyleSheet.MarkerKey). -->
            <x:Boolean x:Key="StudioStylesIncluded">True</x:Boolean>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- The editor's own theme comes with the bundle, ahead of the studio's editor styles that adjust it. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <!-- Core IDE Zones (Zones 1 - 5) -->
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Core/StudioActivityBarStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Core/StudioSideBarStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Core/StudioEditorStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Core/StudioBottomDeckStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Core/StudioStatusBarStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Core/StudioToolTipStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Core/StudioSliderStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Core/StudioComboBoxStyles.axaml" />

    <!-- Feature & Domain Surfaces -->
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Domains/StudioDashboardStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Domains/StudioNotebookStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Domains/StudioServerStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Domains/StudioAiComposerStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Domains/StudioVisualizerStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Domains/StudioBlindProblemsStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Domains/StudioSettingsStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Domains/StudioDocsStyles.axaml" />
    <StyleInclude Source="avares://CSharpEditorPlugin/Styles/Domains/StudioAboutDialogStyles.axaml" />

</Styles>
