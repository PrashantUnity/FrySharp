<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the studio's real views off-screen and saves them as PNG files. See docs/headless-ui-snapshots.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <RootNamespace>PdfEditorApp.Plugins.CSharpEditor.Tools.UiSnapshots</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="PdfEditorApp.Plugins.CSharpEditor.Visuals.Spec" />
  </ItemGroup>

  <ItemGroup>
    <!-- The views and view models to render, and the Runner for the app's Material 3 theme (avares://FrySharp/...). -->
    <ProjectReference Include="../../CSharpEditorPlugin.csproj" />
    <ProjectReference Include="../../Runner/CSharpEditorPlugin.Runner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FryWorld.Sdk" Version="0.5.0" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
  </ItemGroup>
</Project>
