<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:visControls="using:PdfEditorApp.Plugins.CSharpEditor.Visualizers.Controls"
             xmlns:controls="using:PdfEditorApp.Plugins.CSharpEditor.Controls"
             xmlns:visuals="clr-namespace:PdfEditorApp.Plugins.CSharpEditor.Controls.Visuals"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="380"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Visualizers.Controls.InteractiveVisualizerControl">

    <Grid>
        <visuals:VisualChromeControl x:Name="Chrome" />

        <StackPanel x:Name="KindToolsPanel" Orientation="Horizontal" Spacing="4" IsVisible="False">
            <Button Name="ZoomOutBtn" Classes="chrome-tool-btn" Width="24" Height="22" ToolTip.Tip="Zoom Out (−)">
                <materialIcons:MaterialIcon Kind="MagnifyMinusOutline" Width="13" Height="13" />
            </Button>
            <Button Name="ResetViewBtn" Classes="chrome-tool-btn" MinWidth="40" Height="22" Padding="4,0" ToolTip.Tip="Actual Size: back to 100% (0)">
                <TextBlock Name="ZoomLevelText" Text="100%" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Button>
            <Button Name="ZoomInBtn" Classes="chrome-tool-btn" Width="24" Height="22" ToolTip.Tip="Zoom In (+)">
                <materialIcons:MaterialIcon Kind="MagnifyPlusOutline" Width="13" Height="13" />
            </Button>

            <StackPanel Name="MatrixToolsPanel" Orientation="Horizontal" Spacing="4" Margin="2,0,0,0">
                <Button Name="ToggleValuesBtn" Classes="chrome-tool-btn" Width="22" Height="22" ToolTip.Tip="Toggle Cell Values">
                    <materialIcons:MaterialIcon Kind="EyeOutline" Width="13" Height="13" />
                </Button>
                <Button Name="ToggleCoordsBtn" Classes="chrome-tool-btn" Width="22" Height="22" ToolTip.Tip="Toggle Coordinates">
                    <materialIcons:MaterialIcon Kind="Numeric" Width="13" Height="13" />
                </Button>
            </StackPanel>
        </StackPanel>

        <Border x:Name="CanvasHost"
                Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="1"
                CornerRadius="4"
                MinHeight="80"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ClipToBounds="True"
                IsVisible="False">
            <visControls:VisualizerCanvasControl Name="CanvasControl" />
        </Border>

        <visControls:VisualizerPlaybackControl x:Name="PlaybackControl" IsVisible="False" Margin="0,6,0,0" />
    </Grid>
</UserControl>
