<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:visControls="using:PdfEditorApp.Plugins.CSharpEditor.Visualizers.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="75"
             x:Class="PdfEditorApp.Plugins.CSharpEditor.Visualizers.Controls.VisualizerPlaybackControl">

    <Grid RowDefinitions="Auto,Auto,Auto" Margin="0,4,0,0">
        <!-- 0. Watched collections (queue, stack, visited set...) as they were at this step -->
        <ItemsControl Grid.Row="0" Name="WatchList" IsVisible="False" Margin="0,0,0,6">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="visControls:WatchStripRow">
                    <Grid ColumnDefinitions="80,*" Margin="0,1">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Name}"
                                   ToolTip.Tip="{Binding Summary}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource M3OnSurfaceVariantBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="visControls:WatchStripCell">
                                    <Border Classes="watch-cell" Classes.added="{Binding IsAdded}" Classes.marker="{Binding IsMarker}">
                                        <TextBlock Text="{Binding Text}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 1. Step Explanation Banner -->
        <Border Grid.Row="1"
                Name="StepBannerBorder"
                Background="{DynamicResource M3SurfaceContainerHighBrush}"
                BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,5"
                Margin="0,0,0,6">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="CompassOutline" Width="14" Height="14" Foreground="{DynamicResource DsWarningBrush}" VerticalAlignment="Center" />
                    <TextBlock Name="StepDescriptionText"
                               Text="Step 0: Initial State"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource M3OnSurfaceBrush}"
                               VerticalAlignment="Center" />

                    <!-- Source line that recorded this step; click to jump the editor there -->
                    <Button Name="StepLineBtn"
                            Classes="cell-tool-btn"
                            Width="NaN"
                            Height="18"
                            Padding="5,0"
                            IsVisible="False"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Show the code line that recorded this step">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <materialIcons:MaterialIcon Kind="CodeBraces" Width="10" Height="10" Foreground="{DynamicResource DsInfoBrush}" VerticalAlignment="Center" />
                            <TextBlock Name="StepLineText" Text="Ln 1" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource DsInfoBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Auxiliary Information Badges -->
                <StackPanel Grid.Column="2" Name="AuxInfoPanel" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 2. Playback Controls & Scrubber Slider -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <!-- Navigation Buttons -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button Name="FirstBtn" Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="First Step (Home)">
                    <materialIcons:MaterialIcon Kind="PageFirst" Width="14" Height="14" />
                </Button>
                <Button Name="PrevBtn" Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="Previous Step (Left Arrow)">
                    <materialIcons:MaterialIcon Kind="ChevronLeft" Width="15" Height="15" />
                </Button>
                <Button Name="PlayPauseBtn" Classes="cell-tool-btn" Width="26" Height="24" ToolTip.Tip="Play / Pause (Space)">
                    <materialIcons:MaterialIcon Name="PlayPauseIcon" Kind="Play" Width="14" Height="14" Foreground="{DynamicResource M3PrimaryBrush}" />
                </Button>
                <Button Name="NextBtn" Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="Next Step (Right Arrow)">
                    <materialIcons:MaterialIcon Kind="ChevronRight" Width="15" Height="15" />
                </Button>
                <Button Name="LastBtn" Classes="cell-tool-btn" Width="24" Height="24" ToolTip.Tip="Last Step (End)">
                    <materialIcons:MaterialIcon Kind="PageLast" Width="14" Height="14" />
                </Button>
            </StackPanel>

            <!-- Scrubber Slider -->
            <Grid Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                <Slider Name="StepSlider"
                        Classes="scrubber-slider"
                        Minimum="0"
                        Maximum="10"
                        Value="0"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Height="22"
                        VerticalAlignment="Center" />
            </Grid>

            <!-- Counter & Speed -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- Step Counter Pill -->
                <Border Background="{DynamicResource M3SurfaceContainerLowestBrush}"
                        BorderBrush="{DynamicResource M3OutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="6,2"
                        VerticalAlignment="Center">
                    <TextBlock Name="StepCounterText" Text="0 / 0" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource M3PrimaryBrush}" />
                </Border>

                <!-- Speed Toggle -->
                <Button Name="SpeedBtn" Classes="cell-tool-btn" Padding="4,2" Height="22" ToolTip.Tip="Playback Speed">
                    <TextBlock Name="SpeedText" Text="1.0x" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource M3OnSurfaceVariantBrush}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
